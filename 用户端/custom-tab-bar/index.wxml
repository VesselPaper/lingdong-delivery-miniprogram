<view class="tabbar">
  <view
    class="tab-item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    bindtap="switchTab"
    data-index="{{index}}"
  >
    <view class="tab-icon">
      <t-icon name="{{item.icon}}" size="22" color="{{selected === index ? '#3078C0' : '#999999'}}" />
    </view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
