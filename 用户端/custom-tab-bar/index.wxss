/* 底部导航栏 · 风格统一：12rpx 圆角 + 1rpx 描边（对齐商家端卡片范式） */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(17, 17, 17, 0.08);
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  z-index: 99;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.tab-icon {
  width: 76rpx;
  height: 44rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.tab-item.on .tab-icon {
  background: #DCE9F8;
}

.tab-text {
  font-size: 20rpx;
  color: #999999;
}

.tab-item.on .tab-text {
  color: #3078C0;
  font-weight: 600;
}
