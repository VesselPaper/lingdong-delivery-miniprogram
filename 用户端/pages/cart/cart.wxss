/* 购物车页 · 风格统一为商家端历史订单页：卡片 12rpx 圆角 + 1rpx 描边、蓝主色、矩形按钮 */
.cart-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding-bottom: 180rpx;
}

.cart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}

.cart-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

/* 卡片：12rpx 圆角 + 描边（对齐商家端历史订单） */
.card {
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  padding: 24rpx;
}

.shop-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.cart-list {
  margin-top: 8rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D8D8D8;
  box-sizing: border-box;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-on {
  background: var(--brand);
  border-color: var(--brand);
}

.item-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 8rpx;
  background: #F5F5F5;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.item-info {
  flex: 1;
  margin: 0 20rpx;
  overflow: hidden;
}

.item-name {
  font-size: 28rpx;
  color: #111111;
}

.item-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.item-name-row .item-name {
  flex: 1;
  min-width: 0;
}

.item-soldout {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #ffffff;
  background: #E64340;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

/* 售罄置灰加号 */
.stepper-btn.plus.disabled {
  background: #E3E7EE;
  border-color: #E3E7EE;
  color: #999999;
}

.item-price {
  color: var(--brand);
  font-weight: 600;
  font-size: 30rpx;
  margin-top: 8rpx;
}

.item-price .price-now {
  color: #E64340;
  font-weight: 700;
}

.item-price .price-orig {
  color: #AAAAAA;
  font-size: 24rpx;
  font-weight: 400;
  text-decoration: line-through;
  margin-left: 10rpx;
}

/* 底部结算栏：描边顶线 + 矩形「去结算」（对齐商家端按钮风格） */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #EBEBEB;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  z-index: 10;
}

.all-check {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.all-check .check {
  margin-right: 0;
}

.total {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price {
  color: var(--brand);
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
}

.go-btn {
  height: 72rpx;
  padding: 0 44rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
