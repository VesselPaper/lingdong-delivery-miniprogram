.order-list-page {
  min-height: 100vh;
  background: #F6F8FB;
  padding-bottom: 220rpx;
}

.tabs-area {
  position: sticky;
  top: 0;
  z-index: 5;
  background: #ffffff;
  padding: 8rpx 32rpx 0;
}

/* 6 个固定分类 tab：均分整行，避免总宽超出屏幕把「已完成」截字 */
.tabs-area .nav-item {
  flex: 1;
  margin-right: 0;
  padding: 20rpx 0;
  text-align: center;
  white-space: nowrap;
}

.list {
  padding: 20rpx 24rpx 48rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 63, 122, 0.05);
}

.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.o-store {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.o-store-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #EAF3FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.o-store-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.o-status {
  font-size: 26rpx;
  color: #666666;
}

.o-main {
  display: flex;
  align-items: center;
  padding: 8rpx 0 20rpx;
}

.o-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #F5F7FA;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.o-name {
  flex: 1;
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.o-qty {
  font-size: 26rpx;
  color: #99A3B0;
}

.o-foot {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2F4F8;
}

.o-actual {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.o-actual-price {
  color: #FA4A2D;
  font-size: 32rpx;
  font-weight: 700;
}

.o-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}
