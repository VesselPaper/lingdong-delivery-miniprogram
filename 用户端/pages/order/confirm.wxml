<view class="confirm-page">
  <!-- 上部分：信息显示 -->
  <view class="card info-card">
    <!-- 第一行：送达楼栋 + 详细地址（加大显示，点击弹出楼栋选择） -->
    <view class="addr-main" bindtap="showPointPicker">
      <block wx:if="{{selectedPoint}}">
        <view class="addr-line">
          <t-icon name="location" size="18" color="#3078C0" />
          <text class="addr-main-text">{{selectedPoint.name}}</text>
          <t-icon name="chevron-right" size="14" color="#C0C0C0" />
        </view>
      </block>
      <view wx:else class="addr-line">
        <t-icon name="location" size="18" color="#3078C0" />
        <text class="addr-main-text addr-placeholder">请选择送达楼栋</text>
        <t-icon name="chevron-right" size="14" color="#C0C0C0" />
      </view>
    </view>
    <!-- 第二行：收货人（可编辑） -->
    <view class="info-row">
      <text class="info-label">收货人：</text>
      <input class="info-input" placeholder="请输入收餐人姓名" placeholder-class="field-placeholder" value="{{contactName}}" bind:input="onName" />
    </view>
    <!-- 第三行：联系电话（可编辑） -->
    <view class="info-row">
      <text class="info-label">联系电话：</text>
      <input class="info-input" type="number" placeholder="请输入联系电话" placeholder-class="field-placeholder" value="{{contactPhone}}" bind:input="onPhone" />
    </view>
    <!-- 第四行：预计送达时间（左右两部分） -->
    <view class="time-row" bindtap="openTimeSheet">
      <view class="time-mode">{{deliveryMode === 'asap' ? '立即送出' : '指定时间'}}</view>
      <view class="time-val blue">{{deliveryMode === 'asap' ? '预计 ' + asapEta + ' 送达' : scheduledTime}}</view>
      <t-icon name="edit" size="14" color="#3078C0" />
    </view>
  </view>

  <!-- 下部分：优惠 + 商品信息 -->
  <view class="card goods-card">
    <view class="cell" bindtap="showPromos">
      <view class="cell-label">优惠</view>
      <view class="cell-value {{promoCandidates.length ? 'cell-link' : ''}}">
        {{promoCandidates.length ? (promoBanner ? promoBanner.title : '选择优惠') : '暂无可用'}}
      </view>
      <view class="cell-reduce" wx:if="{{promoReduce && promoReduce !== '0.00'}}">- ¥{{promoReduce}}</view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
    <!-- 优惠券（与活动优惠可叠加：活动先打折/满减，券再抵扣活动后金额） -->
    <view class="cell" bindtap="showCouponSheet">
      <view class="cell-label">优惠券</view>
      <view class="cell-value {{couponUsable.length ? 'cell-link' : ''}}">
        {{selectedCoupon ? selectedCoupon.desc : (couponUsable.length ? couponUsable.length + ' 张可用' : '暂无可用')}}
      </view>
      <view class="cell-reduce" wx:if="{{couponReduce && couponReduce !== '0.00'}}">- ¥{{couponReduce}}</view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
    <view class="shop-row">
      <view class="shop-badge"><t-icon name="shop" size="14" color="#3078C0" /></view>
      <text class="shop-name">零栋铺子</text>
      <view class="tag tag-orange" wx:if="{{shopClosed}}">歇业</view>
    </view>
    <view wx:if="{{promoBanner}}" class="promo-banner" bindtap="showPromos">
      <t-icon name="{{promoBanner.icon || 'discount'}}" size="16" color="#E64340" />
      <view class="promo-info">
        <view class="promo-title">{{promoBanner.title}}</view>
        <view class="promo-sub text-weak text-sm">已优惠 ¥{{promoBanner.reduce}}{{promoCandidates.length > 1 ? '，点按可切换' : ''}}</view>
      </view>
      <view class="promo-switch" wx:if="{{promoCandidates.length > 1}}">切换›</view>
    </view>
    <view class="o-item" wx:for="{{items}}" wx:key="goods_id">
      <view class="o-img">
        <image wx:if="{{item.image}}" class="fill-img" src="{{item.image}}" mode="aspectFill" />
        <t-icon wx:else name="app" size="18" color="#BFBFBF" />
      </view>
      <view class="o-info">
        <view class="o-name ellipsis">{{item.name}}</view>
        <view class="o-qty text-weak text-sm">x{{item.quantity}}</view>
      </view>
      <view class="o-price">
        <view class="o-price-now">实付 ¥{{item.total}}</view>
        <view class="o-price-old" wx:if="{{item.price_now < item.price}}">¥{{item.orig}}</view>
      </view>
    </view>
    <!-- 费用明细：商品金额 / 活动优惠 / 打包费 / 配送费 逐项列出，再给合计 -->
    <view class="fee-row">
      <text class="fee-label">商品金额</text>
      <text class="fee-val">¥{{subtotal}}</text>
    </view>
    <view class="fee-row" wx:if="{{promoBanner}}">
      <text class="fee-label">活动优惠</text>
      <text class="fee-val fee-cut">- ¥{{promoBanner.reduce}}</text>
    </view>
    <view class="fee-row" wx:if="{{selectedCoupon}}">
      <text class="fee-label">优惠券</text>
      <text class="fee-val fee-cut">- ¥{{couponReduce}}</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">打包费</text>
      <t-icon name="info-circle" size="12" color="#C0C0C0" />
      <text class="fee-val">¥0</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">配送费</text>
      <t-icon name="info-circle" size="12" color="#C0C0C0" />
      <text class="fee-val">¥{{deliveryFee}}</text>
    </view>
    <view class="discount-row total-row">
      <text class="discount-label">合计：</text>
      <view class="total-right">
        <text class="orig-total" wx:if="{{promoBanner}}">¥{{origTotal}}</text>
        <text class="discount-total">¥{{payableTotal}}</text>
      </view>
    </view>
    <view class="remark-row">
      <text class="remark-label">备注信息</text>
      <input class="remark-input" placeholder="选填" placeholder-class="field-placeholder" value="{{remark}}" bind:input="onRemark" />
    </view>
  </view>

  <view class="disclaimer-link">
    免责说明
    <t-icon name="info-circle" size="12" color="#999999" />
  </view>

  <!-- 底部支付 -->
  <view class="bottom-bar safe-bottom">
    <view class="pay-icon">
      <t-icon name="robot-1" size="22" color="#3078C0" />
    </view>
    <view class="pay-total">
      <text class="text-sub">共计</text>
      <text class="pay-price">¥{{payableTotal}}</text>
    </view>
    <view class="btn {{submitting || shopClosed ? 'btn-disabled' : ''}}" bindtap="submit" style="flex-shrink:0; margin-left:24rpx; padding:0 64rpx;">
      {{shopClosed ? '店铺歇业' : (submitting ? '提交中...' : (payMock ? '模拟支付' : '支付'))}}
    </view>
  </view>

  <!-- 选择送达楼栋 -->
  <view wx:if="{{showPicker}}" class="popup-mask" bindtap="closePicker">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closePicker">
        <t-icon name="close" size="20" color="#C0C0C0" />
      </view>
      <view class="picker">
        <view class="picker-title">选择送达楼栋</view>
        <view class="picker-list">
          <view
            class="picker-item {{selectedPoint && selectedPoint.id === item.id ? 'active' : ''}}"
            wx:for="{{points}}" wx:key="id"
            bindtap="choosePoint" data-item="{{item}}"
          >
            <view class="picker-name">{{item.name}}</view>
            <view class="picker-sub text-weak text-sm">{{item.building}}</view>
          </view>
          <view wx:if="{{!points.length}}" class="picker-empty text-weak text-sm">暂无可用送达点</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选择预计送达时间（尽快送达默认 + 从当前时间向后递增的指定时间档） -->
  <view wx:if="{{showTimeSheet}}" class="popup-mask" bindtap="closeTimeSheet">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closeTimeSheet">
        <t-icon name="close" size="20" color="#C0C0C0" />
      </view>
      <view class="tsheet">
        <view class="picker-title">选择预计送达时间</view>
        <view class="tsheet-opt {{deliveryMode === 'asap' ? 'on' : ''}}" bindtap="chooseAsap">
          <text>尽快送达</text>
          <text class="tsheet-sub">预计 {{asapEta}} 送达</text>
        </view>
        <view
          class="tsheet-opt {{deliveryMode === 'scheduled' && scheduledTime === item.value ? 'on' : ''}}"
          wx:for="{{timeOptions}}" wx:key="value"
          bindtap="chooseScheduled" data-item="{{item}}"
        >
          <text>{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 选择优惠活动（淘宝/京东式：自动推荐最优、可切换、可「不使用优惠」；同一笔订单最多用 1 个） -->
  <view wx:if="{{promoShow}}" class="popup-mask" bindtap="hidePromos">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="hidePromos">
        <t-icon name="close" size="20" color="#C0C0C0" />
      </view>
      <view class="coupon-panel">
        <view class="picker-title">选择优惠</view>
        <view class="picker-sub text-weak text-sm">同一笔订单最多使用 1 个优惠 · 再点一次可取消勾选</view>
        <!-- 优惠候选：左=面额大字，中=名称/门槛/有效期，右=推荐/勾选（点已勾选的再点一次=取消） -->
        <view
          class="coupon-item {{item.selected ? 'on' : ''}}"
          wx:for="{{promoCandidates}}" wx:key="id"
          bindtap="choosePromo" data-id="{{item.id}}"
        >
          <view class="coupon-amount">
            <view class="coupon-amount-main {{item.type === 'discount' ? 'zhe' : ''}}">{{item.amountText}}</view>
            <view class="coupon-amount-sub text-weak text-sm" wx:if="{{item.type === 'full_reduce'}}">满减券</view>
            <view class="coupon-amount-sub text-weak text-sm" wx:if="{{item.type === 'discount'}}">可省 ¥{{item.reduceTxt}}</view>
          </view>
          <view class="coupon-info">
            <view class="coupon-info-title ellipsis">{{item.title || item.desc}}</view>
            <view class="coupon-info-desc text-weak text-sm">{{item.desc}}</view>
            <view class="coupon-info-valid text-weak text-xs" wx:if="{{item.valid}}">{{item.valid}}</view>
          </view>
          <view class="coupon-right">
            <view class="coupon-rec" wx:if="{{item.recommend}}">推荐</view>
            <view class="coupon-check {{item.selected ? 'on' : ''}}">
              <t-icon wx:if="{{item.selected}}" name="check" size="12" color="#ffffff" />
            </view>
          </view>
        </view>
        <view wx:if="{{!promoCandidates.length}}" class="coupon-empty text-weak text-sm">暂无可用优惠</view>
      </view>
    </view>
  </view>

  <!-- 选择优惠券：默认自动选中抵扣最多的「最优券」（打推荐角标），可切换、可「不使用优惠券」；
       不可用的券置灰放在下面并写明原因（未达最低消费 / 商品不适用 / 已过期…） -->
  <view wx:if="{{couponShow}}" class="popup-mask" bindtap="hideCouponSheet">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="hideCouponSheet">
        <t-icon name="close" size="20" color="#C0C0C0" />
      </view>
      <view class="coupon-panel">
        <view class="picker-title">选择优惠券</view>
        <!-- 不使用优惠券 -->
        <view class="coupon-item {{selectedCoupon ? '' : 'on'}}" bindtap="useNoCoupon">
          <view class="coupon-info">
            <view class="coupon-info-title">不使用优惠券</view>
          </view>
          <view class="coupon-right">
            <view class="coupon-check {{selectedCoupon ? '' : 'on'}}">
              <t-icon wx:if="{{!selectedCoupon}}" name="check" size="12" color="#ffffff" />
            </view>
          </view>
        </view>
        <!-- 可用券 -->
        <view
          class="coupon-item {{selectedCoupon && selectedCoupon.user_coupon_id === item.user_coupon_id ? 'on' : ''}}"
          wx:for="{{couponUsable}}" wx:key="user_coupon_id"
          bindtap="chooseUserCoupon" data-id="{{item.user_coupon_id}}"
        >
          <view class="coupon-amount">
            <view class="coupon-amount-main {{item.faceZhe ? 'zhe' : ''}}">{{item.faceText}}</view>
            <view class="coupon-amount-sub text-weak text-sm">{{item.saveText}}</view>
          </view>
          <view class="coupon-info">
            <view class="coupon-info-title ellipsis">{{item.title}}</view>
            <view class="coupon-info-desc text-weak text-sm">{{item.desc}}</view>
            <view class="coupon-info-valid text-weak text-xs" wx:if="{{item.expireText}}">有效期至 {{item.expireText}}</view>
          </view>
          <view class="coupon-right">
            <view class="coupon-rec" wx:if="{{item.user_coupon_id === couponBestId}}">推荐</view>
            <view class="coupon-check {{selectedCoupon && selectedCoupon.user_coupon_id === item.user_coupon_id ? 'on' : ''}}">
              <t-icon wx:if="{{selectedCoupon && selectedCoupon.user_coupon_id === item.user_coupon_id}}" name="check" size="12" color="#ffffff" />
            </view>
          </view>
        </view>
        <view wx:if="{{!couponUsable.length}}" class="coupon-empty text-weak text-sm">暂无可用优惠券</view>
        <!-- 不可用券：置灰 + 写明原因，让用户知道「差多少能用」 -->
        <block wx:if="{{couponUnusable.length}}">
          <view class="coupon-group-title">不可用（{{couponUnusable.length}}）</view>
          <view class="coupon-item disabled" wx:for="{{couponUnusable}}" wx:key="user_coupon_id">
            <view class="coupon-amount grey">
              <view class="coupon-amount-main {{item.faceZhe ? 'zhe' : ''}}">{{item.faceText}}</view>
              <view class="coupon-amount-sub text-weak text-sm">{{item.typeLabel}}</view>
            </view>
            <view class="coupon-info">
              <view class="coupon-info-title ellipsis">{{item.title}}</view>
              <view class="coupon-info-desc text-weak text-sm">{{item.desc}}</view>
              <view class="coupon-info-reason">{{item.reason_text}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
