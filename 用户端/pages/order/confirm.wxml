<view class="confirm-page">
  <!-- 上部分：信息显示 -->
  <view class="card info-card">
    <!-- 第一行：送达楼栋 + 详细地址（加大显示，点击弹出楼栋选择） -->
    <view class="addr-main" bindtap="showPointPicker">
      <block wx:if="{{selectedPoint}}">
        <view class="addr-line">
          <t-icon name="location" size="18" color="#3078C0" />
          <text class="addr-main-text">{{selectedPoint.name}}{{selectedAddress && selectedAddress.detail ? ' · ' + selectedAddress.detail : ''}}</text>
          <t-icon name="chevron-right" size="14" color="#C0C0C0" />
        </view>
      </block>
      <view wx:else class="addr-line">
        <t-icon name="location" size="18" color="#3078C0" />
        <text class="addr-main-text addr-placeholder">请选择送达楼栋</text>
        <t-icon name="chevron-right" size="14" color="#C0C0C0" />
      </view>
    </view>
    <!-- 第二行：收货人（可编辑） -->
    <view class="info-row">
      <text class="info-label">收货人：</text>
      <input class="info-input" placeholder="请输入收餐人姓名" placeholder-class="field-placeholder" value="{{contactName}}" bind:input="onName" />
    </view>
    <!-- 第三行：联系电话（可编辑） -->
    <view class="info-row">
      <text class="info-label">联系电话：</text>
      <input class="info-input" type="number" placeholder="请输入联系电话" placeholder-class="field-placeholder" value="{{contactPhone}}" bind:input="onPhone" />
    </view>
    <!-- 第四行：预计送达时间（左右两部分） -->
    <view class="time-row" bindtap="openTimeSheet">
      <view class="time-mode">{{deliveryMode === 'asap' ? '立即送出' : '指定时间'}}</view>
      <view class="time-val blue">{{deliveryMode === 'asap' ? '预计 ' + asapEta + ' 送达' : scheduledTime}}</view>
      <t-icon name="edit" size="14" color="#3078C0" />
    </view>
  </view>

  <!-- 下部分：优惠券 + 商品信息 -->
  <view class="card goods-card">
    <view class="cell">
      <view class="cell-label">优惠券</view>
      <view class="cell-value">暂无可用</view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
    <view class="shop-row">
      <view class="shop-badge"><t-icon name="shop" size="14" color="#3078C0" /></view>
      <text class="shop-name">零栋铺子</text>
      <view class="tag tag-orange" wx:if="{{shopClosed}}">歇业</view>
    </view>
    <view class="o-item" wx:for="{{items}}" wx:key="goods_id">
      <view class="o-img">
        <image wx:if="{{item.image}}" class="fill-img" src="{{item.image}}" mode="aspectFill" />
        <t-icon wx:else name="app" size="18" color="#BFBFBF" />
      </view>
      <view class="o-info">
        <view class="o-name ellipsis">{{item.name}}</view>
        <view class="o-qty text-weak text-sm">x{{item.quantity}}</view>
      </view>
      <view class="o-price">
        <view class="o-price-now">实付 ¥{{item.total}}</view>
        <view class="o-price-old" wx:if="{{item.price}}">¥{{item.price}}</view>
      </view>
    </view>
    <view class="fee-row">
      <text class="fee-label">打包费</text>
      <t-icon name="info-circle" size="12" color="#C0C0C0" />
      <text class="fee-val">¥0</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">配送费</text>
      <t-icon name="info-circle" size="12" color="#C0C0C0" />
      <text class="fee-val">¥0</text>
    </view>
    <view class="discount-row">
      <text class="discount-label">总优惠</text>
      <text class="discount-val">¥0.00</text>
    </view>
    <view class="discount-row total-row">
      <text class="discount-label">合计：</text>
      <text class="discount-total">¥{{total}}</text>
    </view>
    <view class="remark-row">
      <text class="remark-label">备注信息</text>
      <input class="remark-input" placeholder="选填，建议与商家沟通后再填写" placeholder-class="field-placeholder" value="{{remark}}" bind:input="onRemark" />
    </view>
  </view>

  <view class="disclaimer-link">
    免责说明
    <t-icon name="info-circle" size="12" color="#999999" />
  </view>

  <!-- 底部支付 -->
  <view class="bottom-bar safe-bottom">
    <view class="pay-icon">
      <t-icon name="robot-1" size="22" color="#3078C0" />
    </view>
    <view class="pay-total">
      <text class="text-sub">共计</text>
      <text class="pay-price">¥{{total}}</text>
    </view>
    <view class="btn {{submitting || shopClosed ? 'btn-disabled' : ''}}" bindtap="submit" style="flex-shrink:0; margin-left:24rpx; padding:0 64rpx;">
      {{shopClosed ? '店铺歇业' : (submitting ? '提交中...' : '支付')}}
    </view>
  </view>

  <!-- 选择送达楼栋 -->
  <view wx:if="{{showPicker}}" class="popup-mask" bindtap="closePicker">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closePicker">
        <t-icon name="close" size="20" color="#C0C0C0" />
      </view>
      <view class="picker">
        <view class="picker-title">选择送达楼栋</view>
        <view class="picker-list">
          <view
            class="picker-item {{selectedPoint && selectedPoint.id === item.id ? 'active' : ''}}"
            wx:for="{{points}}" wx:key="id"
            bindtap="choosePoint" data-item="{{item}}"
          >
            <view class="picker-name">{{item.name}}</view>
            <view class="picker-sub text-weak text-sm">{{item.building}} {{item.floor}}</view>
          </view>
          <view wx:if="{{!points.length}}" class="picker-empty text-weak text-sm">暂无可用送达点</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选择预计送达时间（尽快送达默认 + 从当前时间向后递增的指定时间档） -->
  <view wx:if="{{showTimeSheet}}" class="popup-mask" bindtap="closeTimeSheet">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closeTimeSheet">
        <t-icon name="close" size="20" color="#C0C0C0" />
      </view>
      <view class="tsheet">
        <view class="picker-title">选择预计送达时间</view>
        <view class="tsheet-opt {{deliveryMode === 'asap' ? 'on' : ''}}" bindtap="chooseAsap">
          <text>尽快送达</text>
          <text class="tsheet-sub">预计 {{asapEta}} 送达</text>
        </view>
        <view
          class="tsheet-opt {{deliveryMode === 'scheduled' && scheduledTime === item.value ? 'on' : ''}}"
          wx:for="{{timeOptions}}" wx:key="value"
          bindtap="chooseScheduled" data-item="{{item}}"
        >
          <text>{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
