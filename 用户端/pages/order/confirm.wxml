<view class="confirm-page">
  <view class="hero-area">
    <view class="loc-pill" bindtap="showPointPicker">
      <t-icon name="location" size="14" color="#2E7CF6" />
      <text class="{{selectedPoint ? '' : 'loc-placeholder'}}">{{selectedPoint ? selectedPoint.name : '请选择配送站'}}</text>
    </view>
  </view>

  <!-- 收货地址（关联「我的-收货地址」） -->
  <view class="card addr-card" bindtap="showAddressPicker">
    <view class="addr-icon"><t-icon name="location" size="18" color="#2E7CF6" /></view>
    <view class="addr-body" wx:if="{{selectedAddress}}">
      <view class="addr-line1">
        <text class="addr-name">{{selectedAddress.contact_name}}</text>
        <text class="addr-phone">{{selectedAddress.contact_phone}}</text>
        <view class="tag tag-green" wx:if="{{selectedAddress.is_default}}">默认</view>
      </view>
      <view class="addr-line2 text-sub">{{selectedAddress.landmark_name}}{{selectedAddress.detail ? ' · ' + selectedAddress.detail : ''}}</view>
    </view>
    <view class="addr-body" wx:else>
      <view class="addr-placeholder">请选择收货地址</view>
    </view>
    <view class="addr-arrow"><t-icon name="chevron-right" size="14" color="#C0C6CF" /></view>
  </view>

  <view class="card dest-card" bindtap="showPointPicker">
    <view class="dest-header">
      <text class="dest-title">送到哪</text>
      <view class="dest-arrow"><t-icon name="chevron-right" size="14" color="#2E7CF6" /></view>
    </view>
    <view class="dest-sub" wx:if="{{selectedPoint}}">{{selectedPoint.building}} {{selectedPoint.floor}} · 机器人送达点</view>
  </view>

  <view class="card time-card" bindtap="openTimeSheet">
    <text class="time-label">预计送达时间：</text>
    <text class="{{deliveryTime ? 'time-value' : 'time-placeholder'}}">{{deliveryTime || '请选择配送时间'}}</text>
    <t-icon name="edit" size="14" color="#2E7CF6" />
  </view>

  <view class="card">
    <view class="shop-row">
      <view class="shop-badge"><t-icon name="shop" size="14" color="#2E7CF6" /></view>
      <text class="shop-name">零栋铺子</text>
      <view class="tag tag-orange" wx:if="{{shopClosed}}">歇业</view>
    </view>
    <view class="o-item" wx:for="{{items}}" wx:key="goods_id">
      <view class="o-img">
        <image wx:if="{{item.image}}" class="fill-img" src="{{item.image}}" mode="aspectFill" />
        <t-icon wx:else name="app" size="18" color="#BFBFBF" />
      </view>
      <view class="o-info">
        <view class="o-name ellipsis">{{item.name}}</view>
        <view class="o-qty text-weak text-sm">x{{item.quantity}}</view>
      </view>
      <view class="o-price">
        <view class="o-price-now">实付 ¥{{item.total}}</view>
        <view class="o-price-old" wx:if="{{item.price}}">¥{{item.price}}</view>
      </view>
    </view>
    <view class="fee-row">
      <text class="fee-label">打包费</text>
      <t-icon name="info-circle" size="12" color="#C0C6CF" />
      <text class="fee-val">¥0</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">配送费</text>
      <t-icon name="info-circle" size="12" color="#C0C6CF" />
      <text class="fee-val">¥0</text>
    </view>
    <view class="remark-row">
      <text class="remark-label">备注信息</text>
      <input class="remark-input" placeholder="选填，建议与商家沟通后再填写" placeholder-class="field-placeholder" value="{{remark}}" bind:input="onRemark" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">收货信息</view>
    <view class="field">
      <view class="field-label">姓名</view>
      <input class="field-input" placeholder="收餐人姓名" placeholder-class="field-placeholder" value="{{contactName}}" bind:input="onName" />
    </view>
    <view class="field">
      <view class="field-label">电话</view>
      <input class="field-input" placeholder="收餐人手机号" placeholder-class="field-placeholder" value="{{contactPhone}}" type="number" bind:input="onPhone" />
    </view>
  </view>

  <view class="card">
    <view class="cell">
      <view class="cell-label">优惠券</view>
      <view class="cell-value">暂无可用</view>
      <t-icon name="chevron-right" size="14" color="#C0C6CF" />
    </view>
    <view class="discount-row">
      <text class="discount-label">总优惠</text>
      <text class="discount-val">¥0.00</text>
    </view>
    <view class="discount-row">
      <text class="discount-label">合计：</text>
      <text class="discount-total">¥{{total}}</text>
      <t-icon name="chevron-right" size="14" color="#C0C6CF" />
    </view>
  </view>

  <view class="disclaimer-link">
    免责说明
    <t-icon name="info-circle" size="12" color="#99A3B0" />
  </view>

  <view class="bottom-bar safe-bottom">
    <view class="pay-icon">
      <t-icon name="robot-1" size="22" color="#2E7CF6" />
    </view>
    <view class="pay-total">
      <text class="text-sub">共计</text>
      <text class="pay-price">¥{{total}}</text>
    </view>
    <view class="btn {{submitting || shopClosed ? 'btn-disabled' : ''}}" bindtap="submit" style="flex-shrink:0; margin-left:24rpx; padding:0 64rpx;">
      {{shopClosed ? '店铺歇业' : (submitting ? '提交中...' : '支付')}}
    </view>
  </view>

  <view wx:if="{{showPicker}}" class="popup-mask" bindtap="closePicker">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closePicker">
        <t-icon name="close" size="20" color="#C0C6CF" />
      </view>
      <view class="picker">
        <view class="picker-title">选择送达点位</view>
        <view class="picker-list">
          <view
            class="picker-item {{selectedPoint && selectedPoint.id === item.id ? 'active' : ''}}"
            wx:for="{{points}}" wx:key="id"
            bindtap="choosePoint" data-item="{{item}}"
          >
            <view class="picker-name">{{item.name}}</view>
            <view class="picker-sub text-weak text-sm">{{item.building}} {{item.floor}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showAddressPicker}}" class="popup-mask" bindtap="closeAddressPicker">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closeAddressPicker">
        <t-icon name="close" size="20" color="#C0C6CF" />
      </view>
      <view class="picker">
        <view class="picker-title">选择收货地址</view>
        <view class="picker-list">
          <view
            class="picker-item {{selectedAddress && selectedAddress.id === item.id ? 'active' : ''}}"
            wx:for="{{addresses}}" wx:key="id"
            bindtap="chooseAddress" data-index="{{index}}"
          >
            <view class="addr-pick-line1">
              <text class="picker-name">{{item.contact_name}}</text>
              <text class="addr-pick-phone text-weak text-sm">{{item.contact_phone}}</text>
              <view class="tag tag-green" wx:if="{{item.is_default}}">默认</view>
            </view>
            <view class="picker-sub text-weak text-sm">{{item.landmark_name}}{{item.detail ? ' · ' + item.detail : ''}}</view>
          </view>
          <view wx:if="{{!addresses.length}}" class="picker-empty text-weak text-sm">暂无收货地址，请先新增</view>
        </view>
        <view class="btn btn-block addr-add-btn" bindtap="addAddress">新增收货地址</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showTimeSheet}}" class="popup-mask" bindtap="closeTimeSheet">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closeTimeSheet">
        <t-icon name="close" size="20" color="#C0C6CF" />
      </view>
      <view class="tsheet">
        <view class="picker-title">选择预计送达时间</view>
        <view class="tsheet-body">
          <view class="tsheet-days">
            <view
              class="tsheet-day {{timeDay === item ? 'on' : ''}}"
              wx:for="{{timeDays}}" wx:key="*this"
              bindtap="chooseDay" data-day="{{item}}"
            >{{item}}</view>
          </view>
          <scroll-view scroll-y class="tsheet-times" enhanced show-scrollbar="{{false}}">
            <view class="tsheet-times-inner">
              <view
                class="tsheet-time"
                wx:for="{{timeSlots}}" wx:key="*this"
                bindtap="chooseTime" data-slot="{{item}}"
              >{{item}}</view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </view>
</view>
