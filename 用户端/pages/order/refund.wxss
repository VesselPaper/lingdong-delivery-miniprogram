.refund-page {
  padding: 24rpx 32rpx 60rpx;
}

.type-row {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  border-radius: 16rpx;
  background: #F5F7FA;
  border: 2rpx solid #F5F7FA;
}

.type-item.on {
  background: #EEF4FF;
  border-color: #3078C0;
}

.type-item text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.type-item.on text {
  color: #3078C0;
  font-weight: 600;
}

.reason-input {
  width: 100%;
  height: 220rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.ph {
  color: #B0B6C0;
}

.reason-count {
  text-align: right;
  margin-top: 8rpx;
}

.foot-actions {
  margin-top: 32rpx;
}
