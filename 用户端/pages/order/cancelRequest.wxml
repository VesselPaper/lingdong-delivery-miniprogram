<view class="cancel-request-page">
  <view class="card" wx:if="{{order.order_no}}">
    <view class="section-title">订单信息</view>
    <view class="info-row text-sub"><text>订单号</text><view class="info-value"><text class="info-text">{{order.order_no}}</text><view class="copy-btn" hover-class="copy-btn-hover" hover-stay-time="80" bindtap="copyText" data-text="{{order.order_no}}">复制</view></view></view>
    <view class="info-row text-sub"><text>金额</text><text class="pay-amount">¥{{order.total_amount}}</text></view>
    <view class="info-row text-sub"><text>订单状态</text><text>{{order.status_text}}</text></view>
    <view class="info-row text-sub"><text>说明</text><text class="text-weak">已超过可自由取消时间，需提交申请由商家判断是否同意取消</text></view>
  </view>

  <view class="card">
    <view class="section-title">取消原因</view>
    <textarea class="reason-input" placeholder="请说明取消原因（必填）" placeholder-class="ph" value="{{reason}}" bindinput="onReason" maxlength="200" />
    <view class="reason-count text-weak text-sm">{{reason.length}}/200</view>
  </view>

  <view class="foot-actions">
    <view class="btn btn-block" bindtap="submit">提交取消申请</view>
  </view>
</view>
