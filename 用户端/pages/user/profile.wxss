.profile-page {
  min-height: 100vh;
  padding: 32rpx 32rpx 240rpx;
  box-sizing: border-box;
}

.user-row {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 40rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #DCE9F8;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #111111;
}

.user-phone {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.login-link {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  background: #ffffff;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #3078C0;
}

/* 我的订单 */
.orders-card {
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  padding: 28rpx 8rpx 24rpx;
  margin-bottom: 20rpx;
}

.orders-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
  padding: 0 24rpx 20rpx;
}

.orders-grid {
  display: flex;
}

.orders-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.orders-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #DCE9F8;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 订单红点：未读动态提示（订单到达/状态已接单） */
.orders-dot {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 50%;
  background: #E64340;
  border: 3rpx solid #ffffff;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 22rpx;
  text-align: center;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orders-label {
  font-size: 22rpx;
  color: #666666;
}

/* 菜单 */
.menu {
  padding: 0 !important;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
}

.menu .cell {
  padding: 28rpx 32rpx;
}

.foot {
  text-align: center;
  margin-top: 48rpx;
}
