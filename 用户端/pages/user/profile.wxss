.profile-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 240rpx;
  box-sizing: border-box;
}

/* 身份卡：白底 + 1rpx 描边 + 12rpx 圆角，与全站卡片同一套 token */
.id-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.id-card-hover {
  background: #FAFAFA;
}

/* 头像按钮：<button> 自带边框/内边距/背景，这里全部抹掉，只借用它的 chooseAvatar 能力 */
.id-avatar-btn {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0 28rpx 0 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
  overflow: visible;
}

.id-avatar-btn::after {
  border: none;
}

/* 头像：品牌蓝实心圆 + 昵称首字；有微信头像时换成图片 */
.id-avatar {
  width: 128rpx;
  height: 128rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--brand);
  border: 6rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.id-avatar-off {
  background: var(--fill);
  border-width: 2rpx;
  border-color: var(--line);
}

.id-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.id-avatar-text {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1;
}

/* 右下角相机角标：告诉用户「头像点一下能换」 */
.id-avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--brand-deep);
  border: 3rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.id-body {
  flex: 1;
  min-width: 0;
}

.id-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.25;
}

.id-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  min-width: 0;
}

.id-role {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  background: #EAF3FF;
  color: var(--brand);
  font-size: 22rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

/* 手机号按 3-4-4 分组，数字串读起来更清楚 */
.id-phone {
  font-size: 26rpx;
  color: var(--text-sub);
  letter-spacing: 1rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.id-sub {
  font-size: 24rpx;
  color: var(--text-weak);
}

.id-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.id-action-text {
  font-size: 26rpx;
  color: var(--text-weak);
}

/* 我的订单 */
.orders-card {
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  padding: 28rpx 8rpx 24rpx;
  margin-bottom: 20rpx;
}

.orders-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
  padding: 0 24rpx 20rpx;
}

.orders-grid {
  display: flex;
}

.orders-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.orders-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #DCE9F8;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 订单红点：未读动态提示（订单到达/状态已接单） */
.orders-dot {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 50%;
  background: #E64340;
  border: 3rpx solid #ffffff;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 22rpx;
  text-align: center;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orders-label {
  font-size: 22rpx;
  color: #666666;
}

/* 菜单 */
.menu {
  padding: 0 !important;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
}

.menu .cell {
  padding: 28rpx 32rpx;
}

.foot {
  text-align: center;
  margin-top: 48rpx;
}


