<view class="settings-page">
  <view class="card">
    <view class="section-title">个人信息</view>
    <view class="field">
      <view class="field-label">昵称</view>
      <input class="field-input" placeholder="请输入昵称" placeholder-class="field-placeholder" value="{{form.nickname}}" bind:input="onField" data-field="nickname" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input class="field-input" type="number" placeholder="请输入手机号" placeholder-class="field-placeholder" value="{{form.phone}}" bind:input="onField" data-field="phone" />
    </view>
  </view>

  <view class="card">
    <view class="cell logout-cell" bindtap="logout">
      <view class="logout-label">退出登录</view>
    </view>
  </view>

  <view class="bottom-bar safe-bottom">
    <view class="btn btn-block" bindtap="save">保存</view>
  </view>
</view>
