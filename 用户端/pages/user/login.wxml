<view class="login-page">
  <view class="login-hero">
    <view class="login-logo">
      <t-icon name="robot-1" size="26" color="#3078C0" />
    </view>
    <view class="login-title">零栋GO</view>
    <view class="login-sub">无人车配送 校园点餐新体验</view>
  </view>

  <view class="login-actions">
    <!-- 微信资料（2026-10-12 起默认取微信昵称/头像）：微信平台规则不允许静默读取，
         必须用户主动点一次 —— 头像按钮点一下=微信头像，昵称框点一下=微信昵称。登录时随 code 一起建档。 -->
    <view class="wechat-profile" wx:if="{{!showAccount}}">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" hover-class="none">
        <image wx:if="{{avatarPath}}" class="avatar-img" src="{{avatarPath}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder"><t-icon name="user" size="24" color="#C0C0C0" /></view>
      </button>
      <input class="nickname-input" type="nickname" placeholder="点击填写微信昵称（默认）" placeholder-class="login-ph"
        value="{{wechatNickname}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
    </view>

    <view class="btn btn-block {{logging ? 'btn-disabled' : ''}}" bindtap="wechatLogin">{{loginDemo ? '模拟登录（演示）' : '微信一键登录'}}</view>
    <view class="login-tip text-weak text-sm">登录即同意《用户协议》与《隐私政策》</view>

    <!-- 账号密码登录（2026-10-11 新增）：不依赖微信凭据，成员本机联调/演示用；默认收起 -->
    <view class="login-tip text-weak text-sm" wx:if="{{!showAccount}}" bindtap="toggleAccount">用账号密码登录</view>
    <view class="login-account" wx:if="{{showAccount}}">
      <input class="login-input" type="text" placeholder="账号" placeholder-class="login-ph" value="{{username}}" bindinput="onUsernameInput" />
      <input class="login-input" password="{{true}}" placeholder="密码" placeholder-class="login-ph" value="{{password}}" bindinput="onPasswordInput" />
      <view class="btn btn-block {{logging ? 'btn-disabled' : ''}}" bindtap="accountLogin">账号密码登录</view>
      <view class="login-tip text-weak text-sm" bindtap="toggleAccount">收起，用微信登录</view>
    </view>
  </view>
</view>
