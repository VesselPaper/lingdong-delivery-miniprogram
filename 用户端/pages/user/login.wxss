.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  background: linear-gradient(180deg, #D9EAFF 0%, #F6F8FB 70%);
  box-sizing: border-box;
}

.login-hero {
  text-align: center;
  margin-bottom: 96rpx;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #4E9AF8 0%, #2E7CF6 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(46, 124, 246, 0.3);
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.login-sub {
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
}

.login-tip {
  text-align: center;
  margin-top: 24rpx;
}
