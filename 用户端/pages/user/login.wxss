.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  background: linear-gradient(180deg, #E4F0FF 0%, #FAFAFA 60%);
  box-sizing: border-box;
}

.login-hero {
  text-align: center;
  margin-bottom: 96rpx;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  background: #DCE9F8;
  color: #3078C0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

.login-sub {
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
}

.login-tip {
  text-align: center;
  margin-top: 24rpx;
}
