.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  background: linear-gradient(180deg, #E4F0FF 0%, #FAFAFA 60%);
  box-sizing: border-box;
}

.login-hero {
  text-align: center;
  margin-bottom: 96rpx;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  background: #DCE9F8;
  color: #3078C0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

.login-sub {
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
}

.login-tip {
  text-align: center;
  margin-top: 24rpx;
}

/* 账号密码登录（2026-10-11 新增）：默认收起，点「用账号密码登录」展开 */
.login-account {
  margin-top: 32rpx;
}

.login-input {
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #111111;
  box-sizing: border-box;
}

.login-ph {
  color: #999999;
}
