.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  background: linear-gradient(180deg, #E4F0FF 0%, #FAFAFA 60%);
  box-sizing: border-box;
}

.login-hero {
  text-align: center;
  margin-bottom: 96rpx;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  background: #DCE9F8;
  color: #3078C0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

.login-sub {
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
}

.login-tip {
  text-align: center;
  margin-top: 24rpx;
}

/* 账号密码登录（2026-10-11 新增）：默认收起，点「用账号密码登录」展开 */
.login-account {
  margin-top: 32rpx;
}

.login-input {
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #111111;
  box-sizing: border-box;
}

.login-ph {
  color: #999999;
}

/* 微信资料（2026-10-12 起：登录时默认取微信昵称/头像）：
   头像按钮点一下=微信头像；昵称框点一下=微信昵称。两段并排一行。 */
.wechat-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: #FFFFFF;
  border: 2rpx dashed #C0C0C0;
  overflow: hidden;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nickname-input {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #111111;
  box-sizing: border-box;
}
