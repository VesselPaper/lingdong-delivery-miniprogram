<view class="profile-page sky-bg">
  <view class="id-card" bindtap="onUserTap" hover-class="id-card-hover" hover-stay-time="60">
    <!-- 头像本身是可点的：已登录时用微信 chooseAvatar（选择器里默认就是微信头像），未登录时点它去登录 -->
    <button
      class="id-avatar-btn"
      open-type="{{user.id ? 'chooseAvatar' : ''}}"
      bind:chooseavatar="onChooseAvatar"
      catch:tap="onAvatarTap"
    >
      <view class="id-avatar {{user.id ? '' : 'id-avatar-off'}}">
        <image wx:if="{{user.avatar}}" class="id-avatar-img" src="{{user.avatar}}" mode="aspectFill" />
        <text wx:elif="{{user.id}}" class="id-avatar-text">{{userInitial}}</text>
        <t-icon wx:else name="user" size="26" color="#9AA6B2" />
      </view>
      <view class="id-avatar-edit" wx:if="{{user.id}}">
        <t-icon name="camera" size="11" color="#ffffff" />
      </view>
    </button>

    <view class="id-body">
      <block wx:if="{{user.id}}">
        <view class="id-name ellipsis">{{user.nickname || '零栋用户'}}</view>
        <view class="id-meta" wx:if="{{roleText || phoneText}}">
          <view wx:if="{{roleText}}" class="id-role">{{roleText}}</view>
          <text wx:if="{{phoneText}}" class="id-phone">{{phoneText}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="id-name">未登录</view>
        <view class="id-meta"><text class="id-sub">登录后即可下单、查看配送进度</text></view>
      </block>
    </view>

    <view class="id-action">
      <text class="id-action-text">{{user.id ? '编辑' : '登录'}}</text>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
  </view>

  <view class="card orders-card">
    <view class="orders-title">我的订单</view>
    <view class="orders-grid">
      <view class="orders-item" bindtap="goOrdersTab" data-status="0">
        <view class="orders-icon">
          <t-icon name="money" size="20" color="#3078C0" />
          <view class="orders-dot" wx:if="{{orderBadge.paying}}">{{orderBadge.paying}}</view>
        </view>
        <text class="orders-label">待付款</text>
      </view>
      <view class="orders-item" bindtap="goOrdersTab" data-status="2">
        <view class="orders-icon">
          <t-icon name="robot-1" size="20" color="#3078C0" />
          <view class="orders-dot" wx:if="{{orderBadge.delivering}}">{{orderBadge.delivering}}</view>
        </view>
        <text class="orders-label">配送中</text>
      </view>
      <view class="orders-item" bindtap="goOrdersTab" data-status="3">
        <view class="orders-icon">
          <t-icon name="location" size="20" color="#3078C0" />
          <view class="orders-dot" wx:if="{{orderBadge.arrived}}">{{orderBadge.arrived}}</view>
        </view>
        <text class="orders-label">已送达</text>
      </view>
      <view class="orders-item" bindtap="goOrdersTab" data-status="4">
        <view class="orders-icon"><t-icon name="check-circle" size="20" color="#3078C0" /></view>
        <text class="orders-label">已完成</text>
      </view>
      <view class="orders-item" bindtap="goOrdersTab" data-status="">
        <view class="orders-icon"><t-icon name="order" size="20" color="#3078C0" /></view>
        <text class="orders-label">全部订单</text>
      </view>
    </view>
  </view>

  <view class="card menu">
    <view class="cell" bindtap="goAddress">
      <t-icon name="location" size="18" color="#111111" />
      <view class="cell-label" style="margin-left:16rpx;">收货地址</view>
      <view class="cell-value {{pointName ? '' : 'text-weak'}}">{{pointName || '未设置楼栋'}}</view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
    <view class="cell" bindtap="goRefundList">
      <t-icon name="service" size="18" color="#111111" />
      <view class="cell-label" style="margin-left:16rpx;">售后记录</view>
      <view class="cell-value"></view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
    <view class="cell" bindtap="showInfo">
      <t-icon name="info-circle" size="18" color="#111111" />
      <view class="cell-label" style="margin-left:16rpx;">配送说明</view>
      <view class="cell-value"></view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
    <view class="cell" bindtap="contactService">
      <t-icon name="service" size="18" color="#111111" />
      <view class="cell-label" style="margin-left:16rpx;">联系客服</view>
      <view class="cell-value"></view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
    <view class="cell" bindtap="goSetting">
      <t-icon name="setting" size="18" color="#111111" />
      <view class="cell-label" style="margin-left:16rpx;">设置</view>
      <view class="cell-value"></view>
      <t-icon name="chevron-right" size="14" color="#C0C0C0" />
    </view>
  </view>

  <view class="foot text-weak text-sm">零栋GO · 四川师范大学 · 零栋铺子</view>
</view>
