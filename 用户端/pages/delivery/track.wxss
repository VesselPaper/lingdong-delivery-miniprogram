.track-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding: 24rpx;
  padding-bottom: 240rpx;
  box-sizing: border-box;
}

.robot-card {
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.robot-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.robot-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #DCE9F8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.robot-info {
  flex: 1;
}

.robot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.robot-status {
  font-size: 26rpx;
  color: #3078C0;
  margin-top: 6rpx;
}

.robot-progress {
  margin-top: 32rpx;
}

.progress-track {
  height: 10rpx;
  background: #DCE9F8;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #3078C0;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

.progress-labels .on {
  color: #3078C0;
  font-weight: 600;
}

.map-card {
  position: relative;
  height: 520rpx;
  background: #EAF2FA;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

/* 缩放/平移的画布容器：整个内容一起变换 */
.map-canvas {
  position: absolute;
  inset: 0;
  transform-origin: center center;
  transition: transform 0.05s linear;
}

.map-grid {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(rgba(48,120,192,0.10) 1px, transparent 1px),
    linear-gradient(90deg, rgba(48,120,192,0.10) 1px, transparent 1px),
    #EAF2FA;
  background-size: 44rpx 44rpx;
}

/* 路线折线段：以起点为锚，旋转角度 + 宽度即长度（百分比相对容器宽） */
.map-route-seg {
  position: absolute;
  height: 6rpx;
  background: #3078C0;
  border-radius: 3rpx;
  transform-origin: left center;
  opacity: 0.7;
}

/* 点位标记 */
.map-landmark {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.map-landmark-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #94A3B8;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx rgba(148,163,184,0.5);
}

.map-landmark.is-loading .map-landmark-dot {
  background: #F59F00;
  box-shadow: 0 0 0 2rpx rgba(245,159,0,0.5);
}

.map-landmark-name {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #475569;
  white-space: nowrap;
  background: rgba(255,255,255,0.85);
  padding: 0 6rpx;
  border-radius: 4rpx;
}

/* 机器人实时位置 */
.map-robot {
  position: absolute;
  transform: translate(-50%, -50%);
  transition: all 0.6s ease;
  z-index: 3;
}

.map-robot-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #3078C0;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(48,120,192,0.4);
}

.map-dest {
  position: absolute;
}

/* 缩放控制条 */
.map-zoombar {
  position: absolute;
  right: 16rpx;
  bottom: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  z-index: 4;
}

.map-zoom-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,0.95);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #3078C0;
}

.map-tip {
  position: absolute;
  left: 0; right: 0; bottom: 8rpx;
  text-align: center;
  color: #111111;
  z-index: 4;
}

.pickup-code {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #3078C0;
  margin: 8rpx 0;
  text-align: center;
}

.foot-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}

.empty {
  padding-top: 200rpx;
}

.order-btn {
  margin: 40rpx auto 0;
  width: 240rpx;
}
