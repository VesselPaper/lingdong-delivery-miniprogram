<view class="track-page">
  <view wx:if="{{empty}}" class="empty">
    <view class="empty-icon"><t-icon name="robot-1" size="40" color="#D8D8D8" /></view>
    <view class="empty-text">暂无配送中的订单</view>
    <view class="btn btn-sm order-btn" bindtap="goOrder">去下单</view>
  </view>
  <block wx:else>
    <view class="robot-card">
      <view class="robot-head">
        <view class="robot-icon">
          <t-icon name="robot-1" size="28" color="#3078C0" />
        </view>
        <view class="robot-info">
          <view class="robot-name">零栋无人配送机器人</view>
          <view class="robot-status">{{taskText}}</view>
        </view>
        <view class="tag tag-dark">{{order.order_status === 6 ? '配送异常' : (order.order_status === 3 ? '待取餐' : '配送中')}}</view>
      </view>
      <view class="robot-progress">
        <view class="progress-track">
          <view class="progress-bar" style="width: {{progressPercent}}%;"></view>
        </view>
        <view class="progress-labels">
          <text class="{{progressStep >= 1 ? 'on' : ''}}">已接单</text>
          <text class="{{progressStep >= 2 ? 'on' : ''}}">取餐</text>
          <text class="{{progressStep >= 3 ? 'on' : ''}}">配送</text>
          <text class="{{progressStep >= 4 ? 'on' : ''}}">送达</text>
        </view>
      </view>
    </view>

    <!-- 自绘地图：可双指缩放/平移，显示全部点位 + 配送路线 + 机器人实时位置（平台为 SLAM 坐标，无经纬度，故不用微信 map 组件） -->
    <view class="map-card" wx:if="{{map && map.landmarks}}">
      <view class="map-canvas"
        style="transform: scale({{mapScale}}) translate({{mapOffsetX}}px, {{mapOffsetY}}px);"
        catchtouchstart="onMapTouchStart"
        catchtouchmove="onMapTouchMove"
        catchtouchend="onMapTouchEnd"
        catchtouchcancel="onMapTouchEnd">
        <!-- 网格底图 -->
        <view class="map-grid"></view>
        <!-- 路线折线：相邻停靠点连线（hidden 在 wx:for 内求值，index 可用；wx:if 会先于 for 求值导致 index 不可用） -->
        <view wx:for="{{map.route}}" wx:key="index" hidden="{{index === 0}}"
          class="map-route-seg" style="left: {{map.route[index-1].x}}%; top: {{map.route[index-1].y}}%; width: {{routeSegLen(map.route[index-1], item)}}%; transform: rotate({{routeSegDeg(map.route[index-1], item)}}deg);">
        </view>
        <!-- 全部点位 -->
        <view wx:for="{{map.landmarks}}" wx:key="id"
          class="map-landmark {{item.type === 'loadingPoint' ? 'is-loading' : ''}}"
          style="left: {{item.x}}%; top: {{item.y}}%;">
          <view class="map-landmark-dot"></view>
          <view class="map-landmark-name">{{item.name}}</view>
        </view>
        <!-- 目的地高亮（本单送达点） -->
        <view class="map-dest" wx:if="{{percent}}" style="left: {{posX}}%; top: {{posY}}%; opacity: 0;"></view>
        <!-- 机器人实时位置 -->
        <view class="map-robot" wx:if="{{percent}}" style="left: {{posX}}%; top: {{posY}}%;">
          <view class="map-robot-dot"><t-icon name="robot-1" size="14" color="#ffffff" /></view>
        </view>
      </view>
      <!-- 缩放控制条 -->
      <view class="map-zoombar" catchtap="noop">
        <view class="map-zoom-btn" catchtap="onZoomIn">＋</view>
        <view class="map-zoom-btn" catchtap="onZoomOut">－</view>
        <view class="map-zoom-btn" catchtap="onMapReset">复位</view>
      </view>
      <view class="map-tip">
        <text class="text-sm">{{order.landmark_name}} · 双指缩放查看</text>
      </view>
    </view>

    <view class="card" wx:elif="{{position && position.text}}">
      <view class="section-title">机器人位置</view>
      <view class="task-status text-sub">{{position.text}}</view>
      <view class="text-weak text-sm">当前为演示模式，暂不显示实时地图位置</view>
    </view>

    <!-- P1-4：配送异常(6) —— 机器人故障/长时间无进展时，给用户明确的异常说明与退款/投诉出口 -->
    <view class="card exception-card" wx:if="{{order.order_status === 6}}">
      <view class="section-title">配送异常</view>
      <view class="task-status text-warn">{{taskText}}</view>
      <view class="text-weak text-sm">您的订单配送出现异常，请申请退款或联系商家处理；您的餐款会按售后结果退回。</view>
    </view>

    <view class="card" wx:if="{{task}}">
      <view class="section-title">配送进度</view>
      <view class="task-status text-sub">{{task.status_text}}</view>
    </view>

    <!-- 一车多单：同车信息（一个仓多个人拿，展示本车共几单/已取几单） -->
    <view class="card" wx:if="{{batch && batch.multi_order}}">
      <view class="section-title">本车配送批次 {{batch.batch_no}}</view>
      <view class="info-row text-sub"><text>本车订单</text><text>共 {{batch.total_orders}} 单（满仓最多 12 单）</text></view>
      <view class="info-row text-sub"><text>已取餐</text><text>{{batch.picked_orders}} / {{batch.total_orders}} 单</text></view>
      <view class="text-weak text-sm">您的餐品已放入舱内，请凭本单取餐码取走自己的餐品；其他用户取走后本车才算配送完成。</view>
    </view>

    <view class="card">
      <view class="section-title">取餐凭证</view>
      <view class="pickup-code">{{order.pickup_code}}</view>
      <view class="text-weak text-sm">机器人到达后，扫车身二维码并输入此取餐码开舱取餐（每单取餐码独立，请勿使用他人取餐码）</view>
    </view>

    <view class="foot-actions">
      <view class="btn btn-sm btn-outline" style="flex:1;" bindtap="refresh">刷新状态</view>
      <view class="btn btn-sm" style="flex:1;" wx:if="{{order.order_status === 3}}" bindtap="goScanPickup">扫码取餐</view>
      <view class="btn btn-sm btn-warn" style="flex:1;" wx:if="{{order.order_status === 6}}" bindtap="goRefund">申请退款</view>
    </view>
  </block>
</view>
