.pickup-page {
  padding: 24rpx 32rpx 60rpx;
}

.pickup-head {
  padding: 24rpx 8rpx 32rpx;
}

.pickup-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

.pickup-status {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.pickup-code {
  font-size: 34rpx;
  font-weight: 700;
  color: #3078C0;
  letter-spacing: 4rpx;
}

.bin-card {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.bin-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #E8EDF7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.bin-circle.on {
  background: #E3F5EC;
}

.bin-circle-text {
  font-size: 80rpx;
  font-weight: 700;
  color: #3078C0;
}

.bin-circle.on .bin-circle-text {
  color: #2BA471;
}

.bin-state {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.bin-countdown {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #E5484D;
}

.bin-tip {
  margin-top: 12rpx;
  text-align: center;
}

.foot-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

/* 一车多单诚实化提示（P1-1 缓解） */
.batch-order-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.batch-order-row:last-child {
  border-bottom: none;
}
.batch-order-no {
  font-size: 26rpx;
  color: #111111;
}
.batch-order-no.mine {
  color: #3078C0;
  font-weight: 600;
}
.batch-order-lm {
  flex: 1;
}
.batch-order-tag {
  font-size: 20rpx;
  color: #ffffff;
  background: #3078C0;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}
