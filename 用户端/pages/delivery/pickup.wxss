.pickup-page {
  padding: 24rpx 32rpx 60rpx;
}

.pickup-head {
  padding: 24rpx 8rpx 32rpx;
}

.pickup-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}

.pickup-status {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.pickup-code {
  font-size: 34rpx;
  font-weight: 700;
  color: #3078C0;
  letter-spacing: 4rpx;
}

.bin-card {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.bin-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #E8EDF7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.bin-circle.on {
  background: #E3F5EC;
}

.bin-circle-text {
  font-size: 80rpx;
  font-weight: 700;
  color: #3078C0;
}

.bin-circle.on .bin-circle-text {
  color: #2BA471;
}

.bin-state {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.bin-countdown {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #E5484D;
}

.bin-tip {
  margin-top: 12rpx;
  text-align: center;
}

.foot-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}
