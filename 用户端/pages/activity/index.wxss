/* 以白为主、蓝只在顶部起手：30% 处收到纯白 */
.activity-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF4FF 0%, #FFFFFF 30%);
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

/* 头栏：顶部极浅蓝 → 向下渐隐到透明 */
.act-head {
  padding: 48rpx 40rpx 120rpx;
  background: linear-gradient(180deg, #DCEBFA 0%, rgba(255, 255, 255, 0) 100%);
}

.act-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #3078C0;
  letter-spacing: 2rpx;
}

.act-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.act-body {
  margin-top: -90rpx;
  padding: 0 32rpx 40rpx;
}

/* 一个活动 = 一张图片。没有白底、没有描边、没有系统文案：
   商家把折扣/时间/商品都设计进海报里了，外面再包一层卡片会和海报本身的设计打架。
   图片用小圆角收边，保证和整页的圆角语言一致。 */
.act-card {
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #F1F5FA;
}

.act-poster-full {
  width: 100%;
  display: block;
}
