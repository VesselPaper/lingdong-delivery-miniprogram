.activity-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

.act-head {
  padding: 48rpx 40rpx 200rpx;
  background: linear-gradient(180deg, #9CCDF2 0%, #6FB2E7 40%, #EAF2FA 100%);
}

.act-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #3078C0;
  letter-spacing: 2rpx;
}

.act-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.act-body {
  margin-top: -160rpx;
  padding: 0 32rpx 40rpx;
}

.act-card {
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.act-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.act-card-sub {
  margin-top: 10rpx;
}

.act-btn {
  margin-top: 24rpx;
}
