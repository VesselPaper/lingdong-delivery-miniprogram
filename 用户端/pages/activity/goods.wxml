<view class="agoods">
  <!-- 活动头：标题 + 优惠摘要（独立落地页的活动信息） -->
  <view class="agoods-head" wx:if="{{activityTitle}}">
    <view class="agoods-title">{{activityTitle}}</view>
    <view class="agoods-promo" wx:if="{{promo}}">{{promo}}</view>
  </view>

  <view class="agoods-list" wx:if="{{goods.length}}">
    <!-- 商品卡片：与商城同款（p-item），点击进详情、右侧步进器加购 -->
    <view class="p-item" wx:for="{{goods}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="p-img" style="background: {{item.theme}};">
        <image wx:if="{{item.image}}" class="fill-img" src="{{item.image}}" mode="aspectFill" lazy-load />
        <t-icon wx:else name="{{item.icon}}" size="26" color="#BFBFBF" />
      </view>
      <view class="p-info">
        <view class="p-name-row">
          <view class="p-name">{{item.name}}</view>
          <text class="p-soldout" wx:if="{{item.sold_out}}">售罄</text>
        </view>
        <view class="p-stats">
          <text class="p-sales">{{item.sales_text}}</text>
        </view>
        <view class="p-bottom">
          <view class="p-price">
            <text class="p-price-now">¥{{item.has_promo ? item.sale_price : item.price}}</text>
            <text class="p-old" wx:if="{{item.has_promo}}">¥{{item.price}}</text>
          </view>
          <block wx:if="{{item.sold_out}}">
            <view wx:if="{{item.qty > 0}}" class="stepper">
              <view class="stepper-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="-1">-</view>
              <view class="stepper-num">{{item.qty}}</view>
              <view class="stepper-btn plus disabled" catchtap="onStep" data-id="{{item.id}}" data-delta="1">+</view>
            </view>
            <view wx:else class="add-btn disabled" catchtap="onStep" data-id="{{item.id}}" data-delta="1">
              <t-icon name="add" size="14" color="#999999" />
            </view>
          </block>
          <block wx:else>
            <view wx:if="{{item.qty > 0}}" class="stepper">
              <view class="stepper-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="-1" hover-class="add-btn-hover" hover-stay-time="80">-</view>
              <view class="stepper-num">{{item.qty}}</view>
              <view class="stepper-btn plus" catchtap="onStep" data-id="{{item.id}}" data-delta="1" hover-class="add-btn-hover" hover-stay-time="80">+</view>
            </view>
            <view wx:else class="add-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="1" hover-class="add-btn-hover" hover-stay-time="80">
              <t-icon name="add" size="14" color="#ffffff" />
            </view>
          </block>
        </view>
        <view class="p-promo" wx:if="{{item.has_promo}}">
          <text class="p-promo-tag">{{item.discount_label}}</text>
          <text class="p-promo-save">已省 ¥{{item.save_amount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="agoods-empty">
    <view class="agoods-empty-icon"><t-icon name="app" size="40" color="#D8D8D8" /></view>
    <view class="agoods-empty-text">该活动暂无在售商品</view>
  </view>

  <view wx:if="{{loading}}" class="agoods-loading">加载中…</view>
</view>
