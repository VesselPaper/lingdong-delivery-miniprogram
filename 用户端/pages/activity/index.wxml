<view class="activity-page">
  <view class="act-head">
    <view class="act-title">超值权益</view>
    <view class="act-sub">每日省钱 超值权益</view>
  </view>

  <view class="act-body">
    <!-- 用户端只展示活动图片本身：商家在设计好的海报里已经写清了活动信息（折扣、时间、商品），
         再渲染一套系统文案等于重复表达，还会跟海报风格打架。
         没配图的活动在这里不展示（它在用户端的表现形态就是那张图）。 -->
    <block wx:if="{{activities.length}}">
      <view class="act-card" wx:for="{{activities}}" wx:key="id" bindtap="onActivity" data-index="{{index}}">
        <image class="act-poster-full" src="{{item.image}}" mode="widthFix" lazy-load />
      </view>
    </block>
    <view wx:else class="empty">
      <view class="empty-icon"><t-icon name="activity" size="40" color="#D8D8D8" /></view>
      <view class="empty-text">暂无进行中的活动</view>
    </view>
  </view>
</view>
