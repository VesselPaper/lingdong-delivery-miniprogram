.home {
  min-height: 100vh;
  padding-bottom: 340rpx;
}

/* 首页是 tab 页，结算栏需抬高到 tabBar 之上 */
.home .cart-bar {
  bottom: calc(178rpx + env(safe-area-inset-bottom));
}

.home-top {
  background: transparent;
  padding: 24rpx 32rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.brand-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 63, 122, 0.06);
}

.search-text {
  font-size: 26rpx;
  color: #99A3B0;
}

/* 米色福利卡 */
.coupon-card {
  margin: 8rpx 32rpx 24rpx;
  background: #F8ECD6;
  border: 1rpx solid #E8D5AC;
  border-radius: 24rpx;
  overflow: hidden;
}

.coupon-head {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 20rpx;
}

.coupon-mascot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F3E2C0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.coupon-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #6B4E1F;
}

.coupon-count {
  font-size: 24rpx;
  color: #A98A4F;
  border: 1rpx solid #D9BE8B;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}

.coupon-notice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FBF2E1;
  border-top: 1rpx solid #F0E0BE;
  padding: 20rpx 28rpx;
}

.coupon-notice-tag {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B4E1F;
  flex-shrink: 0;
}

.coupon-notice-text {
  flex: 1;
  font-size: 24rpx;
  color: #8A7045;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 商品横滑区 */
.section {
  padding: 8rpx 0 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.section-head .section-title {
  margin: 8rpx 0 16rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #2E7CF6;
  margin-bottom: 16rpx;
}

.goods-scroll {
  white-space: nowrap;
}

.goods-row {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 32rpx 24rpx;
}

.goods-card {
  width: 264rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(31, 63, 122, 0.06);
  display: inline-block;
  vertical-align: top;
}

.goods-img {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin: 12rpx 16rpx 0;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 16rpx 16rpx;
}

.goods-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.goods-price-now {
  color: #FA4A2D;
  font-size: 30rpx;
  font-weight: 700;
}

.goods-old {
  color: #B0B8C4;
  font-size: 20rpx;
  text-decoration: line-through;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #2E7CF6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 底部浮动结算栏 */
.go-cart {
  height: 76rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: #2E7CF6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}
