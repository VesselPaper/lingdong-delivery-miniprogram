@import "cat-icons.wxss";

.home {
  min-height: 100vh;
  /* 底部留白：盖过悬浮购物车栏（116rpx 起，高 120rpx）+ 通栏 tabBar，并跟随安全区 */
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* 分组标题里的小号插画图标 */
.cat-ic-sm {
  width: 38rpx;
  height: 38rpx;
}

/* 首页是 tab 页，结算栏紧贴通栏 tabBar 上沿（tabBar 高 100rpx + 16rpx 间隙） */
.home .cart-bar {
  bottom: calc(116rpx + env(safe-area-inset-bottom));
}

.home-top {
  background: transparent;
  padding: 24rpx 32rpx;
  position: relative;
  z-index: 10;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.brand-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

/* 未选择楼栋：弱化显示并提示未填写，避免被误读成已定位到校区 */
.brand-name.unset {
  font-weight: 400;
  color: #999999;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 8rpx;
  padding: 18rpx 28rpx;
}

.search-text {
  font-size: 26rpx;
  color: #999999;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #111111;
}

.search-clear {
  padding: 4rpx;
  flex-shrink: 0;
}

.search-focus {
  border-color: var(--brand);
  background: #ffffff;
}

/* 点空白处收起历史面板（透明遮罩，不挡视觉） */
.history-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9;
  background: transparent;
}

.search-empty {
  padding: 48rpx 0 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

/* 历史搜索 */
.history {
  margin-top: 20rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-title {
  font-size: 24rpx;
  color: #999999;
}

.history-clear {
  padding: 4rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  max-width: 320rpx;
  padding: 8rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #555555;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 分类按钮排：可横向滑动，避免分类多时挤压 */
.cat-bar {
  display: flex;
  align-items: center;
  margin: 8rpx 0 24rpx;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  margin-left: 32rpx;
  margin-right: 32rpx;
  white-space: nowrap;
  overflow-x: auto;
}

.cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 140rpx;
  flex-shrink: 0;
}

.cat-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-name {
  font-size: 24rpx;
  color: #333333;
}

/* 分组标题：图标 + 文字 */
.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

/* 首页活动位（商家发布的纯展示活动）：左右边距与顶部搜索区对齐。
   高度完全由图片决定（image 用 widthFix），所以不同尺寸的海报都完整显示、不被裁剪。 */
.banner-list {
  margin: 0 32rpx 24rpx;
}

.banner-img {
  width: 100%;
  display: block;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  background: #EAF2FC;
}

.banner-img:last-child {
  margin-bottom: 0;
}

/* ===== 领券弹窗 ===== */
/* 居中弹窗 + 遮罩：券不再占首页图片位，改成进页面弹一次 */
.cp-pop-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  /* 高于购物车弹层(300)与楼栋选择(100)：进页面时弹窗必须是最上层 */
  z-index: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  box-sizing: border-box;
}

.cp-pop {
  position: relative;
  width: 100%;
  max-height: 76vh;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  /* × 要露在卡片圆角之外，所以这里不能裁 */
  overflow: visible;
}

/* 券列表：高度由 JS 按内容算好写在内联 style 上（scroll-view 必须有确定高度才会滚动，
   只写 max-height 是不滚的）。这里只管内边距 */
.cp-pop-body {
  flex: 0 0 auto;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.cp-pop-item {
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #FDEEEE;
}

.cp-pop-item:last-child {
  margin-bottom: 0;
}

/* 按原图比例完整展示：图里就是商家设计好的优惠信息，弹窗里更不能裁 */
.cp-pop-img {
  width: 100%;
  display: block;
}

.cp-pop-item-btn {
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #E64340;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 底部：暂不领取 / 立即领取（一次全领） */
.cp-pop-foot {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  flex: 0 0 auto;
  border-top: 1rpx solid #F0F0F0;
}

.cp-pop-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 2rpx solid #E0E0E0;
  color: #666666;
  font-size: 28rpx;
  box-sizing: border-box;
}

.cp-pop-all {
  flex: 1.4;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #E64340;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 右上角关闭：贴在卡片角上，只压住很小一块，尽量不挡券图内容 */
.cp-pop-close {
  position: absolute;
  right: -14rpx;
  top: -14rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 米色福利卡 */
.coupon-card {
  margin: 8rpx 32rpx 24rpx;
  background: #F8ECD6;
  border: 1rpx solid #E8D5AC;
  border-radius: 12rpx;
  overflow: hidden;
}

.coupon-head {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 20rpx;
}

.coupon-mascot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F3E2C0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.coupon-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #6B4E1F;
}

.coupon-count {
  font-size: 24rpx;
  color: #A98A4F;
  border: 1rpx solid #D9BE8B;
  border-radius: 8rpx;
  padding: 4rpx 20rpx;
}

.coupon-notice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FBF2E1;
  border-top: 1rpx solid #F0E0BE;
  padding: 20rpx 28rpx;
}

.coupon-notice-tag {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B4E1F;
  flex-shrink: 0;
}

.coupon-notice-text {
  flex: 1;
  font-size: 24rpx;
  color: #8A7045;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 商品横滑区 */
.section {
  padding: 8rpx 0 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.section-head .section-title {
  margin: 8rpx 0 16rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--brand);
  margin-bottom: 16rpx;
}

.goods-scroll {
  white-space: nowrap;
}

/* 热门商品网格：每行 2 个，按分类成排 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 32rpx 8rpx;
}

.goods-card {
  width: calc((100% - 20rpx) / 2);
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.goods-img {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #111111;
  margin: 12rpx 16rpx 0;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 16rpx 16rpx;
}

.goods-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.goods-price-now {
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 700;
}

.goods-old {
  color: #999999;
  font-size: 20rpx;
  text-decoration: line-through;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 120ms ease;
}

/* 底部浮动结算栏 */
.go-cart {
  height: 76rpx;
  padding: 0 40rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* 点位选择弹层 */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.picker-close {
  padding: 4rpx;
}

.picker-list {
  max-height: 46vh;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 32rpx;
  border-top: 1rpx solid #F5F5F5;
}

.picker-item.on {
  background: #F5F9FF;
}

.picker-item-name {
  font-size: 28rpx;
  color: #333333;
}

.picker-item-body {
  flex: 1;
  overflow: hidden;
}

.picker-item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-item.on .picker-item-name {
  color: #3078C0;
  font-weight: 600;
}

.picker-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

.picker-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 32rpx 0;
}

.picker-reset {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #3078C0;
  background: #F5F9FF;
  border-radius: 12rpx;
}

.picker-list .picker-item {
  align-items: flex-start;
}

.picker-list .picker-item > t-icon:first-child {
  margin-top: 4rpx;
}
