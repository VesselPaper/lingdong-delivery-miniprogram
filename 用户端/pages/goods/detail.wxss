.detail-page {
  padding-bottom: 220rpx;
  background: #FAFAFA;
  min-height: 100vh;
}

.hero {
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.hero-pic {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-badge {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
}

.info {
  margin: -40rpx 24rpx 0;
  position: relative;
  border-radius: 12rpx;
}

.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-left {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #111111;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.soldout-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ffffff;
  background: #E64340;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.stock-line {
  margin-top: 10rpx;
}

/* 售罄置灰：加号与去结算 */
.stepper-btn.plus.disabled,
.go-cart.disabled {
  background: #E3E7EE;
  border-color: #E3E7EE;
  color: #999999;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 16rpx;
}

.price-now {
  color: var(--brand);
  font-size: 40rpx;
  font-weight: 700;
}

.price-old {
  color: #999999;
  font-size: 26rpx;
  text-decoration: line-through;
}

.price-tag {
  color: #E64340;
  font-size: 20rpx;
  font-weight: 600;
  border: 1rpx solid #E64340;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.price-now {
  color: #E64340;
}

.notice-lines {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666666;
}

.nl-label {
  color: #111111;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.disclaimer .disclaimer-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.7;
}

.bottom-bar .bar-price {
  min-width: 120rpx;
}

.bar-price-main {
  color: var(--brand);
  font-size: 38rpx;
  font-weight: 700;
}

.bar-price-old {
  color: #999999;
  font-size: 22rpx;
  text-decoration: line-through;
}

.bar-fee {
  flex: 1;
  margin-left: 16rpx;
  font-size: 22rpx;
}

.go-cart {
  height: 76rpx;
  padding: 0 48rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}
