/* 商品页整页不滚动：搜索框/店铺名钉在顶部，只有左分类栏、右商品栏各自内部滚动 */
page {
  height: 100vh;
  overflow: hidden;
}

.glist {
  height: 100vh;
  background: #F6F8FB;
  overflow: hidden;
}

.search-area {
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.search-box {
  display: flex;
  align-items: center;
  background: #F5F7FA;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

/* 店铺卡 */
.store-card {
  margin: 20rpx 24rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 63, 122, 0.05);
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.store-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #EAF3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.store-info {
  flex: 1;
  min-width: 0;
}

.store-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.store-sub {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
}

.store-free {
  color: #F7942E;
}

.store-hours {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #99A3B0;
}

/* 左分类 + 右商品 */
.body {
  display: flex;
  height: calc(100vh - 420rpx);
  min-height: 600rpx;
  overflow: hidden;
}

/* scroll-view 是原生组件，在 flex 里不会可靠收缩、会按自身内容撑宽，
   导致右列商品卡片向右溢出屏幕、右侧的加号按钮被切掉。
   用普通 view 包一层做宽度约束，再让 scroll-view 填满它 */
.side-wrap {
  width: 176rpx;
  flex-shrink: 0;
  height: 100%;
  overflow: hidden;
}

.side {
  width: 100%;
  height: 100%;
}

.side-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  border-radius: 16rpx;
}

.side-item.on {
  background: #EAF3FF;
  color: #2E7CF6;
  font-weight: 600;
}

.main-wrap {
  flex: 1;
  min-width: 0;
  height: 100%;
  overflow: hidden;
}

.main {
  width: 100%;
  height: 100%;
}

/* padding 放在内层容器上：scroll-view 自身带 padding 时，
   内层内容宽度不会减去 padding，卡片会向右溢出屏幕 */
.main-inner {
  padding: 0 24rpx;
  /* 底部滚动余量：购物车栏是悬浮在列表之上的覆盖层，
     给最后一件商品留出可滚到栏上方的空间（无栏时不产生固定空白） */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.group-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.group-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #99A3B0;
}

.p-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 63, 122, 0.05);
}

.p-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.p-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.p-name {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 名称独占一行，价格与 -/+ 放底部一行，互不挤压 */
.p-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.p-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.p-price-now {
  color: #FA4A2D;
  font-size: 30rpx;
  font-weight: 700;
}

.p-old {
  color: #B0B8C4;
  font-size: 20rpx;
  text-decoration: line-through;
}

/* 紧凑步进器（比全局小一号，- 白底蓝描边 / + 蓝底白字） */
.stepper-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1rpx solid var(--brand);
  color: var(--brand);
  font-size: 26rpx;
  line-height: 1;
  border-radius: 50%;
  box-sizing: border-box;
}

.stepper-btn.plus {
  background: var(--brand);
  color: #ffffff;
  border-color: var(--brand);
}

.stepper-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.add-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #2E7CF6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.go-cart {
  height: 76rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: #2E7CF6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* 商城是 tab 页，底部有自定义 tabBar，购物车栏需抬高到 tabBar 之上（与首页一致） */
.glist .cart-bar {
  bottom: calc(178rpx + env(safe-area-inset-bottom));
}
