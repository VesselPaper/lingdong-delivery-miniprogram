/* 商品页整页不滚动：搜索框/店铺名钉在顶部，只有左分类栏、右商品栏各自内部滚动 */
page {
  height: 100vh;
  overflow: hidden;
}

.glist {
  height: 100vh;
  background: #FAFAFA;
  overflow: hidden;
}

.search-area {
  padding: 16rpx 24rpx;
  background: #ffffff;
  position: relative;
  z-index: 10;   /* 历史遮罩之上，保证搜索框始终可点 */
}

.search-box {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 16rpx 28rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #111111;
}

/* 历史搜索（与首页共用样式） */
.history-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9;
  background: transparent;
}

.history {
  position: relative;
  z-index: 10;
  margin: 8rpx 24rpx 0;
  padding: 16rpx 8rpx;
  background: #FAFAFA;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-title {
  font-size: 24rpx;
  color: #999999;
}

.history-clear {
  padding: 4rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  max-width: 320rpx;
  padding: 8rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #555555;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 无搜索结果时的分类建议词 */
.empty-sugs {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.empty-sug-tag {
  padding: 8rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #D8D8D8;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #3078C0;
}

/* 店铺卡 */
.store-card {
  margin: 20rpx 24rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.store-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #DCE9F8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.store-info {
  flex: 1;
  min-width: 0;
}

.store-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.store-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #111111;
}

.store-sub {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
}

.store-fee {
  color: #E64340;
}

.store-hours {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 左分类 + 右商品 */
.body {
  display: flex;
  height: calc(100vh - 420rpx);
  min-height: 600rpx;
  overflow: hidden;
}

/* scroll-view 是原生组件，在 flex 里不会可靠收缩、会按自身内容撑宽，
   导致右列商品卡片向右溢出屏幕、右侧的加号按钮被切掉。
   用普通 view 包一层做宽度约束，再让 scroll-view 填满它 */
.side-wrap {
  width: 176rpx;
  flex-shrink: 0;
  height: 100%;
  overflow: hidden;
  background: #F0F2F6;
}

.side {
  width: 100%;
  height: 100%;
}

.side-item {
  position: relative;
  margin: 4rpx 12rpx;
  padding: 24rpx 8rpx;
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  border-radius: 12rpx;
}

/* 选中态：白色药丸 + 蓝色左侧指示条 + 加粗 */
.side-item.on {
  background: #ffffff;
  color: var(--brand);
  font-weight: 600;
  border: 1rpx solid #EBEBEB;
}

.side-item.on::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  border-radius: 3rpx;
  background: var(--brand);
}

.main-wrap {
  flex: 1;
  min-width: 0;
  height: 100%;
  overflow: hidden;
}

.main {
  width: 100%;
  height: 100%;
}

/* padding 放在内层容器上：scroll-view 自身带 padding 时，
   内层内容宽度不会减去 padding，卡片会向右溢出屏幕 */
.main-inner {
  padding: 0 24rpx;
  /* 底部滚动余量：购物车栏是悬浮在列表之上的覆盖层，
     给最后一件商品留出可滚到栏上方的空间（无栏时不产生固定空白） */
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.group-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.group-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #999999;
}

.p-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.p-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.p-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.p-name {
  font-size: 28rpx;
  color: #111111;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 名称 + 售罄标记同行 */
.p-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.p-name-row .p-name {
  flex: 1;
  min-width: 0;
}

.p-soldout {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #ffffff;
  background: #E64340;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

/* 售罄置灰：加号/加购按钮灰色 */
.stepper-btn.plus.disabled,
.add-btn.disabled {
  background: #E3E7EE;
  border-color: #E3E7EE;
  color: #999999;
}

/* 名称独占一行，价格与 -/+ 放底部一行，互不挤压 */
.p-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.p-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.p-price-now {
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 700;
}

.p-old {
  color: #999999;
  font-size: 20rpx;
  text-decoration: line-through;
}

/* 库存 + 销量：名称下方一行弱化信息，下单前可判断是否抢手 */
.p-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999999;
}

.p-stock {
  color: #5C9E6E;
}

.p-stock.out {
  color: #E64340;
}

.p-sales {
  color: #999999;
}

/* 活动标签：折扣力度（如「8.5折」）+ 省下金额，替代原来单个红色「折」字 */
.p-promo {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.p-promo-tag {
  font-size: 18rpx;
  color: #ffffff;
  background: #E64340;
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
}

.p-promo-save {
  font-size: 20rpx;
  color: #E64340;
}

/* 紧凑步进器（比全局小一号，- 白底蓝描边 / + 蓝底白字，圆形） */
.stepper-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1rpx solid var(--brand);
  border-radius: 50%;
  color: var(--brand);
  font-size: 26rpx;
  line-height: 1;
  box-sizing: border-box;
  transition: transform 120ms ease;
}

.stepper-btn.plus {
  background: var(--brand);
  color: #ffffff;
  border-color: var(--brand);
}

.stepper-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
}

.add-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 120ms ease;
}

.go-cart {
  height: 76rpx;
  padding: 0 40rpx;
  border-radius: 8rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* 商城是 tab 页，购物车栏紧贴通栏 tabBar 上沿（与首页同高） */
.glist .cart-bar {
  bottom: calc(116rpx + env(safe-area-inset-bottom));
}
