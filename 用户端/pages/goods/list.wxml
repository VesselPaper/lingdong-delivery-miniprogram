<view class="glist">
  <view class="search-area">
    <view class="search-box">
      <t-icon name="search" size="16" color="#999999" />
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="请输入商品名"
        placeholder-class="field-placeholder"
        confirm-type="search"
        bind:input="onSearch"
        bind:confirm="onSearchConfirm"
        focus="{{focus}}"
      />
    </view>
  </view>

  <view class="store-card">
    <view class="store-icon">
      <t-icon name="shop" size="20" color="#3078C0" />
    </view>
    <view class="store-info">
      <view class="store-name-row">
        <view class="store-name">零栋铺子</view>
        <view class="tag tag-orange" wx:if="{{shopClosed}}">歇业</view>
      </view>
      <view class="store-sub">
        <text>起送 ¥0</text>
        <text class="store-fee">配送费 ¥{{deliveryFee}}</text>
      </view>
      <view class="store-hours">
        <t-icon name="time" size="12" color="#999999" />
        <text>08:00-20:00</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="side-wrap">
      <scroll-view scroll-y class="side" enhanced show-scrollbar="{{false}}">
        <view
          class="side-item {{activeCategory === item.name ? 'on' : ''}}"
          wx:for="{{groups}}"
          wx:key="name"
          bindtap="onCategoryClick"
          data-index="{{index}}"
        >{{item.name}}</view>
      </scroll-view>
    </view>
    <view class="main-wrap">
      <scroll-view
        id="main-scroll"
        scroll-y
        class="main"
        enhanced
        show-scrollbar="{{false}}"
        scroll-into-view="{{mainTo}}"
        bindscroll="onScroll"
      >
        <view class="main-inner">
          <view wx:if="{{!groups.length}}" class="empty">
            <view class="empty-icon"><t-icon name="app" size="40" color="#D8D8D8" /></view>
            <view class="empty-text">没有找到相关商品</view>
          </view>
          <block wx:for="{{groups}}" wx:key="name" wx:for-index="gi">
            <view id="group-{{gi}}" class="group">
              <view class="group-title">
                <text>{{item.name}}</text>
                <text class="group-count">{{item.items.length}} 种</text>
              </view>
              <view
                class="p-item"
                wx:for="{{item.items}}"
                wx:key="id"
                bindtap="goDetail"
                data-id="{{item.id}}"
              >
                <view class="p-img" style="background: {{item.theme}};">
                  <image wx:if="{{item.image}}" class="fill-img" src="{{item.image}}" mode="aspectFill" lazy-load bindload="onImageLoad" />
                  <t-icon wx:else name="{{item.icon}}" size="26" color="#BFBFBF" />
                </view>
                <view class="p-info">
                  <view class="p-name-row">
                    <view class="p-name">{{item.name}}</view>
                    <text class="p-soldout" wx:if="{{item.sold_out}}">售罄</text>
                  </view>
                  <!-- 库存与销量：让用户下单前就知道还剩多少、卖得怎么样 -->
                  <view class="p-stats">
                    <text class="p-stock {{item.sold_out ? 'out' : ''}}">{{item.stock_text}}</text>
                    <text class="p-sales">{{item.sales_text}}</text>
                  </view>
                  <view class="p-bottom">
                    <view class="p-price">
                      <text class="p-price-now">¥{{item.has_promo ? item.sale_price : item.price}}</text>
                      <text class="p-old" wx:if="{{item.has_promo}}">¥{{item.price}}</text>
                    </view>
                    <block wx:if="{{item.sold_out}}">
                      <view wx:if="{{item.qty > 0}}" class="stepper">
                        <view class="stepper-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="-1">-</view>
                        <view class="stepper-num">{{item.qty}}</view>
                        <view class="stepper-btn plus disabled" catchtap="onStep" data-id="{{item.id}}" data-delta="1">+</view>
                      </view>
                      <view wx:else class="add-btn disabled" catchtap="onStep" data-id="{{item.id}}" data-delta="1">
                        <t-icon name="add" size="14" color="#999999" />
                      </view>
                    </block>
                    <block wx:else>
                      <view wx:if="{{item.qty > 0}}" class="stepper">
                        <view class="stepper-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="-1" hover-class="add-btn-hover" hover-stay-time="80">-</view>
                        <view class="stepper-num">{{item.qty}}</view>
                        <view class="stepper-btn plus" catchtap="onStep" data-id="{{item.id}}" data-delta="1" hover-class="add-btn-hover" hover-stay-time="80">+</view>
                      </view>
                      <view wx:else class="add-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="1" hover-class="add-btn-hover" hover-stay-time="80">
                        <t-icon name="add" size="14" color="#ffffff" />
                      </view>
                    </block>
                  </view>
                  <!-- 活动展示：折扣力度与省下金额分开成标签，比单独一个红色「折」字更直观 -->
                  <view class="p-promo" wx:if="{{item.has_promo}}">
                    <text class="p-promo-tag">{{item.discount_label}}</text>
                    <text class="p-promo-save">已省 ¥{{item.save_amount}}</text>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="cart-bar" wx:if="{{cartCount}}" bindtap="goCart">
    <view class="cart-bar-icon {{cartBounceCls}}" id="cart-bar-icon">
      <t-icon name="robot-1" size="24" color="#3078C0" />
      <view class="cart-bar-badge {{cartBadgeCls}}">{{cartCount}}</view>
    </view>
    <view class="cart-bar-info">
      <view class="cart-bar-price">¥{{cartTotal}}</view>
      <view class="cart-bar-fee">配送费 ¥{{deliveryFee}} · 明细</view>
    </view>
    <view class="go-cart">去结算</view>
  </view>

  <!-- 加购飞入的小球（与首页同一套样式和时长，见 app.wxss / utils/flyCart.js） -->
  <view class="fly-layer" wx:if="{{flyBall.show}}">
    <view class="fly-x" style="left:{{flyBall.x}}px; top:{{flyBall.y}}px; transform: translateX({{flyBall.move ? flyBall.dx : 0}}px);">
      <view class="fly-y" style="transform: translateY({{flyBall.move ? flyBall.dy : 0}}px);">
        <view class="fly-ball"></view>
      </view>
    </view>
  </view>
</view>
