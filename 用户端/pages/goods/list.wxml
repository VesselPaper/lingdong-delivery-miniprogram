<view class="glist">
  <view class="search-area">
    <view class="search-box">
      <t-icon name="search" size="16" color="#99A3B0" />
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="请输入商品名"
        placeholder-class="field-placeholder"
        confirm-type="search"
        bind:input="onSearch"
        bind:confirm="onSearchConfirm"
        focus="{{focus}}"
      />
    </view>
  </view>

  <view class="store-card">
    <view class="store-icon">
      <t-icon name="shop" size="20" color="#2E7CF6" />
    </view>
    <view class="store-info">
      <view class="store-name">零栋铺子</view>
      <view class="store-sub">
        <text>起送 ¥0</text>
        <text class="store-free">免配送费</text>
      </view>
      <view class="store-hours">
        <t-icon name="time" size="12" color="#99A3B0" />
        <text>11:00-13:00 / 17:00-19:00</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="side-wrap">
      <scroll-view scroll-y class="side" enhanced show-scrollbar="{{false}}">
        <view
          class="side-item {{activeCategory === item ? 'on' : ''}}"
          wx:for="{{groups}}"
          wx:key="name"
          bindtap="onCategoryClick"
          data-index="{{index}}"
        >{{item.name}}</view>
      </scroll-view>
    </view>
    <view class="main-wrap">
      <scroll-view
        id="main-scroll"
        scroll-y
        class="main"
        enhanced
        show-scrollbar="{{false}}"
        scroll-into-view="{{mainTo}}"
        scroll-with-animation
        bindscroll="onScroll"
      >
        <view class="main-inner">
          <view wx:if="{{!groups.length}}" class="empty">
            <view class="empty-icon"><t-icon name="app" size="40" color="#C9D2DE" /></view>
            <view class="empty-text">没有找到相关商品</view>
          </view>
          <block wx:for="{{groups}}" wx:key="name" wx:for-index="gi">
            <view id="group-{{gi}}" class="group">
              <view class="group-title">
                <text>{{item.name}}</text>
                <text class="group-count">{{item.items.length}} 种</text>
              </view>
              <view
                class="p-item"
                wx:for="{{item.items}}"
                wx:key="id"
                bindtap="goDetail"
                data-id="{{item.id}}"
              >
                <view class="p-img" style="background: {{item.theme}};">
                  <image wx:if="{{item.image}}" class="fill-img" src="{{item.image}}" mode="aspectFill" />
                  <t-icon wx:else name="{{item.icon}}" size="26" color="#BFBFBF" />
                </view>
                <view class="p-info">
                  <view class="p-name">{{item.name}}</view>
                  <view class="p-bottom">
                    <view class="p-price">
                      <text class="p-price-now">¥{{item.price}}</text>
                      <text class="p-old" wx:if="{{item.original_price}}">¥{{item.original_price}}</text>
                    </view>
                    <view wx:if="{{item.qty > 0}}" class="stepper">
                      <view class="stepper-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="-1">-</view>
                      <view class="stepper-num">{{item.qty}}</view>
                      <view class="stepper-btn plus" catchtap="onStep" data-id="{{item.id}}" data-delta="1">+</view>
                    </view>
                    <view wx:else class="add-btn" catchtap="onStep" data-id="{{item.id}}" data-delta="1">
                      <t-icon name="add" size="14" color="#ffffff" />
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="cart-bar" wx:if="{{cartCount}}" bindtap="goCart">
    <view class="cart-bar-icon">
      <t-icon name="robot-1" size="24" color="#2E7CF6" />
      <view class="cart-bar-badge">{{cartCount}}</view>
    </view>
    <view class="cart-bar-info">
      <view class="cart-bar-price">¥{{cartTotal}}</view>
      <view class="cart-bar-fee">配送费 ¥0 · 明细</view>
    </view>
    <view class="go-cart">去结算</view>
  </view>
</view>
