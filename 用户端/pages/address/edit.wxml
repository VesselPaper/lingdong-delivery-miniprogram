<view class="edit-page">
  <view class="card">
    <view class="field">
      <view class="field-label">收货人</view>
      <input class="field-input" placeholder="请输入姓名" placeholder-class="field-placeholder" value="{{form.contact_name}}" bind:input="onField" data-field="contact_name" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input class="field-input" type="number" placeholder="请输入手机号" placeholder-class="field-placeholder" value="{{form.contact_phone}}" bind:input="onField" data-field="contact_phone" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">送达点位</view>
    <view class="point-picker" bindtap="showPicker">
      <text class="{{form.landmark_name ? '' : 'placeholder-text'}}">{{form.landmark_name || '请选择机器人送达点位'}}</text>
      <t-icon name="chevron-right" size="16" color="#C0C0C0" />
    </view>
  </view>

  <view class="card default-row">
    <text>设为默认地址</text>
    <switch checked="{{form.is_default}}" color="#3078C0" bind:change="onDefault" />
  </view>

  <view class="bottom-bar safe-bottom">
    <view class="btn btn-block" bindtap="save">保存</view>
  </view>

  <view wx:if="{{showPicker}}" class="popup-mask" bindtap="closePicker">
    <view class="popup-sheet" catchtap="noop">
      <view class="popup-close" bindtap="closePicker">
        <t-icon name="close" size="20" color="#C0C0C0" />
      </view>
      <view class="picker">
        <view class="picker-title">选择送达点位</view>
        <view class="picker-list">
          <view
            class="picker-item {{form.landmark_id == item.id ? 'active' : ''}}"
            wx:for="{{points}}" wx:key="id"
            bindtap="choosePoint" data-item="{{item}}"
          >
            <view class="picker-name">{{item.name}}</view>
            <view class="picker-sub text-weak text-sm">{{item.building}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
