<view class="addr-page">
  <view wx:if="{{list.length}}" class="page">
    <view class="card addr-item {{item.is_default ? 'active' : ''}}" wx:for="{{list}}" wx:key="id" bindtap="edit" data-id="{{item.id}}">
      <view class="addr-main">
        <view class="addr-line1">
          <text class="addr-name">{{item.contact_name}}</text>
          <text class="addr-phone text-sub">{{item.contact_phone}}</text>
          <view class="tag" wx:if="{{item.is_default}}">默认</view>
          <view class="tag tag-cur" wx:if="{{pointId == item.landmark_id}}">当前送达</view>
        </view>
        <view class="addr-line2 text-sub text-sm">
          <t-icon name="location" size="14" color="#3078C0" />
          <text>{{item.landmark_name}}</text>
        </view>
        <view class="addr-actions">
          <view class="addr-set-default" wx:if="{{!item.is_default}}" catchtap="setDefault" data-id="{{item.id}}">设为默认</view>
          <!-- 送到这里 = 把当前配送楼栋切成这条地址的楼栋（与首页/结算页共用） -->
          <view class="addr-set-point" wx:if="{{pointId != item.landmark_id}}" catchtap="setPoint" data-id="{{item.id}}">送到这里</view>
        </view>
      </view>
      <view class="addr-del" catchtap="del" data-id="{{item.id}}">
        <t-icon name="delete" size="20" color="#999999" />
      </view>
    </view>
  </view>
  <view wx:else class="empty">
    <view class="empty-icon"><t-icon name="location" size="40" color="#D8D8D8" /></view>
    <view class="empty-text">还没有收货地址</view>
  </view>

  <view class="bottom-bar safe-bottom">
    <view class="btn btn-block" bindtap="add">新增地址</view>
  </view>
</view>
