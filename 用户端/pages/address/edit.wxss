.edit-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.point-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #111111;
  padding: 10rpx 0 4rpx;
}

.placeholder-text {
  color: #999999;
}

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.picker-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.picker-item {
  padding: 26rpx 32rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 2rpx solid transparent;
}

.picker-item.active {
  background: #DCE9F8;
  border-color: #3078C0;
}

.picker-name {
  font-size: 30rpx;
  color: #111111;
}

.picker-sub {
  margin-top: 4rpx;
}
