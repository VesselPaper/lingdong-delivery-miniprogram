.addr-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.addr-item {
  display: flex;
  align-items: center;
  border: 1rpx solid #EBEBEB;
  border-radius: 12rpx;
}

.addr-item.active {
  border: 1rpx solid #3078C0;
}

.addr-main {
  flex: 1;
}

.addr-line1 {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.addr-line2 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.addr-del {
  padding-left: 24rpx;
}

.addr-set-default {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #3078C0;
}

/* 「当前送达」标记：让用户一眼看出首页/结算页正在用的楼栋是哪一条 */
.tag-cur {
  color: #ffffff;
  background: #3078C0;
  border-color: #3078C0;
}

.addr-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.addr-set-point {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #E64340;
}
