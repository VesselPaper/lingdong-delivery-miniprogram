# 零栋无人送餐后端 环境变量示例
# 复制为 .env 后按实际情况填写（敏感信息仅存本地，勿提交公开仓库）

# ========== 运行模式（启动守卫，配置不合法则拒绝启动） ==========
# 三档，留空默认 demo。作用是把「登录/支付/配送/设备控制」四条链路的真假绑定成一致的组合，
# 杜绝「演示登录 + 模拟支付 + 生产物流平台 + 前端假配送」这种能真实误调度机器人的混用。
#
#   demo       演示档。要求 PLATFORM_MOCK=true。设备控制走本地模拟。
#   pilot      试点档。真实配送 + 真实设备控制；登录与支付仍可模拟。
#              PLATFORM_BASE 主机名必须以 test- 开头，否则需要下面的逃生阀。
#   production 正式档。要求真实微信登录（WX_APPID+WX_SECRET）、真实支付（微信支付四要素齐备）、
#              PLATFORM_MOCK 与 PAY_MOCK 均不得为 true。
#
RUN_MODE=demo

# 逃生阀：允许 pilot 档连接【生产】物流平台。刻意做得难看 —— 启动时告警一次，每次派车再告警一次。
# 仅当测试环境的点位数据与生产不一致、无法用 test-robox 联调时才设 true。
# ALLOW_UNSAFE_PROD_PLATFORM=true

# 商家邀请码：商家端登录必须提供正确邀请码才授予 merchant 角色。
# 服务端不再信任客户端自报的 role（此前任何人都能自助成为商家，进而远程开舱、导出全校顾客手机号）。
# 未配置时商家端登录一律拒绝。
MERCHANT_INVITE_CODE=

# 平台回调防伪令牌：拼在 feedbackDeliveryTaskUrl / checkBizOrderStatusUrl 的 query 上，回调时校验。
# 留空则由 PLATFORM_SECRET 派生（跨重启稳定，无需额外配置）。
# PLATFORM_CALLBACK_TOKEN=

# ========== 微信登录（必须真实配置，未配置则登录接口报错） ==========
# 微信小程序 AppID / AppSecret（用户端与商家端共用同一套时填一套）
WX_APPID=
WX_SECRET=

# ========== 微信支付 V3（必须真实配置，未配置则支付接口返回 501） ==========
WXPAY_MCHID=
WXPAY_SERIAL_NO=
# 商户 API 私钥（PEM 内容，或以 PEM 文件路径替代）
WXPAY_PRIVATE_KEY=
WXPAY_APIV3_KEY=
# 支付回调地址（公网可达 https，如 https://xxx.trycloudflare.com/api/pay/notify）
WXPAY_NOTIFY_URL=

# ========== 开放物流平台（robox）真实对接 ==========
# 测试环境凭据：由越凡项目部/项目内部提供（见 项目进度\03_技术记录.md），勿提交到仓库。
# 每位成员在本地 backend/.env 中自行填写。
PLATFORM_APPID=
PLATFORM_SECRET=
PLATFORM_PRINCIPALID=
# 平台地址（正式/测试环境）
PLATFORM_BASE=https://test-robox.eventec.cn/service-open-logis
# 回调公网地址（cloudflared 内网穿透域名，不含末尾斜杠）：
# 创建排队任务时会注册 feedbackDeliveryTaskUrl / checkBizOrderStatusUrl
PLATFORM_CALLBACK_BASE=
# 真实模式任务状态轮询间隔（毫秒）
PLATFORM_POLL_MS=8000
# 机器人长时间未接单的判定阈值（毫秒，默认 15 分钟 = 900000）
# 任务卡在「排队中/去上货点/上货中」超过该时长 → 订单标记「配送异常(6)」
DELIVERY_TIMEOUT_MS=900000
# 超时未接单扫描间隔（毫秒，默认 60 秒）
DELIVERY_SCAN_MS=60000

# ========== 一车多单配送批次 ==========
# 一个配送批次（一次出车）最多容纳的【商品件数】。
# 注意口径：按件计而非按单计 —— 12 单每单 3 件 = 36 件，远超车容量。
# 键名必须是 BATCH_MAX_ITEMS；旧的 BATCH_MAX_ORDERS 代码里只是别名常量，从不读环境变量，改了无效。
BATCH_MAX_ITEMS=12
# 自动接单模式下，批次成立后等待该时长自动派车（毫秒，默认 90 秒）
BATCH_WAIT_MS=90000
# 批次自动派车扫描间隔（毫秒，默认 15 秒）
BATCH_SCAN_MS=15000

# ========== 数据库 ==========
# SQLite 数据库路径（默认 backend/data/lingdong.db；多实例/测试隔离时可覆盖）
# LINGDONG_DB=C:/path/to/lingdong.db

# ========== 本地演示开关 ==========
# 设为 true 时使用本地模拟配送状态机（无平台凭据/无网络时演示用）
# 不设置或设为 false 时走开放物流平台真实模式
# 约束：RUN_MODE=demo 时必须为 true；RUN_MODE=production 时必须为 false。
PLATFORM_MOCK=true

# 设为 true 时跳过真实微信支付，点一下即标记已支付（用于在拿到商户号之前先跑通配送链路）。
# 注意：模拟支付下「退款」只改数据库、不会真实退钱。
# 约束：RUN_MODE=production 时必须为 false。
PAY_MOCK=true

# 模拟配送的送达耗时（毫秒，默认 10 秒）。仅在设备控制走模拟分支时生效。
# MOCK_ARRIVE_MS=10000
