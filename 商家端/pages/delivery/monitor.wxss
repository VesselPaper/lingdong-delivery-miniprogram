.monitor-page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

/* ---------- 真实地图 ---------- */
.map-card {
  padding: 0;
  overflow: hidden;
}

.map-box {
  position: relative;
  background: #F0F3F8;
}

.map-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.map-canvas {
  position: absolute;
  left: 0;
  top: 0;
}

.map-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--line);
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-dot.green { background: #2BA471; }
.legend-dot.orange { background: #F5A623; }
.legend-dot.blue { background: #3078C0; }

.legend-line {
  width: 28rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #3078C0;
}

.map-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  margin-bottom: 20rpx;
}

.map-error-text {
  font-size: 28rpx;
  color: #111111;
  text-align: center;
}

.map-error-tip {
  margin-top: 8rpx;
  text-align: center;
}

.robot-overview {
  margin-bottom: 20rpx;
}

.robot-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.robot-id {
  margin-top: 4rpx;
}

.robot-meta {
  display: flex;
  margin-top: 28rpx;
}

.meta-item {
  flex: 1;
  text-align: center;
}

.meta-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}

.meta-label {
  margin-top: 6rpx;
}

.robot-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  margin-bottom: 20rpx;
}

.robot-error-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #111111;
  text-align: center;
}

.robot-error-tip {
  margin-top: 8rpx;
  text-align: center;
}

.robot-retry {
  margin-top: 24rpx;
  background: #3078C0;
  color: #ffffff;
}

.section-title {
  margin-top: 8rpx;
}

.task-list {
  padding: 4rpx 0 16rpx;
}

.robot-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.qr-btn {
  margin-top: 4rpx;
}
