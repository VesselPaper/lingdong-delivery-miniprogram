<view class="monitor-page">
  <!-- 真实地图：校园地图 + 点位 + 路网 + 机器人位置 + 配送路线 -->
  <view class="section-title">实时地图</view>
  <view class="map-card card" wx:if="{{map}}">
    <view class="map-box" style="width:{{mapWidth}}px;height:{{mapHeight}}px;">
      <image class="map-bg" src="{{map.map_url}}" mode="aspectFill" />
      <canvas type="2d" id="mapCanvas" class="map-canvas" style="width:{{mapWidth}}px;height:{{mapHeight}}px;"></canvas>
    </view>
    <view class="map-foot">
      <view class="map-legend">
        <view class="legend-item"><view class="legend-dot green"></view><text>配送点 {{mapCounts.deliver}}</text></view>
        <view class="legend-item"><view class="legend-dot orange"></view><text>上货点 {{mapCounts.loading}}</text></view>
        <view class="legend-item"><view class="legend-dot blue"></view><text>无人车 {{mapCounts.robots}}</text></view>
        <view class="legend-item"><view class="legend-line"></view><text>配送路线</text></view>
      </view>
      <view class="map-foot-right">
        <text class="map-updated text-weak">{{mapUpdatedAt || '—'}} 更新</text>
        <view class="map-refresh" bindtap="refreshMap">刷新</view>
      </view>
    </view>
  </view>
  <view wx:elif="{{mapError}}" class="card map-error">
    <view class="map-error-text">{{mapError}}</view>
    <view class="map-error-tip text-weak text-sm">地图来自开放物流平台 building/mapInfo，请确认平台可用后刷新</view>
    <view class="btn btn-sm robot-retry" bindtap="refreshMap">重试</view>
  </view>
  <view wx:elif="{{mapLoading}}" class="card map-error">
    <view class="map-error-text">地图加载中…</view>
  </view>

  <!-- 真实机器人概览（可多台；数据来自开放物流平台 runtimeStatusList） -->
  <block wx:if="{{robots.length}}">
    <view class="robot-overview card" wx:for="{{robots}}" wx:key="device_sn">
      <view class="flex-between">
        <view class="robot-head">
          <view class="robot-status-dot {{item.statusClass}}"></view>
          <view class="robot-head-text">
            <view class="robot-name">{{item.name}}</view>
            <view class="robot-id text-weak text-sm">{{item.device_sn}}</view>
          </view>
        </view>
        <view class="robot-actions">
          <view class="tag {{item.online ? 'tag-green' : 'tag-gray'}}">{{item.online_text}}</view>
          <view class="btn btn-sm qr-btn" catchtap="goRobotQr" data-sn="{{item.device_sn}}">本车二维码</view>
        </view>
      </view>
      <view class="robot-meta">
        <view class="meta-item">
          <view class="meta-num">{{item.machine_text}}</view>
          <view class="meta-label text-weak text-sm">运行状态</view>
        </view>
        <view class="meta-item">
          <view class="meta-num">{{item.batteryText}}</view>
          <view class="battery-wrap">
            <view class="battery-bar {{item.batteryClass}}" style="width:{{item.batteryPct}}%"></view>
          </view>
          <view class="meta-label text-weak text-sm">电量</view>
        </view>
        <view class="meta-item">
          <view class="meta-num">{{item.building || '—'}}</view>
          <view class="meta-label text-weak text-sm">当前位置</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 无 API / 未配置平台时：明确报错 + 重试 -->
  <view wx:elif="{{robotsError}}" class="card robot-error">
    <view class="robot-error-icon"><t-icon name="info-circle" size="40" color="#C0C6CF" /></view>
    <view class="robot-error-text">{{robotsError}}</view>
    <view class="robot-error-tip text-weak text-sm">机器人由开放物流平台统一管理，请配置平台凭据后重试</view>
    <view class="btn btn-sm robot-retry" bindtap="retryRobots">重试</view>
  </view>

  <!-- 配送中的批次：一个批次一个卡面，批次内嵌套多单（与上货配单页同布局） -->
  <view class="section-title">配送中的批次</view>
  <view class="task-list">
    <batch-card
      wx:for="{{batches}}" wx:key="id"
      b="{{item}}" showProgress="{{true}}" showGoods="{{true}}" orderTap="{{true}}"
      bind:ordertap="goDetailByOrder" />
    <empty-view show="{{!batches.length}}" text="暂无配送中的批次" icon="robot-1" />
  </view>
</view>
