<view class="monitor-page">
  <!-- 配单上货入口 -->
  <view class="card load-entry" bindtap="goLoad">
    <t-icon name="scan" size="36rpx" color="#3078C0" />
    <text class="load-entry-text">配单上货</text>
    <text class="load-entry-arrow text-weak">›</text>
  </view>

  <!-- 真实机器人概览（可多台；数据来自开放物流平台 runtimeStatusList） -->
  <block wx:if="{{robots.length}}">
    <view class="robot-overview card" wx:for="{{robots}}" wx:key="device_sn">
      <view class="flex-between">
        <view>
          <view class="robot-name">{{item.name}}</view>
          <view class="robot-id text-weak text-sm">{{item.device_sn}}</view>
        </view>
        <view class="tag {{item.online ? 'tag-green' : ''}}">{{item.online_text}}</view>
      </view>
      <view class="robot-meta">
        <view class="meta-item">
          <view class="meta-num">{{item.machine_text}}</view>
          <view class="meta-label text-weak text-sm">运行状态</view>
        </view>
        <view class="meta-item">
          <view class="meta-num">{{item.battery === null ? '—' : item.battery + '%'}}</view>
          <view class="meta-label text-weak text-sm">电量</view>
        </view>
        <view class="meta-item">
          <view class="meta-num">{{item.building ? item.building + (item.floor ? ' ' + item.floor : '') : '—'}}</view>
          <view class="meta-label text-weak text-sm">当前位置</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 无 API / 未配置平台时：明确报错 + 重试 -->
  <view wx:elif="{{robotsError}}" class="card robot-error">
    <view class="robot-error-icon"><t-icon name="info-circle" size="40" color="#C0C6CF" /></view>
    <view class="robot-error-text">{{robotsError}}</view>
    <view class="robot-error-tip text-weak text-sm">机器人由开放物流平台统一管理，请配置平台凭据后重试</view>
    <view class="btn btn-sm robot-retry" bindtap="retryRobots">重试</view>
  </view>

  <!-- 配送中的批次：一个批次一个卡面，批次内嵌套多单（与上货配单页同布局） -->
  <view class="section-title">配送中的批次</view>
  <view class="task-list">
    <batch-card
      wx:for="{{batches}}" wx:key="id"
      b="{{item}}" showProgress="{{true}}" showGoods="{{true}}" orderTap="{{true}}"
      bind:ordertap="goDetailByOrder" />
    <empty-view show="{{!batches.length}}" text="暂无配送中的批次" icon="robot-1" />
  </view>
</view>
