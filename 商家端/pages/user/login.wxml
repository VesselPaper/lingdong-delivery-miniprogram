<view class="login-page">
  <view class="login-hero">
    <view class="login-logo">
      <t-icon name="shop-4" size="26" color="#ffffff" />
    </view>
    <view class="login-title">零栋商家</view>
    <view class="login-sub">商家登录管理商品与配送</view>
  </view>

  <view class="login-field">
    <view class="login-field-label">用户名</view>
    <input
      class="login-field-input"
      type="text"
      placeholder="请输入用户名"
      placeholder-class="login-field-ph"
      value="{{username}}"
      bindinput="onUsernameInput"
    />
  </view>

  <view class="login-field">
    <view class="login-field-label">密码</view>
    <view class="pwd-wrap">
      <input
        class="login-field-input pwd-input"
        type="text"
        password="{{!showPwd}}"
        placeholder="请输入密码"
        placeholder-class="login-field-ph"
        value="{{password}}"
        bindinput="onPasswordInput"
        bindconfirm="accountLogin"
      />
      <view class="pwd-eye" bindtap="togglePwd" hover-class="pwd-eye-hover">
        <image class="pwd-eye-img" src="{{showPwd ? '/images/pwd-eye-off.png' : '/images/pwd-eye.png'}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="login-actions">
    <view class="btn btn-block {{logging ? 'btn-disabled' : ''}}" bindtap="accountLogin">{{logging ? '登录中…' : '登 录'}}</view>
  </view>
</view>
