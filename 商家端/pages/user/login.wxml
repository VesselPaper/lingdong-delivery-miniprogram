<view class="login-page">
  <view class="login-hero">
    <view class="login-logo">
      <t-icon name="shop-4" size="26" color="#ffffff" />
    </view>
    <view class="login-title">零栋商家</view>
    <view class="login-sub">商家登录管理商品与配送</view>
  </view>

  <!-- 【临时放开】测试阶段免邀请码登录，邀请码输入框注释掉；恢复时取消注释即可 -->
