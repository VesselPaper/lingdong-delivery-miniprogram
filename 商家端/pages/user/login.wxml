  <view class="login-code">
    <view class="login-code-head">
      <text class="login-code-label">商家邀请码</text>
      <text class="login-code-optional text-weak text-sm">已是商家可不填</text>
    </view>
    <input
      class="login-code-input"
      type="text"
      placeholder="首次登录必填，由店主提供"
      placeholder-class="login-code-ph"
      value="{{merchantCode}}"
      bindinput="onCodeInput"
    />
    <view class="login-code-tip text-weak text-sm">商家权限只能凭邀请码授予，客户端无法自行声明身份。</view>
  </view>
  -->

  <view class="login-actions">
    <view class="btn btn-block {{logging ? 'btn-disabled' : ''}}" bindtap="wechatLogin">{{loginDemo ? '模拟登录（演示）' : '微信一键登录'}}</view>
    <view class="login-tip text-weak text-sm" wx:if="{{loginDemo}}">当前后端未配置商家端微信凭据，登录为演示模式（不产生真实微信身份）</view>
    <view class="login-tip text-weak text-sm">登录即同意《商家入驻协议》与《隐私政策》</view>
  </view>
</view>
