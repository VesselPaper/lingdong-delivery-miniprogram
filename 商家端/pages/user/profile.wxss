/* 以白为主、蓝只在顶部起手：28% 处就收到纯白，往下整页都是白底 */
.profile-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #EAF4FF 0%, #FFFFFF 28%);
}

/* 顶部浅蓝渐隐：原先 980rpx 的深蓝横幅（最深处 #6FB2E7）整页铺开会太蓝，
   现压成很浅的一层（最深约 #DCEBFA）并快速渐隐到透明，露出白色底。
   同时撑满整页高度，避免页面下方出现断层。 */
.grad-banner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #DCEBFA 0%, rgba(255, 255, 255, 0) 38%);
}

.profile-body {
  position: relative;
  padding: 120rpx 24rpx 180rpx;
  z-index: 1;
}

.shop-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 40rpx 32rpx;
  margin-bottom: var(--card-gap);
}

.shop-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: #EAF2FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.shop-info {
  flex: 1;
  overflow: hidden;
}

.shop-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #111111;
  letter-spacing: 2rpx;
}

.shop-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.change-pwd {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.change-pwd-text {
  font-size: 24rpx;
  color: #3078C0;
}

.menu-card {
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: var(--card-gap);
}

.menu-row {
  display: flex;
  align-items: center;
}

.menu-label {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #111111;
}

.menu-value {
  font-size: 26rpx;
  color: #999999;
}

.foot {
  text-align: center;
  margin-top: 48rpx;
}
