.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  background: linear-gradient(180deg, #DCE9F8 0%, #FAFAFA 70%);
  box-sizing: border-box;
}

.login-hero {
  text-align: center;
  margin-bottom: 56rpx;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #4E9AF8 0%, #3078C0 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(48, 120, 192, 0.3);
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.login-sub {
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
}

.login-tip {
  text-align: center;
  margin-top: 24rpx;
}

.login-code {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 56rpx;
  box-shadow: 0 6rpx 20rpx rgba(48, 120, 192, 0.08);
}

.login-code-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.login-code-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.login-code-optional {
  font-size: 22rpx;
}

.login-code-input {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #F5F7FA;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: #111111;
}

.login-code-ph {
  color: #A6A6A6;
  font-size: 26rpx;
  letter-spacing: 0;
}

.login-code-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
