.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 64rpx 120rpx;
  background: linear-gradient(180deg, #DCE9F8 0%, #FAFAFA 70%);
  box-sizing: border-box;
}

.login-hero {
  text-align: center;
  margin-bottom: 56rpx;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #4E9AF8 0%, #3078C0 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(48, 120, 192, 0.3);
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.login-sub {
  font-size: 26rpx;
  color: #666666;
  margin-top: 12rpx;
}

.login-field {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(48, 120, 192, 0.08);
}

.login-field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.login-field-input {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #F5F7FA;
  font-size: 30rpx;
  color: #111111;
}

/* 密码框：右侧留出眼睛图标的位置 */
.pwd-wrap {
  position: relative;
}

.pwd-input {
  padding-right: 84rpx;
}

.pwd-eye {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}

.pwd-eye-hover {
  background: rgba(0, 0, 0, 0.05);
}

/* 密码可见性图标：PNG（眼睛=密文，眼睛+斜杠=明文），与管理员网页浏览器原生图标同款线条风格 */
.pwd-eye-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.login-field-ph {
  color: #A6A6A6;
  font-size: 26rpx;
}

.login-actions {
  margin-top: 16rpx;
}

.login-tip {
  text-align: center;
  margin-top: 24rpx;
}
