<view class="act-page">
  <view class="act-head">
    <view class="act-head-title">活动管理</view>
    <view class="btn btn-sm act-add" bindtap="add">新建活动</view>
  </view>

  <view class="list">
    <block wx:for="{{activities}}" wx:key="id">
      <view class="act-card card" bindtap="edit" data-id="{{item.id}}">
        <view class="act-top">
          <view class="act-title">{{item.title}}</view>
          <view class="tag {{item.status === 1 ? 'tag-green' : ''}}">{{item.status === 1 ? '已发布' : '已下线'}}</view>
        </view>
        <view class="act-badges">
          <view class="badge badge-type">{{item.type_txt}}</view>
          <view class="badge {{item.state === 'active' ? 'badge-go' : (item.state === 'offline' ? 'badge-gray' : 'badge-soon')}}">{{item.state_txt}}</view>
        </view>
        <view class="act-sub text-sub text-sm" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
        <view class="act-meta text-weak text-sm">
          <text wx:if="{{item.link}}">链接：{{item.link}}</text>
          <text wx:else>无跳转链接</text>
        </view>
        <view class="act-actions" catchtap="noop">
          <view class="btn btn-sm btn-outline" bindtap="toggleStatus" data-id="{{item.id}}" data-status="{{item.status}}">{{item.status === 1 ? '下线' : '发布'}}</view>
          <view class="btn btn-sm btn-outline danger" bindtap="del" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </block>
    <view wx:if="{{!activities.length}}" class="empty">
      <view class="empty-icon"><t-icon name="activity" size="40" color="#C9D2DE" /></view>
      <view class="empty-text">暂无活动，点击右上角新建</view>
    </view>
  </view>
</view>
