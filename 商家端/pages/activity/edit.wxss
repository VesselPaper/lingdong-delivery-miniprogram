.edit-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 顶部状态提示条（草稿 / 已发布 / 已下线） */
.status-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 8rpx 20rpx;
}

.status-hint {
  flex: 1;
}

/* 历史无图活动的提醒条：不是错误，是「这样用户端看不到」的说明 */
.warn-bar {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  background: #FFF7EC;
  border: 1rpx solid #F5D9AE;
  border-radius: 12rpx;
}

.warn-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: #B4741A;
}

/* ===== 实时预览 ===== */
.preview-card {
  background: #ffffff;
  border: 1rpx solid #EEF1F5;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.preview-toggle {
  color: #3078C0;
}

.preview-body {
  padding: 0 24rpx 24rpx;
}

.preview-poster {
  position: relative;
  width: 100%;
  padding-bottom: 42%;
  background: #F1F5FA;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.preview-ph {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.preview-ph-text {
  font-size: 22rpx;
  color: #A8B6C8;
}

.preview-info {
  margin-top: 18rpx;
  background: #FAFBFD;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
}

.preview-act-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.preview-promo {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #E64340;
}

.preview-time {
  margin-top: 6rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.field:last-child {
  border-bottom: none;
}

.field-block {
  padding: 0 0 8rpx;
}

.field-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.field-label.big {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field-input {
  font-size: 30rpx;
  color: #111111;
}

.picker-value {
  font-size: 30rpx;
  color: #111111;
  padding: 6rpx 0;
}

/* 排序下拉：picker 要占满剩余宽度，箭头贴右，和输入框的视觉节奏一致 */
.picker-row {
  flex: 1;
  min-width: 0;
}

.picker-picked {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

/* 生效时间的「长期」开关：整行可读，开关靠右 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.switch-label {
  font-size: 28rpx;
  color: #111111;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
}

/* ===== 活动类型（紧凑横排，不再一张卡占一整屏） ===== */
.type-row {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  background: #F5F7FA;
  border: 2rpx solid #EEF1F5;
  border-radius: 14rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.type-item.type-on {
  background: #EBF3FB;
  border-color: #3078C0;
}

.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.type-on .type-name {
  color: #3078C0;
}

.type-desc {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* ===== 适用范围 ===== */
.scope-row {
  display: flex;
  gap: 16rpx;
}

.scope-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #F5F7FA;
  border: 2rpx solid #EEF1F5;
  font-size: 26rpx;
  color: #666666;
}

.scope-item.scope-on {
  background: #EBF3FB;
  border-color: #3078C0;
  color: #3078C0;
  font-weight: 600;
}

/* 「选择商品」入口行：只显示结果与入口，真正的多选在面板里做 */
.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  background: #F7F9FC;
  border-radius: 12rpx;
}

.pick-label {
  font-size: 24rpx;
  color: #666666;
}

.pick-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.pick-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #3078C0;
  font-weight: 600;
  flex: 0 0 auto;
}

.pick-tip {
  margin-top: 14rpx;
  line-height: 1.5;
}

/* ===== 活动海报（图片是外观，三种类型都可配） ===== */
.poster-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.poster-add {
  width: 220rpx;
  height: 160rpx;
  border: 2rpx dashed #C8D4E2;
  border-radius: 12rpx;
  background: #F7F9FC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.poster-add-text {
  font-size: 22rpx;
  color: #8A97A8;
}

.poster-box {
  width: 220rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F1F5FA;
  flex: 0 0 auto;
}

.poster-img {
  width: 100%;
  height: 100%;
}

.poster-ops {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.poster-op {
  font-size: 26rpx;
  color: #3078C0;
  padding: 8rpx 0;
}

.poster-op.danger {
  color: #E64340;
}

.poster-tip {
  margin-top: 18rpx;
  line-height: 1.5;
}

.poster-tip-sub {
  margin-top: 8rpx;
  color: #A8B6C8;
}

/* ===== 折扣 / 满减 ===== */
.calc-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #3078C0;
  background: #EBF3FB;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.tier {
  margin-bottom: 16rpx;
}

.tier-flex {
  display: flex;
  align-items: center;
}

.tier-prefix {
  font-size: 26rpx;
  color: #666666;
}

.tier-input {
  flex: 1;
  margin: 0 10rpx;
  height: 64rpx;
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  text-align: center;
}

.tier-del {
  font-size: 24rpx;
  color: #E64340;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.tier-add {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #3078C0;
  text-align: center;
  padding: 16rpx 0;
  background: #EBF3FB;
  border-radius: 10rpx;
  font-weight: 600;
}

/* ===== 底部双按钮 ===== */
.foot-btns {
  display: flex;
  margin-top: 32rpx;
  gap: 20rpx;
}

.draft-btn {
  flex: 1 1 0;
  width: auto;              /* 覆盖全局 .btn-block 的 width:100%，否则两个按钮各占满宽会挤压 */
  background: #ffffff;
  color: #3078C0;
  border: 2rpx solid #3078C0;
}

.publish-btn {
  flex: 1 1 0;
  width: auto;
  background: #3078C0;
  color: #ffffff;
}

/* ===== 商品选择面板（覆盖层） ===== */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 120rpx;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.picker-close {
  font-size: 28rpx;
  color: #3078C0;
  font-weight: 600;
  padding: 4rpx 8rpx;
}

.picker-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 28rpx;
  padding: 16rpx 22rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  flex: 0 0 auto;
}

.picker-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #111111;
}

.picker-cats {
  white-space: nowrap;
  padding: 20rpx 28rpx 4rpx;
  flex: 0 0 auto;
}

.picker-cat {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #666666;
  background: #F1F3F6;
  border-radius: 999rpx;
}

.picker-cat.on {
  background: #EBF3FB;
  color: #3078C0;
  font-weight: 600;
}

/* 批量操作条：全选/取消都只作用于「当前筛选出来的商品」 */
.picker-bulk {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx;
  flex: 0 0 auto;
}

.picker-bulk-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #3078C0;
  background: #F2F7FD;
  border-radius: 10rpx;
}

.picker-bulk-btn.danger {
  color: #E64340;
  background: #FDF2F2;
}

.picker-list {
  flex: 1;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.goods-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D8D8D8;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-check.check-on {
  background: #3078C0;
  border-color: #3078C0;
}

.picker-item-body {
  flex: 1;
  min-width: 0;
}

.picker-item-name {
  font-size: 28rpx;
  color: #111111;
}

.picker-item-cat {
  margin-top: 4rpx;
}

.picker-item-price {
  font-size: 26rpx;
  color: #E64340;
  font-weight: 600;
  flex: 0 0 auto;
}

.picker-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #999999;
}
