.edit-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.form-card {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.field:last-child {
  border-bottom: none;
}

.field-block {
  padding: 0 0 8rpx;
}

.field-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.field-label.big {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field-input {
  font-size: 30rpx;
  color: #111111;
}

.picker-value {
  font-size: 30rpx;
  color: #111111;
  padding: 6rpx 0;
}

.save-btn {
  margin-top: 32rpx;
  background: #3078C0;
  color: #ffffff;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
}

/* 类型选择 */
.type-row {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  background: #F5F7FA;
  border: 2rpx solid #EEF1F5;
  border-radius: 14rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.type-item.type-on {
  background: #EBF3FB;
  border-color: #3078C0;
}

.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.type-on .type-name {
  color: #3078C0;
}

.type-desc {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 适用范围 */
.scope-row {
  display: flex;
  gap: 16rpx;
}

.scope-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #F5F7FA;
  border: 2rpx solid #EEF1F5;
  font-size: 26rpx;
  color: #666666;
}

.scope-item.scope-on {
  background: #EBF3FB;
  border-color: #3078C0;
  color: #3078C0;
  font-weight: 600;
}

/* 指定商品多选 */
.goods-pick {
  margin-top: 20rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D8D8D8;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-check.check-on {
  background: #3078C0;
  border-color: #3078C0;
}

.goods-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.goods-price {
  font-size: 26rpx;
  color: #E64340;
  font-weight: 600;
}

/* 折扣 */
.calc-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #3078C0;
  background: #EBF3FB;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

/* 满减 */
.tier {
  margin-bottom: 16rpx;
}

.tier-flex {
  display: flex;
  align-items: center;
}

.tier-prefix {
  font-size: 26rpx;
  color: #666666;
}

.tier-input {
  flex: 1;
  margin: 0 10rpx;
  height: 64rpx;
  background: #F5F7FA;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  text-align: center;
}

.tier-del {
  font-size: 24rpx;
  color: #E64340;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.tier-add {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #3078C0;
  text-align: center;
  padding: 16rpx 0;
  background: #EBF3FB;
  border-radius: 10rpx;
  font-weight: 600;
}