<view class="edit-page">
  <!-- 当前状态（仅编辑已存在的活动时显示）：让商家一眼看出这个活动是否已经在用户端上线 -->
  <view class="status-bar" wx:if="{{id}}">
    <view class="tag {{status === 1 ? 'tag-green' : (status === 2 ? 'tag-orange' : 'tag-gray')}}">{{statusText}}</view>
  </view>

  <!-- 历史数据没有配图：用户端是纯图片列表，没图等于用户看不到。
       提前说清楚，否则商家改完文案点保存会被「发布需要图片」拦住，却不知道为什么 -->
  <view class="warn-bar" wx:if="{{id && status === 1 && !image}}">
    <t-icon name="info-circle" size="16" color="#E37318" />
    <text class="warn-text">该活动已发布但没有配图，用户端当前看不到它。需先上传图片，才能保存修改或重新发布。</text>
  </view>

  <!-- 实时预览：把用户端会看到的样子先给商家看，是减少「配错活动」最有效的办法 -->
  <view class="preview-card">
    <view class="preview-head" bindtap="togglePreview">
      <text class="preview-title">用户端预览</text>
      <text class="preview-toggle">{{previewOpen ? '收起' : '展开'}}</text>
    </view>
    <view class="preview-body" wx:if="{{previewOpen}}">
      <view class="preview-poster">
        <image wx:if="{{image}}" class="preview-img" src="{{image}}" mode="aspectFill" />
        <view wx:else class="preview-ph">
          <t-icon name="activity" size="40" color="#C6D6E8" />
          <text class="preview-ph-text">未上传活动图片</text>
        </view>
      </view>
      <view class="preview-info">
        <view class="preview-act-title">{{form.title || '（未填活动标题）'}}</view>
        <view class="preview-promo">{{previewPromo}}</view>
        <view class="preview-time">{{form.start_at || form.end_at ? (form.start_at || '未设置') + ' ~ ' + (form.end_at || '未设置') : '长期有效'}}</view>
      </view>
    </view>
  </view>

  <!-- 活动类型 -->
  <view class="card form-card">
    <view class="field-label big">活动类型</view>
    <view class="type-row">
      <view wx:for="{{typeList}}" wx:key="value"
        class="type-item {{type === item.value ? 'type-on' : ''}}"
        bindtap="chooseType" data-type="{{item.value}}">
        <view class="type-name">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 优惠设置（跟着类型变）：放在靠前的位置，因为商家来建活动时最先想清楚的是优惠本身 -->
  <view class="card form-card" wx:if="{{type === 'discount'}}">
    <view class="field-label big">优惠设置</view>
    <view class="field">
      <view class="field-label">折扣</view>
      <input class="field-input" type="digit" placeholder="例如：8.5" value="{{discount}}" bindinput="onDiscountInput" />
    </view>
    <view class="calc-hint" wx:if="{{discountCalcHint}}">
      <text>{{discountCalcHint}}</text>
    </view>
  </view>

  <view class="card form-card" wx:if="{{type === 'full_reduce'}}">
    <view class="field-label big">优惠设置</view>
    <view class="field-block">
      <view class="field-label">满减档位</view>
      <view class="tier" wx:for="{{tiers}}" wx:key="index">
        <view class="tier-flex">
          <text class="tier-prefix">满</text>
          <input class="tier-input" type="digit" placeholder="金额" value="{{item.threshold}}" bindinput="onTierField" data-idx="{{index}}" data-field="threshold" />
          <text class="tier-prefix">元 减</text>
          <input class="tier-input" type="digit" placeholder="金额" value="{{item.reduce}}" bindinput="onTierField" data-idx="{{index}}" data-field="reduce" />
          <view class="tier-del" wx:if="{{tiers.length > 1}}" bindtap="removeTier" data-idx="{{index}}">删除</view>
        </view>
      </view>
      <view class="tier-add" bindtap="addTier">+ 添加档位</view>
    </view>
  </view>

  <!-- 商品选择 -->
  <view class="card form-card" wx:if="{{type !== 'custom'}}">
    <view class="field-label big">选择商品</view>
    <view class="scope-row">
      <view class="scope-item {{scope === 'all' ? 'scope-on' : ''}}" bindtap="setScope" data-scope="all">全场商品</view>
      <view class="scope-item {{scope === 'goods' ? 'scope-on' : ''}}" bindtap="setScope" data-scope="goods">指定商品</view>
    </view>

    <view wx:if="{{scope === 'goods'}}" class="pick-row" bindtap="openPicker">
      <view class="pick-left">
        <view class="pick-label">已选商品</view>
        <view class="pick-value {{selectedGoods.length ? '' : 'text-weak'}}">{{selectedGoods.length ? selectedGoods.length + ' 件' : '未选择'}}</view>
      </view>
      <view class="pick-btn">选择商品<t-icon name="chevron-right" size="14" color="#3078C0" /></view>
    </view>
  </view>

  <!-- 活动外观：图片是贴在任意类型上的「外观」，纯展示活动则只靠它 -->
  <view class="card form-card">
    <view class="field-label big">活动外观</view>
    <view class="poster-row">
      <view class="poster-add" wx:if="{{!image}}" bindtap="choosePoster">
        <t-icon name="add" size="34" color="#A8B6C8" />
        <text class="poster-add-text">上传活动图片</text>
      </view>
      <block wx:else>
        <view class="poster-box" bindtap="previewPoster">
          <image class="poster-img" src="{{image}}" mode="aspectFill" />
        </view>
        <view class="poster-ops">
          <view class="poster-op" bindtap="choosePoster">更换</view>
          <view class="poster-op danger" bindtap="removePoster">删除</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 基础信息 -->
  <view class="card form-card">
    <view class="field-label big">基础信息</view>
    <view class="field">
      <view class="field-label">活动标题</view>
      <input class="field-input" placeholder="请输入活动标题" value="{{form.title}}" bindinput="onField" data-field="title" />
    </view>
    <view class="field">
      <view class="field-label">副标题</view>
      <input class="field-input" placeholder="一句话描述（选填）" value="{{form.subtitle}}" bindinput="onField" data-field="subtitle" />
    </view>
    <view class="field">
      <view class="field-label">排序</view>
      <!-- 下拉选择而不是手输数字：选项数量跟着现有活动总数（含已发布与草稿）自动变化，
           商家不用自己猜一个数；发布后回来改这里即可调整顺序 -->
      <picker class="picker-row" mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="picker-value picker-picked">
          <text>{{sortOptions[sortIndex] || '第 1 位'}}</text>
          <t-icon name="chevron-down" size="14" color="#999999" />
        </view>
      </picker>
    </view>
  </view>

  <!-- 生效时间 -->
  <view class="card form-card">
    <view class="field-label big">生效时间</view>
    <!-- 长期活动：打开后不需要设起止日期，用户端显示「长期有效」。
         放在最前面，因为大多数日常活动不需要精确到天。 -->
    <view class="switch-row">
      <text class="switch-label">长期</text>
      <switch checked="{{longTerm}}" color="#3078C0" bindchange="onLongTerm" />
    </view>
    <block wx:if="{{!longTerm}}">
      <view class="field">
        <view class="field-label">开始日期</view>
        <picker mode="date" value="{{form.start_at}}" start="2020-01-01" bindchange="onField" data-field="start_at">
          <view class="picker-value">{{form.start_at || '选择开始日期'}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">结束日期</view>
        <picker mode="date" value="{{form.end_at}}" bindchange="onField" data-field="end_at">
          <view class="picker-value">{{form.end_at || '选择结束日期'}}</view>
        </picker>
      </view>
    </block>
  </view>

  <view class="foot-btns">
    <!-- 文案随状态变：只有在「草稿」上点才会存成草稿；已发布/已下线时这个按钮只是保存修改，
         不会改变上下架状态（防止改个文案就把线上活动下线）。 -->
    <view class="btn btn-block draft-btn" bindtap="saveDraft">{{status === 1 || status === 2 ? '仅保存' : '保存草稿'}}</view>
    <view class="btn btn-block publish-btn" bindtap="publish">{{status === 1 ? '保存并发布' : '发布'}}</view>
  </view>

  <!-- 商品选择面板（覆盖层）：分类筛选 + 全选当前分类 + 关键词搜索 -->
  <view class="picker-mask" wx:if="{{pickerOpen}}" bindtap="closePicker"></view>
  <view class="picker-panel" wx:if="{{pickerOpen}}">
    <view class="picker-head">
      <view class="picker-title">选择商品（已选 {{selectedGoods.length}} 件）</view>
      <view class="picker-close" bindtap="closePicker">完成</view>
    </view>

    <view class="picker-search">
      <t-icon name="search" size="15" color="#999999" />
      <input class="picker-search-input" placeholder="搜索商品名称" value="{{pickerKeyword}}" bindinput="onPickerSearch" />
    </view>

    <scroll-view class="picker-cats" scroll-x>
      <view class="picker-cat {{pickerCategory === '' ? 'on' : ''}}" bindtap="onPickerCategory" data-name="">全部 {{goodsList.length}}</view>
      <view class="picker-cat {{pickerCategory === item.name ? 'on' : ''}}"
        wx:for="{{pickerCategories}}" wx:key="name"
        bindtap="onPickerCategory" data-name="{{item.name}}">{{item.name}} {{item.count}}</view>
    </scroll-view>

    <view class="picker-bulk">
      <view class="picker-bulk-btn" bindtap="selectAllVisible">全选当前 {{pickerGoods.length}} 件</view>
      <view class="picker-bulk-btn" bindtap="unselectAllVisible">取消当前</view>
      <view class="picker-bulk-btn danger" bindtap="clearSelected">清空</view>
    </view>

    <scroll-view class="picker-list" scroll-y>
      <view class="picker-item" wx:for="{{pickerGoods}}" wx:key="id" bindtap="toggleGoods" data-id="{{item.id}}">
        <view class="goods-check {{selectedMap[item.id] ? 'check-on' : ''}}">
          <t-icon wx:if="{{selectedMap[item.id]}}" name="check" size="12" color="#ffffff" />
        </view>
        <view class="picker-item-body">
          <view class="picker-item-name ellipsis">{{item.name}}</view>
          <view class="picker-item-cat">{{item.category || '其他'}}</view>
        </view>
        <text class="picker-item-price">¥{{item.price}}</text>
      </view>
      <view class="picker-empty" wx:if="{{!pickerGoods.length}}">没有匹配的商品</view>
    </scroll-view>
  </view>
</view>
