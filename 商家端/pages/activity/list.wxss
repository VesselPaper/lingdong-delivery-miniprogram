.act-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.act-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.act-head-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111111;
}

.act-add {
  background: #3078C0;
  color: #ffffff;
}

.act-card {
  padding: 28rpx;
}

.act-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.act-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.act-sub {
  margin-top: 12rpx;
}

.act-meta {
  margin-top: 12rpx;
}

.act-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.act-actions .danger {
  color: #FA5151;
  border-color: #FA5151;
}

.act-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #F5F7FA;
  color: #666666;
}

.badge-type {
  background: #EBF3FB;
  color: #3078C0;
  font-weight: 600;
}

.badge-go {
  background: #E8F7EC;
  color: #2AA34F;
}

.badge-soon {
  background: #FFF6E0;
  color: #D69A00;
}

.badge-gray {
  background: #F0F0F0;
  color: #999999;
}

.badge-red {
  background: #FDEEEE;
  color: #E64340;
}
