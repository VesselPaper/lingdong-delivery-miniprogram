.settings-page {
  padding: 32rpx 24rpx 64rpx;
}

.settings-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
  margin-bottom: 12rpx;
}

.seg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.seg-row:last-child {
  border-bottom: none;
}

.seg-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #111111;
}

.settings-hint {
  margin-top: 8rpx;
  line-height: 1.6;
}

/* 配送费输入：右对齐数字 + ¥ /单 单位，避免与开关行风格割裂 */
.fee-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.fee-unit {
  font-size: 26rpx;
  color: #666666;
}

.fee-input {
  width: 170rpx;
  height: 62rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #111111;
  text-align: right;
  background: #F7F8FA;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.cell-full {
  flex: 1;
}

.logout-text {
  color: #E64340;
}
