<view class="settings-page">
  <view class="card">
    <view class="settings-title">商铺设置</view>
    <view class="seg-row">
      <view class="seg-label">
        <t-icon name="shop-4" size="36rpx" color="#3078C0" style="margin-right:12rpx;" />
        <text>营业状态</text>
      </view>
      <view class="seg">
        <view class="seg-item {{business === 'closed' ? 'on' : ''}}" bindtap="setBusiness" data-val="closed">歇业</view>
        <view class="seg-item {{business === 'open' ? 'on' : ''}}" bindtap="setBusiness" data-val="open">营业</view>
      </view>
    </view>
    <view class="seg-row">
      <view class="seg-label"><text>自动接单</text></view>
      <switch checked="{{autoAccept}}" color="#3078C0" bindchange="onAutoAccept" />
    </view>
    <!-- 配送费：用户端下单时按此金额收取（整单一次），改价不影响已产生的历史订单 -->
    <view class="seg-row">
      <view class="seg-label"><text>配送费</text></view>
      <view class="fee-input-wrap">
        <text class="fee-unit">¥</text>
        <input class="fee-input" type="digit" value="{{deliveryFee}}" bind:input="onFeeInput" bind:blur="onFeeBlur" placeholder="1.00" placeholder-class="field-placeholder" />
        <text class="fee-unit">/单</text>
      </view>
    </view>
  </view>

  <!-- 多店铺一期（doc/16 §6.4）：起送价 / 打包费 / 店铺分类 / 本店取货点
       只有店长能改（后端 PUT /merchant/shop 是 ownerGuard），店员看到也不给入口 -->
  <view class="card" wx:if="{{isOwner}}">
    <view class="settings-title">店铺经营参数</view>
    <view class="seg-row">
      <view class="seg-label"><text>起送价</text></view>
      <view class="fee-input-wrap">
        <text class="fee-unit">¥</text>
        <input class="fee-input" type="digit" value="{{minOrder}}" bind:input="onMinOrderInput" bind:blur="onMinOrderBlur" placeholder="0.00" placeholder-class="field-placeholder" />
        <text class="fee-unit">起送</text>
      </view>
    </view>
    <view class="seg-row">
      <view class="seg-label"><text>打包费</text></view>
      <view class="fee-input-wrap">
        <text class="fee-unit">¥</text>
        <input class="fee-input" type="digit" value="{{packFee}}" bind:input="onPackFeeInput" bind:blur="onPackFeeBlur" placeholder="0.00" placeholder-class="field-placeholder" />
        <text class="fee-unit">/单</text>
      </view>
    </view>
    <view class="seg-row" bindtap="onPickCategory">
      <view class="seg-label"><text>店铺分类</text></view>
      <view class="seg-value">
        <text class="{{category ? '' : 'text-weak'}}">{{category || '未设置'}}</text>
        <t-icon name="chevron-right" size="36rpx" color="#C0C0C0" />
      </view>
    </view>
    <!-- 本店取货点：批次从这家店的取货点装货，一车一趟只服务一家店 -->
    <view class="seg-row" bindtap="onPickPickup">
      <view class="seg-label"><text>本店取货点</text></view>
      <view class="seg-value">
        <text class="{{pickupName ? '' : 'text-weak'}}">{{pickupName || '未设置（用默认上货点）'}}</text>
        <t-icon name="chevron-right" size="36rpx" color="#C0C0C0" />
      </view>
    </view>
    <view class="settings-hint">取货点决定无人车到哪装这家店的货；不设置时用系统默认上货点。</view>
  </view>

  <view class="card">
    <view class="cell" bindtap="goMonitor">
      <view class="cell-label cell-full">配送监控</view>
      <t-icon name="chevron-right" size="36rpx" color="#C0C0C0" />
    </view>
    <!-- 订单异常管理：店长专用入口（店员不可见）。清理订单/批次会驳回任务、付款退款，
         用户端显示「订单异常」——不进首页常用功能图标区，避免误触。 -->
    <view class="cell" wx:if="{{isOwner}}" bindtap="goOrderAdmin">
      <view class="cell-label cell-full order-admin-text">订单异常管理</view>
      <t-icon name="chevron-right" size="36rpx" color="#C0C0C0" />
    </view>
    <view class="cell" bindtap="logout">
      <view class="cell-label cell-full logout-text">退出登录</view>
      <t-icon name="chevron-right" size="36rpx" color="#C0C0C0" />
    </view>
  </view>
</view>
