.shop-home {
  padding: 32rpx 24rpx 64rpx;
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #F5A623;
}

.task-grid {
  display: flex;
  margin-top: 40rpx;
}

.task-item {
  flex: 1;
  text-align: center;
}

.task-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.task-text {
  font-size: 26rpx;
}

.task-blue { color: #3078C0; }
.task-red { color: #E64340; }
.task-orange { color: #F5A623; }
.task-gray { color: #666666; }

.task-num {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

.func-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3078C0;
}

.func-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 40rpx;
}

.func-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.func-text {
  font-size: 26rpx;
  color: #333333;
}
