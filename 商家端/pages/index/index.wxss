.home-page {
  padding: 40rpx 24rpx 180rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #111111;
}

.search-ph {
  color: #999999;
}

.lock-sort {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.lock-sort-text {
  font-size: 28rpx;
  color: #333333;
}

.shop-card {
  position: relative;
  display: flex;
  align-items: stretch;
  background: #E9F4FE;
  border: 1rpx solid #C9E3F8;
  border-radius: 16rpx;
  min-height: 200rpx;
  overflow: hidden;
}

.shop-card-main {
  flex: 1;
  padding: 48rpx 32rpx;
}

.shop-card-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.shop-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.shop-card-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #3078C0;
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-bottom-left-radius: 12rpx;
}

.shop-card-divider {
  width: 1rpx;
  background: #C9E3F8;
  margin: 24rpx 0;
}

.shop-card-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 200rpx;
  padding: 24rpx 0;
}

.shop-card-action-text {
  font-size: 26rpx;
  color: #3078C0;
}
