<view class="edit-page">
  <view class="card">
    <view class="field">
      <view class="field-label">商品名称</view>
      <input class="field-input" placeholder="如：招牌鸭脖" value="{{form.name}}" bind:change="onField" data-field="name" />
    </view>
    <view class="field">
      <view class="field-label">分类</view>
      <view class="category-picker" bindtap="openCategoryPicker">
        <text class="category-value {{form.category ? '' : 'placeholder'}}">{{form.category || '请选择分类'}}</text>
        <t-icon name="chevron-down" size="28rpx" color="#999999" />
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">商品图片</view>
    <view class="img-picker" wx:if="{{!form.image}}" bindtap="chooseImage">
      <t-icon name="add" size="52rpx" color="#BFBFBF" />
      <view class="img-picker-text">添加商品图片</view>
    </view>
    <view class="img-wrapper" wx:else>
      <image class="img-preview" src="{{form.image}}" mode="aspectFill" bindtap="previewImage" />
      <view class="img-remove" catchtap="removeImage">
        <t-icon name="close" size="26rpx" color="#ffffff" />
      </view>
    </view>
    <view class="img-hint text-weak text-sm">支持从相册选择或拍摄，最多 1 张</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">售价</view>
      <input class="field-input" type="digit" placeholder="0.00" value="{{form.price}}" bind:change="onField" data-field="price" />
    </view>
    <view class="field">
      <view class="field-label">原价</view>
      <input class="field-input" type="digit" placeholder="选填，划线价展示" value="{{form.original_price}}" bind:change="onField" data-field="original_price" />
    </view>
    <view class="field">
      <view class="field-label">库存</view>
      <input class="field-input" type="number" placeholder="不填默认 99" value="{{form.stock}}" bind:change="onField" data-field="stock" />
    </view>
    <view class="field">
      <view class="field-label">条码</view>
      <input class="field-input" placeholder="商品条形码" value="{{form.barcode}}" bind:change="onField" data-field="barcode" />
    </view>
    <view class="field">
      <view class="field-label">主单位</view>
      <input class="field-input" placeholder="如：袋 / 盒 / 瓶" value="{{form.unit}}" bind:change="onField" data-field="unit" />
    </view>
  </view>

  <view class="card">
    <view class="field-label">商品描述</view>
    <textarea class="desc-input" placeholder="介绍商品卖点，如口味、配料" value="{{form.description}}" bind:change="onField" data-field="description" auto-height maxlength="200" />
  </view>

  <view class="bottom-bar safe-bottom">
    <view class="btn btn-block" bindtap="save">保存商品</view>
  </view>

  <!-- 分类选择弹层 -->
  <view class="popup-mask" wx:if="{{showCategory}}" bindtap="closeCategory"></view>
  <view class="popup-sheet" wx:if="{{showCategory}}">
    <view class="popup-title">选择或新增分类</view>
    <view class="chip-grid">
      <view
        class="chip {{form.category === item ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        bindtap="chooseCategory"
        data-cat="{{item}}"
      >{{item}}</view>
      <view class="chip chip-new" bindtap="startNewCategory">＋ 新增分类</view>
    </view>
    <view class="new-cat-row" wx:if="{{addingCategory}}">
      <input class="new-cat-input" placeholder="输入新分类名称" value="{{newCategory}}" bindinput="onNewCategory" focus />
      <view class="btn btn-sm" bindtap="confirmNewCategory">确定</view>
    </view>
    <view class="popup-actions">
      <view class="btn btn-ghost flex-1" bindtap="closeCategory">取消</view>
    </view>
  </view>
</view>
