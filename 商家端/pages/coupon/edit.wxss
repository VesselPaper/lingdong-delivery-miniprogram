.edit-page {
  min-height: 100vh;
  background: #FAFAFA;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 实时预览（券票据样式，与用户端结算页面额块同一观感） ===== */
.preview-card {
  background: #ffffff;
  border: 1rpx solid #EEF1F5;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.preview-head {
  padding: 24rpx 28rpx 0;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.preview-body {
  padding: 22rpx 28rpx 26rpx;
}

/* 券图按原图比例完整展示（widthFix），与用户端一致，不裁内容 */
.preview-img {
  width: 100%;
  display: block;
  border-radius: 12rpx;
  background: #F1F5FA;
}

.preview-ph {
  height: 260rpx;
  border-radius: 12rpx;
  background: #F4F7FB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.preview-ph-text {
  font-size: 22rpx;
  color: #B9C6D6;
}

/* 图下方就是用户端那个「立即领取」条：图 + 按钮 = 一张券在用户端的全部形态 */
.preview-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.preview-rule {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #E64340;
}

.preview-btn {
  flex: 0 0 auto;
  padding: 0 34rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #E64340;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.preview-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

/* ===== 券图上传 ===== */
.poster-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
}

.poster-add {
  flex: 1;
  height: 220rpx;
  border: 2rpx dashed #C6D6E8;
  border-radius: 14rpx;
  background: #F7FAFE;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.poster-add-text {
  font-size: 24rpx;
  color: #8FA6BF;
}

.poster-box {
  flex: 1;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F1F5FA;
}

.poster-img {
  width: 100%;
  height: 220rpx;
  display: block;
}

.poster-ops {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex: 0 0 auto;
}

.poster-op {
  padding: 12rpx 26rpx;
  border-radius: 8rpx;
  border: 2rpx solid #A8C8EA;
  color: #3078C0;
  font-size: 24rpx;
  text-align: center;
}

.poster-op.danger {
  border-color: #F0B9B7;
  color: #E64340;
}

/* ===== 表单卡片 ===== */
.form-card {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.field-label.big {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 输入框 + 单位（元/折/天/张）同一行，单位不吃输入宽度 */
.field-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #111111;
}

.field-unit {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: #999999;
}

.picker-value {
  font-size: 30rpx;
  color: #111111;
  padding: 6rpx 0;
}

/* 启用开关：整行可读，开关靠右 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.switch-label {
  font-size: 28rpx;
  color: #111111;
}

/* ===== 券类型 ===== */
.type-row {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  background: #F5F7FA;
  border: 2rpx solid #EEF1F5;
  border-radius: 14rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.type-item.type-on {
  background: #EBF3FB;
  border-color: #3078C0;
}

.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.type-on .type-name {
  color: #3078C0;
}

/* ===== 三选一（有效期类型 / 适用范围）= */
.scope-row {
  display: flex;
  gap: 16rpx;
}

.scope-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #F5F7FA;
  border: 2rpx solid #EEF1F5;
  font-size: 26rpx;
  color: #666666;
}

.scope-item.scope-on {
  background: #EBF3FB;
  border-color: #3078C0;
  color: #3078C0;
  font-weight: 600;
}

/* 「选择分类 / 选择商品」入口行：只显示结果与入口，真正的多选在面板里做 */
.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  background: #F7F9FC;
  border-radius: 12rpx;
}

.pick-left {
  flex: 1;
  min-width: 0;
}

.pick-label {
  font-size: 24rpx;
  color: #666666;
}

.pick-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.pick-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #3078C0;
  font-weight: 600;
  flex: 0 0 auto;
}

/* ===== 底部按钮 ===== */
.foot-btns {
  display: flex;
  margin-top: 32rpx;
}

.save-btn {
  background: #3078C0;
  color: #ffffff;
}

/* ===== 选择面板（覆盖层） ===== */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 120rpx;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
  flex: 0 0 auto;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.picker-close {
  font-size: 28rpx;
  color: #3078C0;
  font-weight: 600;
  padding: 4rpx 8rpx;
}

.picker-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 28rpx;
  padding: 16rpx 22rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  flex: 0 0 auto;
}

.picker-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #111111;
}

.picker-cats {
  white-space: nowrap;
  padding: 20rpx 28rpx 4rpx;
  flex: 0 0 auto;
}

.picker-cat {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #666666;
  background: #F1F3F6;
  border-radius: 999rpx;
}

.picker-cat.on {
  background: #EBF3FB;
  color: #3078C0;
  font-weight: 600;
}

/* 批量操作条：全选/取消都只作用于「当前筛选出来的商品」 */
.picker-bulk {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx;
  flex: 0 0 auto;
}

.picker-bulk-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #3078C0;
  background: #F2F7FD;
  border-radius: 10rpx;
}

.picker-bulk-btn.danger {
  color: #E64340;
  background: #FDF2F2;
}

/* 列表必须 flex:1 + min-height:0，否则 scroll-view 拿不到确定高度不会滚动 */
.picker-list {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.goods-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D8D8D8;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-check.check-on {
  background: #3078C0;
  border-color: #3078C0;
}

.picker-item-body {
  flex: 1;
  min-width: 0;
}

.picker-item-name {
  font-size: 28rpx;
  color: #111111;
}

.picker-item-cat {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}

.picker-item-count {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: #999999;
}

.picker-item-price {
  font-size: 26rpx;
  color: #E64340;
  font-weight: 600;
  flex: 0 0 auto;
}

.picker-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #999999;
}
