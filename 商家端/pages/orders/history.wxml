<view class="history-page">
  <view class="search-row">
    <view class="search-box">
      <t-icon name="search" size="32rpx" color="#999999" />
      <input class="search-input" placeholder="订单号 / 商品 / 点位" placeholder-class="search-ph" value="{{keyword}}" bindinput="onSearch" />
    </view>
    <view class="filter-btn" bindtap="openFilter">
      <t-icon name="filter" size="40rpx" color="#333333" />
    </view>
  </view>

  <view class="list">
    <block wx:for="{{filtered}}" wx:key="id">
      <view class="order-card card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="order-top">
          <view class="order-no-col">
            <text class="order-title">订单 {{item.daily_seq}}</text>
            <text class="order-time-sub">{{item.created_time}}</text>
          </view>
          <view class="order-top-right">
            <view class="tag tag-green" wx:if="{{item.payed}}">已收款</view>
            <text class="order-status st-{{item.stClass}}">{{item.status_text}}</text>
          </view>
        </view>

        <!-- 商品明细：图 + 名称 + 价格 + 数量 -->
        <view class="h-items">
          <view class="h-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
            <view class="h-item-img">
              <image wx:if="{{it.goods_image}}" class="h-item-img-fill" src="{{it.goods_image}}" mode="aspectFill" />
              <t-icon wx:else name="cart" size="28rpx" color="#BFBFBF" />
            </view>
            <view class="h-item-name ellipsis">{{it.goods_name}}</view>
            <text class="h-item-price">¥{{it.price}}</text>
            <text class="h-item-qty">x{{it.quantity}}</text>
          </view>
        </view>

        <view class="order-foot">
          <view class="foot-left">
            <text class="foot-meta">{{item.batch ? '批次 ' + item.batch.daily_seq : '未组单批次'}}</text>
            <text class="foot-meta">{{item.landmark_name}}</text>
          </view>
          <view class="foot-total">
            <text class="text-sub text-sm">合计</text>
            <text class="total-price">¥{{item.total_amount}}</text>
          </view>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!filtered.length}}">
      <view class="empty-text">暂无历史订单</view>
    </view>
  </view>
</view>
