<view class="history-page">
  <search-box value="{{keyword}}" placeholder="订单号 / 商品 / 点位" bind:input="onSearch" />

  <view class="list">
    <block wx:for="{{filtered}}" wx:key="id">
      <view class="order-card card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="order-top">
          <view class="order-no-col">
            <text class="order-title">订单 {{item.code_short || item.daily_seq}}</text>
            <text class="order-time-sub">{{item.created_time}}</text>
          </view>
          <view class="order-top-right">
            <view class="tag tag-green" wx:if="{{item.payed}}">已收款</view>
            <status-text cls="{{item.stClass}}" text="{{item.status_text}}" />
          </view>
        </view>

        <!-- 商品明细：图 + 名称 + 价格 + 数量（一行一个） -->
        <view class="h-items">
          <goods-row
            wx:for="{{item.items}}" wx:for-item="it" wx:key="id"
            image="{{it.goods_image}}" name="{{it.goods_name}}" price="{{it.price}}" qty="{{it.quantity}}" />
        </view>

        <view class="order-foot">
          <view class="foot-left">
            <text class="foot-meta">{{item.batch ? '批次 ' + (item.batch.code_short || item.batch.daily_seq) : '未组单批次'}}</text>
            <text class="foot-meta">{{item.landmark_name}}</text>
          </view>
          <view class="foot-total">
            <text class="text-sub text-sm">合计</text>
            <text class="total-price">¥{{item.total_amount}}</text>
          </view>
        </view>
      </view>
    </block>
    <empty-view show="{{!filtered.length}}" text="暂无历史订单" icon="order" />
  </view>
</view>
