<view class="exception-page">
  <view class="tab-bar">
    <view class="tab {{active === 'all' ? 'on' : ''}}" bindtap="onTab" data-name="all">全部</view>
    <view class="tab {{active === 'pending' ? 'on' : ''}}" bindtap="onTab" data-name="pending">待处理</view>
    <view class="tab {{active === 'done' ? 'on' : ''}}" bindtap="onTab" data-name="done">已处理</view>
  </view>

  <search-box value="{{keyword}}" placeholder="订单号 / 点位 / 商品" bind:input="onSearch" />

  <view class="list">
    <block wx:for="{{filtered}}" wx:key="id">
      <view class="order-card card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="order-top">
          <view class="order-no-col">
            <text class="order-title">订单 {{item.daily_seq}}</text>
            <text class="order-time-sub">{{item.created_time}}</text>
          </view>
          <view class="order-top-right">
            <view class="tag tag-green" wx:if="{{item.payed}}">已收款</view>
            <status-text cls="{{item.stClass}}" text="{{item.handled ? item.handled_text : (item.status_text || '配送异常')}}" />
          </view>
        </view>

        <view class="ex-items">
          <goods-row
            wx:for="{{item.items}}" wx:for-item="it" wx:key="id"
            image="{{it.goods_image}}" name="{{it.goods_name}}" price="{{it.price}}" qty="{{it.quantity}}" />
        </view>

        <view class="order-foot">
          <view class="foot-left">
            <text class="foot-meta">{{item.batch ? '批次 ' + item.batch.daily_seq : '未组单'}}</text>
            <text class="foot-meta">{{item.landmark_name}}</text>
          </view>
          <view class="foot-total">
            <text class="text-sub text-sm">合计</text>
            <text class="total-price">¥{{item.total_amount}}</text>
          </view>
        </view>

        <!-- 待处理：处理操作 -->
        <view class="order-actions" wx:if="{{!item.handled}}">
          <view class="btn btn-outline btn-sm" hover-class="btn-hover" catchtap="refundOrder" data-id="{{item.id}}">取消并退款</view>
          <view class="btn btn-sm" hover-class="btn-hover" catchtap="retryOrder" data-id="{{item.id}}">重新配送</view>
        </view>
        <view class="order-handled text-weak text-sm" wx:else>
          {{item.handled_text}}（{{item.exception_handled}}）
        </view>
      </view>
    </block>
    <empty-view show="{{!filtered.length}}" text="暂无配送异常订单" icon="info-circle" />
  </view>
</view>
