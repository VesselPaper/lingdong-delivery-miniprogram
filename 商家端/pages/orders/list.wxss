.task-page {
  padding-bottom: 200rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 8rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #111111;
}

.search-ph {
  color: #999999;
}

.scan-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #EAF2FA;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.scan-text {
  font-size: 28rpx;
  color: #3078C0;
}

.shop-notice {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666666;
}

.list {
  padding: 16rpx 24rpx 48rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 26rpx;
  color: #999999;
}

.order-status {
  font-size: 26rpx;
  color: #3078C0;
}

.order-mid {
  padding: 16rpx 0;
}

.order-line {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.line-label {
  font-size: 26rpx;
  color: #666666;
  width: 120rpx;
}

.line-value {
  flex: 1;
  font-size: 26rpx;
  color: #111111;
}

.price-blue {
  color: #3078C0;
  font-weight: 500;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.status-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-top: 1rpx solid #EBEBEB;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 20;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: #999999;
}

.status-item.on {
  color: #3078C0;
}

.status-filter {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: #3078C0;
  color: #ffffff;
  font-size: 22rpx;
}

.popup-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
  margin: 8rpx 0 20rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.chip-grid .chip {
  flex: 0 0 calc((100% - 32rpx) / 3);
}

.popup-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn-ghost {
  background: #ffffff;
  border: 1rpx solid #D8D8D8;
  color: #666666;
}
