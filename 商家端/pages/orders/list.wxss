.task-page {
  padding-bottom: 200rpx;
}

.shop-notice {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 搜索行右侧「配单上货」入口 */
.scan-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--brand);
  border-radius: 12rpx;
  background: #ffffff;
}

.scan-text {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
}

/* 配单上货红点：待配单订单数 */
.scan-btn {
  position: relative;
}

.scan-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #E64340;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 6rpx rgba(230,67,64,0.4);
}

.list {
  padding: 16rpx 24rpx 48rpx;
}

/* 订单卡插槽内操作按钮行（确认接单 / 异常处理） */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

/* 底部四分类（待接单/待上货/配送中/待取货） */
.status-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-top: 1rpx solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 20;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--text-weak);
}

.status-item.on {
  color: var(--brand);
  font-weight: 500;
}
