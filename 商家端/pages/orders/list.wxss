.task-page {
  padding-bottom: 200rpx;
}

.shop-notice {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: var(--text-sub);
}

.list {
  padding: 16rpx 24rpx 48rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.order-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

/* 商品摘要行 */
.order-goods {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.goods-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: #F5F7FA;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-img-fill {
  width: 100%;
  height: 100%;
  display: block;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main);
}

.goods-sub {
  margin-top: 8rpx;
}

.goods-price {
  flex-shrink: 0;
  font-weight: 600;
}

.order-mid {
  padding: 16rpx 0;
}

.order-line {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.line-label {
  font-size: 26rpx;
  color: var(--text-sub);
  width: 120rpx;
}

.line-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-main);
}

.price-blue {
  color: var(--brand);
  font-weight: 500;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

/* 底部四分类（待接单/待上货/待配送/待取货） */
.status-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-top: 1rpx solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 20;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--text-weak);
}

.status-item.on {
  color: var(--brand);
  font-weight: 500;
}
