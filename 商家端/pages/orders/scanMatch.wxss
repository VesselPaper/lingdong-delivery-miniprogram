.match-page {
  padding: 24rpx 32rpx 60rpx;
}

.match-head {
  padding: 24rpx 8rpx 28rpx;
}

.match-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
}

.match-sub {
  margin-top: 8rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.item-pic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-qty {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #999;
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  flex-shrink: 0;
}

.foot-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}
