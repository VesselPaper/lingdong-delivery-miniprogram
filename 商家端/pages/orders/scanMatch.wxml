<view class="match-page">
  <view class="match-head">
    <view class="match-title">扫码配单结果</view>
    <view class="match-sub text-weak text-sm">已匹配到待接单订单，请确认接单</view>
  </view>

  <view class="card" wx:if="{{order.order_no}}">
    <view class="section-title">订单信息</view>
    <view class="info-row text-sub"><text>订单号</text><text>{{order.order_no}}</text></view>
    <view class="info-row text-sub"><text>送达点位</text><text>{{order.landmark_name}}</text></view>
    <view class="info-row text-sub"><text>收餐人</text><text>{{order.contact_name}} {{order.contact_phone}}</text></view>
    <view class="info-row text-sub"><text>金额</text><text class="pay-amount">¥{{order.total_amount}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">商品明细</view>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-name">{{item.goods_name}}</view>
      <view class="item-qty">x{{item.quantity}}</view>
      <view class="item-price">¥{{item.price}}</view>
    </view>
  </view>

  <view class="foot-actions">
    <view class="btn btn-block {{shopOpen ? '' : 'btn-disabled'}}" bindtap="confirmOrder">{{shopOpen ? '确认接单' : '店铺歇业中'}}</view>
    <view class="btn btn-outline btn-block" bindtap="goDetail">查看订单详情</view>
  </view>
</view>
