<view class="asd-page">
  <view class="card">
    <view class="asd-top">
      <text class="asd-type">取消申请</text>
      <text class="asd-status {{item.status === 0 ? 'warn' : ''}}">{{item.status_text}}</text>
    </view>
    <view class="info-row text-sub"><text>订单号</text><view class="info-value"><text class="info-text">{{item.order_no}}</text><view class="copy-btn" hover-class="copy-btn-hover" hover-stay-time="80" bindtap="copyText" data-text="{{item.order_no}}">复制</view></view></view>
    <view class="info-row text-sub"><text>送达点位</text><text>{{item.landmark_name}}</text></view>
    <view class="info-row text-sub"><text>订单金额</text><text>¥{{item.total_amount}}</text></view>
    <view class="info-row text-sub"><text>订单状态</text><text>{{item.order_status_text}}</text></view>
    <view class="info-row text-sub"><text>申请时间</text><text>{{item.created_at}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">取消原因</view>
    <view class="reason">{{item.reason || '无'}}</view>
    <block wx:if="{{item.merchant_reply}}">
      <view class="section-title" style="margin-top:24rpx;">处理结果</view>
      <view class="reason">{{item.merchant_reply}}</view>
    </block>
  </view>

  <view class="foot-actions" wx:if="{{item.status === 0}}">
    <view class="btn btn-outline btn-block" bindtap="reject">拒绝取消</view>
    <view class="btn btn-block" bindtap="approve">同意取消</view>
  </view>
</view>
