.history-page {
  padding-bottom: 48rpx;
}

.list {
  padding: 16rpx 24rpx 48rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.order-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 卡头：订单当日序号 + 下单时间 */
.order-no-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-time-sub {
  font-size: 22rpx;
  color: var(--text-weak);
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

/* 商品明细行（每行一个商品：图 + 名 + 价格 + 数量） */
.h-items {
  padding: 8rpx 0;
}

.h-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.h-item:last-child {
  border-bottom: none;
}

.h-item-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  background: #F5F7FA;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.h-item-img-fill {
  width: 100%;
  height: 100%;
  display: block;
}

.h-item-name {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.h-item-price {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
}

.h-item-qty {
  flex-shrink: 0;
  margin-left: 12rpx;
  min-width: 44rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 卡底：批次归属 + 点位 + 合计 */
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.foot-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.foot-meta {
  font-size: 22rpx;
  color: var(--text-weak);
}

.foot-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-shrink: 0;
}

.total-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}
