.history-page {
  padding-bottom: 48rpx;
}

.list {
  padding: 16rpx 24rpx 48rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.order-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 卡头：订单当日序号 + 下单时间 */
.order-no-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-time-sub {
  font-size: 22rpx;
  color: var(--text-weak);
}

/* 商品明细区（每行由 goods-row 组件渲染） */
.h-items {
  padding: 8rpx 0;
}

/* 卡底：批次归属 + 点位 + 合计 */
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.foot-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.foot-meta {
  font-size: 22rpx;
  color: var(--text-weak);
}

.foot-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-shrink: 0;
}

.total-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}
