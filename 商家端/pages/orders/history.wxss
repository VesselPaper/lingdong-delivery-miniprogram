.history-page {
  padding-bottom: 48rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 8rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #111111;
}

.search-ph {
  color: #999999;
}

.filter-btn {
  padding: 8rpx;
}

.list {
  padding: 16rpx 24rpx 48rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-time {
  font-size: 26rpx;
  color: #666666;
}

.order-status {
  font-size: 26rpx;
  color: #3078C0;
}

.order-body {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
}

.goods-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin: 0 20rpx;
  overflow: hidden;
}

.goods-name {
  font-size: 28rpx;
  color: #111111;
}

.goods-place {
  margin-top: 8rpx;
}

.price-blue {
  font-size: 28rpx;
  color: #3078C0;
  font-weight: 500;
}
