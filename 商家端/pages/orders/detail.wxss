.detail-page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.status-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 10rpx;
}

.dot-orange { background: #F5A623; }
.dot-blue { background: #3078C0; }
.dot-green { background: #2BA471; }
.dot-red { background: #E64340; }
.dot-gray { background: #999999; }

.status-main {
  flex: 1;
  min-width: 0;
}

.status-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.status-sub {
  margin-top: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.item-name {
  flex: 1;
}

.item-qty {
  color: #999999;
  margin-right: 24rpx;
}

.total-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.price {
  color: #111111;
}

.price-symbol {
  font-size: 26rpx;
}

.price-num {
  font-size: 34rpx;
  font-weight: 700;
}

.pay-amount {
  color: #3078C0;
  font-weight: 600;
}

.pay-status {
  font-weight: 500;
}

.pay-status.unpayed {
  color: #F5A623;
}

.pay-status.payed {
  color: #00A56B;
}

.pay-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.foot-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 16rpx;
}

.pay-sheet {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.pay-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
  margin-bottom: 12rpx;
}

.pay-sheet-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #3078C0;
  margin-bottom: 24rpx;
}

.pay-sheet-hint {
  margin-top: 24rpx;
}
