<view class="detail-page">
  <!-- 状态头部：浅色卡片 + 状态色圆点 + 状态色文字（修复深蓝底+彩色字难看问题） -->
  <view class="status-head">
    <view class="status-dot dot-{{order.stClass}}"></view>
    <view class="status-main">
      <view class="status-title st-{{order.stClass}}">订单 {{order.daily_seq}} · {{order.status_text}}</view>
      <view class="status-sub text-sm text-sub" wx:if="{{order.status === 1}}">请尽快接单，机器人将在门店等待装货</view>
      <view class="status-sub text-sm text-sub" wx:if="{{order.status === 2}}">机器人已接单，正在配送</view>
      <view class="status-sub text-sm text-sub" wx:if="{{order.status === 3}}">机器人已到达取餐点</view>
      <view class="status-sub text-sm text-sub" wx:if="{{order.status === 6}}">配送异常，请在任务页处理（重新配送 / 取消退款）</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">订单信息</view>
    <view class="info-row text-sub"><text>订单编号</text><text>{{order.order_no}}</text></view>
    <view class="info-row text-sub"><text>送达点位</text><text>{{order.landmark_name}}</text></view>
    <view class="info-row text-sub"><text>收餐人</text><text>{{order.contact_name}} {{order.contact_phone}}</text></view>
    <view class="info-row text-sub" wx:if="{{order.remark}}"><text>备注</text><text>{{order.remark}}</text></view>
    <view class="info-row text-sub"><text>下单时间</text><text>{{order.created_at}}</text></view>
    <view class="info-row text-sub" wx:if="{{order.batch}}">
      <text>配送批次</text>
      <text>批次 {{order.batch.daily_seq}} · {{order.batch.batch_no}}（{{order.batch.total_orders}}单 · {{order.batch.status_text}}）</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">商品明细</view>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-name">{{item.goods_name}}</view>
      <view class="item-qty">x{{item.quantity}}</view>
      <view class="item-price">¥{{item.price}}</view>
    </view>
    <view class="total-row">
      <text class="text-sub">合计</text>
      <view class="price"><text class="price-symbol">¥</text><text class="price-num">{{order.total_amount}}</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">收款信息</view>
    <view class="info-row text-sub"><text>应付金额</text><text class="pay-amount">¥{{order.total_amount}}</text></view>
    <view class="info-row text-sub"><text>支付方式</text><text>微信支付</text></view>
    <view class="info-row text-sub">
      <text>收款状态</text>
      <text class="pay-status {{payed ? 'payed' : 'unpayed'}}">{{payed ? '已收款' : '待支付'}}</text>
    </view>
    <view class="info-row text-sub" wx:if="{{!payed}}">
      <text>支付提醒</text>
      <text>由用户在小程序内完成微信支付，支付成功后自动更新</text>
    </view>
  </view>

  <view class="foot-actions">
    <view class="btn btn-sm btn-block" wx:if="{{order.status === 1 && shopOpen}}" bindtap="confirmOrder">接单并装车</view>
    <view class="btn btn-sm btn-block btn-disabled" wx:if="{{order.status === 1 && !shopOpen}}">歇业中，暂不可接单</view>
    <!-- 配送中订单无需操作按钮：测试阶段开始配送后模拟 ~10 秒送达进入待取货；真实阶段由平台回调推进 -->
  </view>
</view>
