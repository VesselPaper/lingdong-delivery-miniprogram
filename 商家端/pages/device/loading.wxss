.load-page {
  padding: 24rpx 32rpx 60rpx;
}

.load-head {
  padding: 24rpx 8rpx 32rpx;
}

.load-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}

.load-status {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.load-status.on {
  color: #2BA471;
}

.scan-card {
  margin-top: 20rpx;
}

.scan-row {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
}

.scan-row-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #3078C0;
}

.scan-row-arrow {
  font-size: 40rpx;
}

.pending-item {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.pending-item:last-child {
  border-bottom: none;
}

.pending-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pending-order {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.pending-status {
  font-size: 24rpx;
  color: #3078C0;
}

.pending-line {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.pending-error {
  padding: 16rpx 8rpx;
}

.pickup-code {
  font-size: 34rpx;
  font-weight: 700;
  color: #3078C0;
  letter-spacing: 4rpx;
}

.dispatch-zone {
  margin-top: 24rpx;
}

.dispatch-hint {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.dispatch-hint.warn {
  color: #E5484D;
}

.slider-area {
  width: 100%;
  border-radius: 50rpx;
  background: #E8EDF7;
  position: relative;
}

.slider-thumb {
  width: 120rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #3078C0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slider-arrow {
  color: #fff;
  font-size: 40rpx;
}

.dispatch-label {
  text-align: center;
  margin-top: 16rpx;
}

.success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.success-icon {
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2BA471;
}

/* 一车多单 · 批次卡片 */
.section-sub {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #999999;
}

.batch-item {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.batch-item:last-child {
  border-bottom: none;
}

.batch-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.batch-no {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}

.batch-status {
  margin-left: auto;
  font-size: 24rpx;
}

.batch-line {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.route-line {
  display: flex;
  margin-top: 10rpx;
  gap: 8rpx;
}

.route-label {
  color: #999999;
  flex-shrink: 0;
}

.route-value {
  color: #333333;
  flex: 1;
  word-break: break-all;
}

.order-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.order-tag {
  font-size: 22rpx;
  color: #3078C0;
  background: #EEF4FD;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.tag-blue {
  background: #EEF4FD;
  color: #3078C0;
}

.tag-orange {
  background: #FFF3E8;
  color: #F5A623;
}

.dispatch-btn {
  margin-top: 20rpx;
}

.select-btn {
  margin-top: 20rpx;
}

.btn-sm {
  padding: 16rpx 0;
  font-size: 26rpx;
}

.section-title.sub {
  margin-top: 24rpx;
}

