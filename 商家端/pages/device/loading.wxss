.load-page {
  padding-bottom: 80rpx;
}

/* 区块小标题（仅「组单中」保留；待上货列表直接展示，无冗余标题） */
.section-label {
  padding: 24rpx 8rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.scan-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F0F6FF;
  border: 2rpx dashed #3078C0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 20rpx 0;
}

.scan-entry-main {
  flex: 1;
}

.scan-entry-title {
  font-size: 30rpx;
  color: #3078C0;
  font-weight: 600;
}
