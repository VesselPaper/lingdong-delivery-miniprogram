.load-page {
  padding: 24rpx 32rpx 80rpx;
}

.load-head {
  padding: 24rpx 8rpx 32rpx;
}

.load-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}

.load-status {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.load-status.on {
  color: #2BA471;
}

.scan-card {
  margin-top: 20rpx;
}

.scan-row {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
}

.scan-row-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #3078C0;
}

.scan-row-arrow {
  font-size: 40rpx;
}

/* ---------- 批次卡片（卡面分明） ---------- */
.batch-card {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 63, 122, 0.06);
}

.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.batch-no-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.batch-no {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}

.batch-status {
  font-size: 22rpx;
  color: #999999;
}

.batch-act {
  flex-shrink: 0;
}

.batch-line {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
}

.batch-line .line-label {
  font-size: 24rpx;
  color: #666666;
  width: 110rpx;
  flex-shrink: 0;
}

.batch-line .line-value {
  flex: 1;
  font-size: 24rpx;
  color: #111111;
  word-break: break-all;
}

/* ---------- 批次内订单（每单一个子卡） ---------- */
.batch-orders {
  margin-top: 16rpx;
}

.b-order {
  background: #F8F9FB;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.b-order:last-child {
  margin-bottom: 0;
}

.b-order-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #E3E7EE;
}

.b-order-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
}

.b-order-landmark {
  font-size: 24rpx;
  color: #3078C0;
  background: #EAF3FF;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.b-order-status {
  margin-left: auto;
  font-size: 22rpx;
  color: #F5A623;
}

.b-order-status.done {
  color: #2BA471;
}

.b-meta-line {
  display: flex;
  align-items: baseline;
  padding: 6rpx 0;
}

.b-meta-label {
  font-size: 22rpx;
  color: #999999;
  width: 110rpx;
  flex-shrink: 0;
}

.b-meta-value {
  flex: 1;
  font-size: 22rpx;
  color: #333333;
}

.pickup-code {
  font-size: 30rpx;
  font-weight: 700;
  color: #3078C0;
  letter-spacing: 3rpx;
}

/* ---------- 单内商品（每行一个） ---------- */
.b-items {
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.b-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #EEF1F5;
}

.b-item:last-child {
  border-bottom: none;
}

.b-item-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.b-item-img.placeholder {
  background: #EEF1F5;
}

.b-item-name {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 26rpx;
  color: #111111;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.b-item-qty {
  font-size: 24rpx;
  color: #666666;
}

.b-item-price {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #3078C0;
}

/* ---------- 其它 ---------- */
.pending-error {
  padding: 16rpx 8rpx;
}

.dispatch-btn,
.select-btn {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
}

.tag-blue {
  background: #EEF4FD;
  color: #3078C0;
}

.tag-green {
  background: #E6F7F0;
  color: #2BA471;
}

.tag-orange {
  background: #FFF3E8;
  color: #F5A623;
}

.dispatch-zone {
  margin-top: 24rpx;
}

.dispatch-hint {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.dispatch-hint.warn {
  color: #E5484D;
}

.slider-area {
  width: 100%;
  border-radius: 50rpx;
  background: #E8EDF7;
  position: relative;
}

.slider-thumb {
  width: 120rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #3078C0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slider-arrow {
  color: #fff;
  font-size: 40rpx;
}

.dispatch-label {
  text-align: center;
  margin-top: 16rpx;
}

.success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.success-icon {
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2BA471;
}
