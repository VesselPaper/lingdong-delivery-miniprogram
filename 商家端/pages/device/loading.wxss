.load-page {
  padding-bottom: 80rpx;
}

/* 区块小标题（仅「组单中」保留；待上货列表直接展示，无冗余标题） */
.section-label {
  padding: 24rpx 8rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ---------- 单批次详情底部操作区 ---------- */
.foot-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

/* 派发滑块 / 成功态 */
.dispatch-zone {
  margin-top: 8rpx;
}

.dispatch-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}

.dispatch-hint.warn {
  color: var(--danger);
}

.slider-area {
  width: 100%;
  border-radius: 50rpx;
  background: #E8EDF7;
  position: relative;
  box-sizing: border-box;
}

.slider-thumb {
  width: 120rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.slider-arrow {
  color: #fff;
  font-size: 40rpx;
}

.dispatch-label {
  text-align: center;
  margin-top: 16rpx;
}

.success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.success-icon {
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--success);
}
