.load-page {
  padding-bottom: 80rpx;
}

/* 区块小标题（去掉了长提示文案） */
.section-label {
  padding: 24rpx 8rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ---------- 批次卡片（沿用全局 .card：12rpx 圆角 + 描边） ---------- */
.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.batch-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}

.batch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 完整批次编号：只在单批次详情显示，弱化展示 */
.batch-no-full {
  font-size: 20rpx;
  color: var(--text-weak);
}

.batch-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.batch-line {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
}

.batch-line .line-label {
  font-size: 24rpx;
  color: var(--text-sub);
  width: 110rpx;
  flex-shrink: 0;
}

.batch-line .line-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-main);
  word-break: break-all;
}

/* ---------- 批次内订单（每单一个子卡） ---------- */
.batch-orders {
  margin-top: 16rpx;
}

.b-order {
  background: #F8F9FB;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.b-order:last-child {
  margin-bottom: 0;
}

.b-order-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #ECEDF0;
}

.b-order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.b-order-landmark {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.b-order-status {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 500;
}

/* ---------- 单内商品（每行一个；价格在数量前面） ---------- */
.b-items {
  padding-top: 6rpx;
}

.b-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #ECEDF0;
}

.b-item:last-child {
  border-bottom: none;
}

/* 固定尺寸图盒 + 内部 image 100% 铺满，杜绝图片被 flex 拉伸变形 */
.b-item-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  background: #F5F7FA;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.b-item-img-fill {
  width: 100%;
  height: 100%;
  display: block;
}

.b-item-name {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.b-item-price {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
}

.b-item-qty {
  flex-shrink: 0;
  margin-left: 12rpx;
  min-width: 44rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 单卡底部：取餐码（弱化）+ 收餐人 */
.b-order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.b-meta-weak {
  font-size: 22rpx;
  color: var(--text-weak);
}

/* 卡底操作按钮 */
.batch-cta {
  margin-top: 20rpx;
}

/* ---------- 派发滑块 / 成功态 ---------- */
.dispatch-zone {
  margin-top: 24rpx;
}

.dispatch-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}

.dispatch-hint.warn {
  color: var(--danger);
}

.slider-area {
  width: 100%;
  border-radius: 50rpx;
  background: #E8EDF7;
  position: relative;
}

.slider-thumb {
  width: 120rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.slider-arrow {
  color: #fff;
  font-size: 40rpx;
}

.dispatch-label {
  text-align: center;
  margin-top: 16rpx;
}

.success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.success-icon {
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--success);
}
