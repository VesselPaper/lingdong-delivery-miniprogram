.load-page {
  padding-bottom: 80rpx;
}

/* 搜索行右侧「扫无人车二维码」方形图标按钮（无文字） */
.scan-square {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--brand);
  border-radius: 12rpx;
  background: #ffffff;
}

.scan-square-hover {
  background: #EAF3FF;
}

/* 自动派车提示条：检测到有订单，配送车将到上货点等待 */
.auto-dispatch-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #E8F1FC;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}

.auto-dispatch-text {
  font-size: 26rpx;
  color: #3078C0;
  flex: 1;
}

/* 区块小标题（仅「组单中」保留；待上货列表直接展示，无冗余标题） */
.section-label {
  padding: 24rpx 8rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}
