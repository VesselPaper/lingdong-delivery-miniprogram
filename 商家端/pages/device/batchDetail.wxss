.batch-detail-page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.foot-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

/* 派发滑块 / 成功态 */
.dispatch-zone {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dispatch-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

.dispatch-hint.warn {
  color: var(--danger);
}

/* 圆形「开始配送」按钮（仅舱门关闭后显示） */
.dispatch-circle {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 8rpx 24rpx rgba(48,120,192,0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: transform 0.15s ease;
}

.dispatch-circle-hover {
  transform: scale(0.94);
}

.dispatch-circle-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.slider-area {
  width: 600rpx;
  height: 100rpx;
  margin: 0 auto;
  border-radius: 50rpx;
  background: #E8EDF7;
  position: relative;
  box-sizing: border-box;
}

.slider-thumb {
  width: 120rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.slider-arrow {
  color: #fff;
  font-size: 40rpx;
}

.dispatch-label {
  text-align: center;
  margin-top: 16rpx;
}

.success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.success-icon {
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--success);
}

.lp-banner {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.lp-ok {
  background: #EAF9F0;
  border: 2rpx solid #2BA471;
}

.lp-wait {
  background: #FFF7E8;
  border: 2rpx solid #F5A623;
}

.lp-banner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.lp-banner-sub {
  margin-top: 8rpx;
}
