<view class="batch-detail-page">
  <block wx:if="{{batch}}">
    <!-- 扫码带入的无人车位置状态（需求3）：显示是否已在上货点 -->
    <view class="card lp-banner {{atLoadingPoint ? 'lp-ok' : 'lp-wait'}}" wx:if="{{scanSn}}">
      <view class="lp-banner-title">{{atLoadingPoint ? '无人车已在上货点 ✓' : '无人车未在上货点'}}</view>
      <view class="lp-banner-sub text-weak text-sm">
        <text wx:if="{{atLoadingPoint}}">设备 {{scanSn}} 已就位，舱门将自动打开</text>
        <text wx:else>{{loadMsg || ('设备 ' + scanSn + ' 距上货点约 ' + dist + ' 米，到达后会自动开舱')}}</text>
      </view>
    </view>

    <!-- 单批次详情：完整批次编号弱化展示 + 进度（当前任务卡） + 订单/商品完整展示（配单上货卡），点订单进订单详情 -->
    <batch-card b="{{batch}}" showNo="{{true}}" showGoods="{{true}}" showProgress="{{true}}" orderTap="{{true}}" bind:ordertap="goOrderDetail" />

    <view class="foot-actions">
      <!-- 组单中（未定型）：只读展示，引导回配单上货页点上货定型 -->
      <view class="pending-tip" wx:if="{{phase === 'pending'}}">
        <t-icon name="info-circle" size="32rpx" color="#F5A623" />
        <view class="pending-tip-text">批次尚未派车定型，如需上货请返回配单上货页点击上货</view>
      </view>

      <!-- 自动开舱中 / 等待机器人到达上货点：无手动开舱按钮，页面自己重试 -->
      <view class="open-status" wx:if="{{phase === 'scanned'}}">
        <view class="open-status-row">
          <t-icon name="{{opening ? 'time' : 'info-circle'}}" size="32rpx" color="{{opening ? '#3078C0' : '#F5A623'}}" />
          <text class="open-status-text">{{opening ? '正在打开舱门…' : (openError || '准备打开舱门…')}}</text>
        </view>
        <view class="open-status-sub" wx:if="{{!opening}}">机器人到达上货点后舱门会自动打开，无需手动操作</view>
        <view class="btn btn-sm open-retry" wx:if="{{canRetryOpen}}" hover-class="btn-hover" bindtap="retryOpenBin">重新尝试开舱</view>
      </view>

      <!-- 舱已开（请放货）/ 已关舱（货已装好）：同一个「立即配送」入口 -->
      <view class="dispatch-zone" wx:if="{{phase === 'open' || phase === 'loaded'}}">
        <view class="dispatch-hint {{hintWarn ? 'warn' : ''}}">
          <text wx:if="{{countdownText}}">{{countdownText}}</text>
          <text wx:elif="{{phase === 'open'}}">舱门已打开，请放入货品，放好后点击下方按钮</text>
          <text wx:else>货品已装好，点击按钮立即出发</text>
        </view>
        <!-- 圆形「立即配送」按钮：点击后弹二次确认，确认即关舱并发车 -->
        <view class="dispatch-circle" hover-class="dispatch-circle-hover" bindtap="confirmDispatch">
          <t-icon name="play-circle" size="44rpx" color="#ffffff" />
          <text class="dispatch-circle-text">立即配送</text>
        </view>
      </view>

      <view class="success-box" wx:if="{{phase === 'dispatched'}}">
        <view class="success-icon"><t-icon name="check-circle-filled" size="96rpx" color="#2BA471" /></view>
        <view class="success-text">{{dispatchNote}}</view>
      </view>

      <!-- 删除批次（店主专属）：2026-10-07 从管理员网页「清理批次」迁来；店员看不到这个按钮 -->
      <view class="del-batch" wx:if="{{canDeleteBatch}}">
        <view class="btn btn-sm btn-block btn-danger" hover-class="btn-hover" bindtap="deleteBatch">删除批次</view>
        <view class="del-batch-hint">删除会取消批内全部订单、回补库存并召回机器人，不可撤销</view>
      </view>
    </view>
  </block>
  <view class="card" wx:else>
    <view class="empty"><view class="empty-text">加载中…</view></view>
  </view>
</view>
