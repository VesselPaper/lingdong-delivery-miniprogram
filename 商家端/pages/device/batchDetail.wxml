<view class="batch-detail-page">
  <block wx:if="{{batch}}">
    <!-- 扫码带入的无人车位置状态（需求3）：显示是否已在上货点 -->
    <view class="card lp-banner {{atLoadingPoint ? 'lp-ok' : 'lp-wait'}}" wx:if="{{scanSn}}">
      <view class="lp-banner-title">{{atLoadingPoint ? '无人车已在上货点 ✓' : '无人车未在上货点'}}</view>
      <view class="lp-banner-sub text-weak text-sm">
        <text wx:if="{{atLoadingPoint}}">设备 {{scanSn}} 已就位，可以开舱上货</text>
        <text wx:else>{{loadMsg || ('设备 ' + scanSn + ' 距上货点约 ' + dist + ' 米，请等待其返回后再上货')}}</text>
      </view>
    </view>

    <!-- 单批次详情：完整批次编号弱化展示 + 订单/商品完整展示 -->
    <batch-card b="{{batch}}" showNo="{{true}}" showGoods="{{true}}" />

    <view class="foot-actions">
      <view class="btn btn-block" hover-class="btn-hover" wx:if="{{phase === 'scanned'}}" bindtap="openBin">{{mock ? '模拟打开舱门' : '打开舱门'}}</view>
      <view class="btn btn-block" hover-class="btn-hover" wx:if="{{phase === 'open'}}" bindtap="closeBin">{{mock ? '模拟关舱' : '关舱'}}</view>

      <view class="dispatch-zone" wx:if="{{phase === 'loaded'}}">
        <view class="dispatch-hint {{countdown > 0 ? '' : 'warn'}}">{{countdownText || '请尽快开始配送'}}</view>
        <movable-area class="slider-area">
          <movable-view class="slider-thumb"
            direction="horizontal" x="{{sliderX}}" animation="{{false}}" bindchange="onSliderChange" bindtouchend="onSliderEnd">
            <text class="slider-arrow">→</text>
          </movable-view>
        </movable-area>
        <view class="dispatch-label text-weak text-sm">向右滑动立即配送</view>
      </view>

      <view class="success-box" wx:if="{{phase === 'dispatched'}}">
        <view class="success-icon"><t-icon name="check-circle-filled" size="96rpx" color="#2BA471" /></view>
        <view class="success-text">机器人已出发，将按路线依次配送</view>
      </view>
    </view>
  </block>
  <view class="card" wx:else>
    <view class="empty"><view class="empty-text">加载中…</view></view>
  </view>
</view>
