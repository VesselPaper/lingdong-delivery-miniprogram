<view class="load-page">
  <!-- 搜索行 + 右上角「扫无人车二维码」方形图标（需求5：扫车身二维码 → 进入该车待上货批次上货页） -->
  <view class="search-row">
    <view class="search-box">
      <t-icon name="search" size="32rpx" color="#999999" />
      <input class="search-input" placeholder="搜索批次、订单、商品、点位" placeholder-class="search-ph" value="{{keyword}}" bindinput="onSearch" />
    </view>
    <view class="scan-square" bindtap="scanRobot" hover-class="scan-square-hover">
      <t-icon name="scan" size="36rpx" color="#3078C0" />
    </view>
  </view>

  <!-- 自动派车提示：有待配单批次时提示机器人正在前往上货点 -->
  <view class="auto-dispatch-tip" wx:if="{{(openBatches.length || readyBatches.length) && !keyword}}">
    <t-icon name="info-circle" size="30rpx" color="#3078C0" />
    <text class="auto-dispatch-text">检测到有订单，配送车将到上货点等待，请做好上货准备</text>
  </view>

  <view class="card" wx:if="{{loadingList}}">
    <view class="empty"><view class="empty-text">加载中…</view></view>
  </view>

  <!-- 组单中批次：上货（商品数）——机器人已在上货点待命，点「上货」即定型并进入上货页 -->
  <block wx:if="{{openBatches.length}}">
    <view class="section-label">组单中（机器人已到上货点待命）</view>
    <batch-card
      wx:for="{{openBatches}}" wx:key="id"
      b="{{item}}" action="select" selectText="{{'上货（' + item.total_items + '件）'}}" showGoods="{{true}}"
      orderTap="{{true}}"
      bind:cardtap="goBatchDetail" bind:ordertap="goOrderDetail" bind:select="selectBatch" />
  </block>

  <!-- 待上货批次：上货（商品数） -->
  <batch-card
    wx:for="{{readyBatches}}" wx:key="id"
    b="{{item}}" action="select" selectText="{{'上货（' + item.total_items + '件）'}}" showGoods="{{true}}"
    orderTap="{{true}}"
    bind:cardtap="goBatchDetail" bind:ordertap="goOrderDetail" bind:select="selectBatch" />

  <empty-view
    show="{{!loadingList && !openBatches.length && !readyBatches.length && !keyword}}"
    text="暂无待配单批次。新订单接单后自动组单，机器人将到上货点等待。"
    icon="app" />
  <empty-view
    show="{{keyword && !openBatches.length && !readyBatches.length && !loadingList}}"
    text="未找到匹配的批次、订单、商品"
    icon="search" />
</view>
