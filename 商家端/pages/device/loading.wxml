<view class="load-page">
  <view class="load-head">
    <view class="load-title">配单 / 上货</view>
    <view class="load-status {{phase === 'dispatched' ? 'on' : ''}}">{{statusText}}</view>
  </view>

  <!-- 批次卡模板：批次卡面分明，批次内每单卡面分明，每单内每个商品一行一个 -->
  <template name="batchCard">
    <view class="card batch-card">
      <view class="batch-head">
        <view class="batch-no-wrap">
          <text class="batch-no">{{b.batch_no}}</text>
          <text class="tag {{b.tagClass || 'tag-blue'}}">{{b.total_orders}} 单</text>
          <text class="batch-status" wx:if="{{b.status_text}}">{{b.status_text}}</text>
        </view>
        <view class="batch-act" wx:if="{{b.action === 'dispatch'}}">
          <view class="btn btn-sm dispatch-btn" catchtap="dispatchBatch" data-id="{{b.id}}">派车配送</view>
        </view>
        <view class="batch-act" wx:elif="{{b.action === 'select'}}">
          <view class="btn btn-sm select-btn" catchtap="selectBatch" data-index="{{b.index}}">选择该批次上货</view>
        </view>
      </view>

      <view class="batch-line" wx:if="{{b.device_sn}}">
        <text class="line-label">机器人</text>
        <text class="line-value">{{b.device_sn}}</text>
      </view>
      <view class="batch-line" wx:if="{{b.route_text}}">
        <text class="line-label">路线</text>
        <text class="line-value">{{b.route_text}}</text>
      </view>
      <view class="batch-line" wx:if="{{b.picked_orders !== undefined}}">
        <text class="line-label">取餐进度</text>
        <text class="line-value">已取 {{b.picked_orders}} / {{b.total_orders}} 单</text>
      </view>

      <!-- 批次内订单：每单一个子卡 -->
      <view class="batch-orders">
        <view class="b-order" wx:for="{{b.orders}}" wx:for-item="o" wx:key="id">
          <view class="b-order-head">
            <text class="b-order-no">{{o.order_no}}</text>
            <text class="b-order-landmark">{{o.landmark_name}}</text>
            <text class="b-order-status {{o.picked_up ? 'done' : ''}}">{{o.picked_up ? '已取' : (o.status_text || '')}}</text>
          </view>
          <view class="b-meta-line"><text class="b-meta-label">取餐码</text><text class="pickup-code">{{o.pickup_code}}</text></view>
          <view class="b-meta-line"><text class="b-meta-label">收餐人</text><text class="b-meta-value">{{o.contact_name}} {{o.contact_phone}}</text></view>
          <view class="b-meta-line" wx:if="{{o.created_at}}"><text class="b-meta-label">下单时间</text><text class="b-meta-value">{{o.created_at}}</text></view>

          <!-- 单内商品：每行一个 -->
          <view class="b-items">
            <view class="b-item" wx:for="{{o.items}}" wx:for-item="it" wx:key="id">
              <image wx:if="{{it.goods_image}}" class="b-item-img" src="{{it.goods_image}}" mode="aspectFill" />
              <view wx:else class="b-item-img placeholder">
                <t-icon name="app" size="24rpx" color="#BFBFBF" />
              </view>
              <view class="b-item-name">{{it.goods_name}}</view>
              <text class="b-item-qty">x{{it.quantity}}</text>
              <text class="b-item-price">¥{{it.price}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </template>

  <!-- ========== 批次列表（主入口） ========== -->
  <block wx:if="{{phase === 'idle'}}">
    <view class="card" wx:if="{{loadingList}}">
      <view class="empty"><view class="empty-text">加载中…</view></view>
    </view>

    <!-- 组单中批次：可派车 -->
    <block wx:if="{{openBatches.length}}">
      <view class="section-title">组单中批次（可派车）<text class="section-sub">一车最多 12 单</text></view>
      <template is="batchCard" wx:for="{{openBatches}}" wx:key="id" wx:for-item="b" data="{{b: b}}" />
      <view class="pending-error text-weak text-sm" wx:if="{{pendingError}}">{{pendingError}}</view>
    </block>

    <!-- 待上货批次：已派车，可上货 -->
    <block wx:if="{{readyBatches.length}}">
      <view class="section-title">待上货批次（机器人前往上货点）</view>
      <template is="batchCard" wx:for="{{readyBatches}}" wx:key="id" wx:for-item="b" data="{{b: b}}" />
    </block>

    <!-- 模拟扫码（测试阶段） -->
    <view class="card scan-card" wx:if="{{readyBatches.length}}">
      <view class="scan-row" bindtap="simulateScanRobot">
        <t-icon name="scan" size="40rpx" color="#3078C0" />
        <text class="scan-row-text">模拟扫码识别机器人</text>
        <text class="scan-row-arrow text-weak">›</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!openBatches.length && !readyBatches.length && !loadingList}}">
      <view class="empty-text">暂无批次。新订单接单后将自动进入「组单中」批次，或在订单页接单后直达本页。</view>
    </view>

    <!-- 配送中批次（完整展示） -->
    <block wx:if="{{activeBatches.length}}">
      <view class="section-title">配送中批次</view>
      <template is="batchCard" wx:for="{{activeBatches}}" wx:key="id" wx:for-item="b" data="{{b: b}}" />
    </block>
  </block>

  <!-- ========== 已选批次（扫码后） ========== -->
  <block wx:if="{{batch}}">
    <template is="batchCard" data="{{b: batch}}" />

    <!-- 操作 -->
    <view class="foot-actions" wx:if="{{batch}}">
      <view class="btn btn-block" wx:if="{{phase === 'scanned'}}" bindtap="openBin">打开舱门（整批 {{batch.total_orders}} 单）</view>
      <view class="btn btn-block" wx:if="{{phase === 'open'}}" bindtap="closeBin">关闭舱门</view>

      <view class="dispatch-zone" wx:if="{{phase === 'loaded'}}">
        <view class="dispatch-hint {{countdown > 0 ? '' : 'warn'}}">{{countdownText || '请尽快开始配送'}}</view>
        <movable-area class="slider-area" style="width:{{sliderAreaW}}px;height:100rpx">
          <movable-view class="slider-thumb" style="width:{{sliderThumbW}}px;height:100rpx"
            direction="horizontal" x="{{sliderX}}" bindchange="onSliderChange" bindtouchend="onSliderEnd">
            <text class="slider-arrow">→</text>
          </movable-view>
        </movable-area>
        <view class="dispatch-label text-weak text-sm">向右滑动立即配送</view>
      </view>

      <view class="success-box" wx:if="{{phase === 'dispatched'}}">
        <view class="success-icon"><t-icon name="check-circle-filled" size="96rpx" color="#2BA471" /></view>
        <view class="success-text">机器人已出发，将按路线依次配送</view>
      </view>

      <view class="btn btn-outline btn-block" wx:if="{{phase !== 'idle'}}" bindtap="reset">返回批次列表</view>
    </view>
  </block>
</view>
