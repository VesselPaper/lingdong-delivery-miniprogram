<view class="order-card card" bindtap="onTap">
  <view class="order-top">
    <text class="order-title">订单 {{order.code_short || order.daily_seq}}</text>
    <view class="order-top-right">
      <view class="tag tag-green" wx:if="{{order.payed}}">已收款</view>
      <status-text cls="{{order.stClass}}" text="{{order.displayStatus || order.status_text}}" />
    </view>
  </view>

  <!-- 商品明细：图 + 名称 + 价格 + 数量（一行一个，与上货配单页一致） -->
  <view class="order-goods">
    <goods-row
      wx:for="{{order.items}}" wx:for-item="it" wx:key="id"
      image="{{it.goods_image}}" name="{{it.goods_name}}" price="{{it.price}}" qty="{{it.quantity}}" />
  </view>

  <view class="order-mid">
    <view class="order-line">
      <text class="line-label">送达</text>
      <text class="line-value">{{order.landmark_name}}</text>
    </view>
    <view class="order-line">
      <text class="line-label">批次</text>
      <text class="line-value">{{order.batch ? '批次 ' + (order.batch.code_short || order.batch.daily_seq) : '未组单'}}</text>
    </view>
    <view class="order-line">
      <text class="line-label">下单时间</text>
      <text class="line-value">{{order.created_time}}</text>
    </view>
  </view>

  <view class="order-total">
    <text class="text-sub text-sm">合计</text>
    <text class="total-price">¥{{order.total_amount}}</text>
  </view>

  <slot />
</view>
