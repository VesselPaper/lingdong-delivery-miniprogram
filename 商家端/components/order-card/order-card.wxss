.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.order-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 商品明细区（每行由 goods-row 组件渲染：图 + 名称 + 价格 + 数量） */
.order-goods {
  padding: 8rpx 0;
}

.order-mid {
  padding: 8rpx 0 12rpx;
}

.order-line {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.line-label {
  font-size: 26rpx;
  color: var(--text-sub);
  width: 120rpx;
}

.line-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-main);
}

/* 合计行 */
.order-total {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.total-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}
