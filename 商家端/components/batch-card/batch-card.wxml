<view class="card batch-card" bindtap="onCardTap" hover-class="batch-card-hover" hover-stay-time="80">
  <view class="batch-head">
    <view class="batch-title-wrap">
      <text class="batch-title">批次 {{b.code_short || b.daily_seq}}</text>
      <text class="batch-no-full" wx:if="{{showNo && b.batch_no}}">{{b.batch_no}}</text>
    </view>
    <view class="batch-tags">
      <text class="tag tag-locked" wx:if="{{b.dispatchMark}}">已锁定·待配送</text>
      <!-- 组单中：动态旋转圆环，表示订单正在合并成批次 -->
      <view class="spinner-tag" wx:elif="{{b.status === 0}}">
        <view class="spinner"></view>
        <text class="spinner-text">组单中</text>
      </view>
      <text class="tag {{b.statusTagClass || 'tag-gray'}}" wx:elif="{{b.status_text}}">{{b.status_text}}</text>
      <text class="tag tag-dark">{{b.total_orders}} 单</text>
    </view>
  </view>

  <view class="batch-line" wx:if="{{b.device_sn}}">
    <text class="line-label">机器人</text>
    <text class="line-value">{{b.device_sn}}</text>
  </view>
  <view class="batch-line" wx:if="{{b.total_items}}">
    <text class="line-label">件数</text>
    <text class="line-value">{{b.total_items}} 件</text>
  </view>
  <view class="batch-line" wx:if="{{b.route_text}}">
    <text class="line-label">路线</text>
    <text class="line-value">{{b.route_text}}</text>
  </view>
  <view class="batch-line" wx:if="{{showProgress}}">
    <text class="line-label">进度</text>
    <text class="line-value">已取 {{b.picked_orders}} / {{b.total_orders}} 单</text>
  </view>

  <!-- 批次内订单：每单一个子卡 -->
  <view class="batch-orders">
    <view class="b-order {{orderTap ? 'tappable' : ''}}" wx:for="{{b.orders}}" wx:for-item="o" wx:key="id" data-o="{{o}}" catchtap="onOrderTap">
      <view class="b-order-head">
        <text class="b-order-title">订单 {{o.code_short || o.daily_seq}}</text>
        <text class="b-order-landmark">{{o.landmark_name}}</text>
        <text class="recall-tag" wx:if="{{o.task && o.task.recall_status === 2}}">召回失败·需人工</text>
        <text class="b-order-status st-{{o.stClass}}">{{o.displayStatus || o.status_text}}</text>
      </view>

      <view class="b-items" wx:if="{{showGoods}}">
        <goods-row
          wx:for="{{o.items}}" wx:for-item="it" wx:key="id"
          image="{{it.goods_image}}" name="{{it.goods_name}}" price="{{it.price}}" qty="{{it.quantity}}" />
      </view>

      <view class="b-order-foot" wx:if="{{showGoods}}">
        <text class="b-meta-weak">取餐码 {{o.pickup_code}}</text>
        <text class="b-meta-weak">{{o.contact_name}}{{o.contact_phone ? ' ' + o.contact_phone : ''}}</text>
      </view>
    </view>
  </view>

  <view class="batch-cta" wx:if="{{action === 'select'}}">
    <view wx:if="{{b.robotBusy}}" class="btn btn-block btn-busy" hover-class="btn-hover">
      <text wx:if="{{b.dispatchMark}}">已装货 · 待配送（车忙）</text>
      <text wx:else>{{b.robotBusyLabel || '无人车正在配送中'}}</text>
    </view>
    <view wx:else class="btn btn-block" hover-class="btn-hover" catchtap="onSelect">{{selectText}}</view>
  </view>
  <view class="batch-cta" wx:elif="{{action === 'dispatch'}}">
    <view class="btn btn-outline-brand btn-block" hover-class="btn-hover" catchtap="onDispatch">{{b.total_orders ? '派车配送（' + b.total_orders + ' 单）' : '派车配送'}}</view>
  </view>
</view>
