/* 批次卡面：蓝色边框，便于与普通卡片分隔 */
.card.batch-card {
  border: 2rpx solid #A8C8EA;
}

/* 批次头部：蓝色整行（白字），用于区分不同批次 */
.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  margin: -32rpx -32rpx 16rpx;
  background: #3078C0;
  border-radius: 12rpx 12rpx 0 0;
}

.batch-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}

.batch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 完整批次编号：只在单批次详情显示，弱化展示 */
.batch-no-full {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
}

.batch-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* 蓝底上的标签统一为白底透明样式，字体白色 */
.batch-head .tag {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.batch-head .tag-dark {
  background: #ffffff;
  color: #3078C0;
}

/* 「已锁定·待配送」标记（问题3）：货已装好待配送，醒目标注 */
.batch-head .tag-locked {
  background: #FF8A00;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  font-weight: 600;
}

/* 组单中：动态旋转圆环（表示订单正在合并成批次） */
.spinner-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.spinner {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: batch-spin 0.9s linear infinite;
}

.spinner-text {
  font-size: 22rpx;
  color: #ffffff;
}

@keyframes batch-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 机器人忙碌：上货按钮禁用/忙提示（问题3/4） */
.btn-busy {
  background: #EEF0F3 !important;
  color: #AAB0BC !important;
  box-shadow: none !important;
}

.batch-line {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
}

.batch-line .line-label {
  font-size: 24rpx;
  color: var(--text-sub);
  width: 110rpx;
  flex-shrink: 0;
}

.batch-line .line-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-main);
  word-break: break-all;
}

/* 批次内订单（每单一个子卡） */
.batch-orders {
  margin-top: 16rpx;
}

.b-order {
  background: #F8F9FB;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.b-order:last-child {
  margin-bottom: 0;
}

.b-order.tappable {
  cursor: pointer;
}

.b-order.tappable:active {
  opacity: 0.85;
}

.b-order-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #ECEDF0;
}

.b-order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.b-order-landmark {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.b-order-status {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 500;
}

/* 平台召回失败标记（P0-4）：取消/退款后机器人未召回，需人工介入 */
.recall-tag {
  font-size: 20rpx;
  color: #ffffff;
  background: #E64340;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}

.b-items {
  padding-top: 6rpx;
}

.b-order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.b-meta-weak {
  font-size: 22rpx;
  color: var(--text-weak);
}

.batch-cta {
  margin-top: 20rpx;
}

/* 整卡可点（上货配单页点卡面看批次详情）的按压反馈 */
.batch-card-hover {
  background: #F7F9FC;
}
